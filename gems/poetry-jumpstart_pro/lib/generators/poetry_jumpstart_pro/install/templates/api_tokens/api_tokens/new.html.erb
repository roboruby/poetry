<%# Poetry recreation of Jumpstart's api_tokens/new. %>
<% content_for :title, t(".title") %>

<header class="flex flex-col gap-4">
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item(t("api_tokens.index.title"), href: api_tokens_path) %>
    <% crumb.with_item(t(".title")) %>
  <% end %>
  <h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
  <%= poetry_separator %>
</header>

<div class="mt-6">
  <%= render "api_tokens/form", api_token: @api_token %>
</div>
