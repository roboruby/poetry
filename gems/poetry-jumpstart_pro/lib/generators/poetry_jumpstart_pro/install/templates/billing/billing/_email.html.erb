<%# Poetry recreation of Jumpstart's billing/_email: the billing email form
    (PATCH /billing, account[billing_email]) as a section card. %>
<%= poetry_card(title_tag: :h2) do |card| %>
  <% card.with_title { t(".billing_email") } %>
  <% card.with_description { t(".description") } %>

  <%= form_with model: current_account, url: billing_path, builder: Poetry::Ui::FormBuilder do |f| %>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
      <div class="w-full sm:max-w-80">
        <%= f.field :billing_email, type: "email", label: t(".email_address", default: "Email address"), autocomplete: "email" %>
      </div>
      <%= f.submit t(".save"), variant: :outline, data: { turbo_submits_with: t(".saving") } %>
    </div>
  <% end %>
<% end %>
