<%# Poetry recreation of Jumpstart's billing/subscriptions/payment_methods/new:
    the payment-details page (Stripe, Paddle and Lemon Squeezy customers are
    redirected by the controller before this renders). Same processor
    partials and conditions as the engine. %>
<% content_for :title, t(".title") %>

<div class="flex flex-col gap-6">
  <header class="flex flex-col gap-3">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item(t(".billing"), href: billing_path) %>
      <% crumb.with_item(t(".title")) %>
    <% end %>
    <h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
  </header>

  <% if @subscription.past_due? || @subscription.unpaid? %>
    <%= poetry_alert(variant: :destructive) do |alert| %>
      <% alert.with_icon(name: :"triangle-alert") %>
      <% alert.with_title { t(".past_due") } %>
    <% end %>
  <% end %>

  <%= render "billing/subscriptions/payment_methods/forms/fake_processor", subscription: @subscription if @payment_processor.fake_processor? %>
  <%= render "billing/subscriptions/payment_methods/forms/braintree", subscription: @subscription if Jumpstart.config.braintree? && @payment_processor.braintree? %>
  <%= render "billing/subscriptions/payment_methods/forms/paypal", subscription: @subscription if Jumpstart.config.paypal? && @payment_processor.braintree? %>
</div>
