<%# Poetry recreation of Jumpstart's pricing/show: the plan grid with the
    monthly/yearly switch. The pricing Stimulus controller, its targets,
    actions, class values and the data-turbo-prefetch guard are the switcher
    contract - kept. The plan cards come from billing/subscriptions/_plan;
    each card's action is evaluated inside that layout partial so the lazy
    plan.* keys (contact_us, start_trial, get_started) resolve as before.
    Without plans the page says so, with a link to add one for staff. %>
<% content_for :title, t(".heading") %>

<div class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-6">
  <header class="flex flex-col items-center gap-2 text-center">
    <h1 class="text-3xl font-semibold tracking-tight"><%= t(".heading") %></h1>
    <p class="text-lg text-muted-foreground"><%= t(".subhead") %></p>
  </header>

  <% if @monthly_plans.any? || @yearly_plans.any? %>
    <div data-controller="pricing"
         data-pricing-active-frequency-class="bg-background text-foreground shadow-xs"
         data-pricing-inactive-frequency-class="text-muted-foreground"
         data-pricing-inactive-plans-class="hidden"
         data-pricing-hidden-toggle-class="hidden"
         class="mt-10 flex flex-col items-center gap-8">
      <div data-pricing-target="toggle" role="group" aria-label="<%= t(".billing_interval", default: "Billing interval") %>" class="hidden flex items-center gap-1 rounded-full border bg-muted p-1">
        <%= poetry_button(variant: :ghost, size: :sm, class: "rounded-full", data: { action: "pricing#switch", pricing_target: "frequency", frequency: "monthly" }) { t(".monthly") } %>
        <%= poetry_button(variant: :ghost, size: :sm, class: "rounded-full", data: { action: "pricing#switch", pricing_target: "frequency", frequency: "yearly" }) { t(".yearly") } %>
      </div>

      <div data-turbo-prefetch="false" class="w-full">
        <div data-pricing-target="plans" data-frequency="monthly" class="<%= class_names("grid gap-6 sm:grid-cols-2 lg:grid-cols-none lg:grid-flow-col lg:auto-cols-fr", "mx-auto max-w-sm sm:grid-cols-1": @monthly_plans.one?) %>">
          <% @monthly_plans.each do |plan| %>
            <%= render layout: "billing/subscriptions/plan", locals: { plan: plan } do %>
              <% if plan.contact_url.present? %>
                <%= poetry_button(variant: :outline, href: plan.contact_url, class: "w-full") { t(".contact_us") } %>
              <% else %>
                <%= poetry_button(href: checkout_path(plan: plan), class: "w-full") { pricing_cta(plan) } %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div data-pricing-target="plans" data-frequency="yearly" class="<%= class_names("hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-none lg:grid-flow-col lg:auto-cols-fr", "mx-auto max-w-sm sm:grid-cols-1": @yearly_plans.one?) %>">
          <% @yearly_plans.each do |plan| %>
            <%= render layout: "billing/subscriptions/plan", locals: { plan: plan } do %>
              <% if plan.contact_url.present? %>
                <%= poetry_button(variant: :outline, href: plan.contact_url, class: "w-full") { t(".contact_us") } %>
              <% else %>
                <%= poetry_button(href: checkout_path(plan: plan), class: "w-full") { pricing_cta(plan) } %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%= poetry_empty(media_variant: :icon, title_tag: :h2, class: "mt-10 rounded-lg border border-dashed py-12") do |empty| %>
      <% empty.with_media { poetry_icon(name: :"credit-card") } %>
      <% empty.with_title { t(".no_plans") } %>
      <%= poetry_button(variant: :outline, href: madmin_plans_path) { t(".add_plan") } if current_user&.staff? %>
    <% end %>
  <% end %>
</div>
