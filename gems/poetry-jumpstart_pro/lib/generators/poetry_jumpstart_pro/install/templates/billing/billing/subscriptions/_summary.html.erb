<%# Poetry recreation of Jumpstart's billing/subscriptions/_summary: the plan
    name, its price per interval, and a seat badge for per-unit or multi-seat
    plans. heading_tag is an optional local (default :h3) so each page keeps a
    sane outline. %>
<% heading_tag = local_assigns.fetch(:heading_tag, :h3) %>
<% plan = subscription.plan %>
<div class="flex flex-col items-start gap-1.5">
  <%= tag.public_send(heading_tag, plan&.name.presence || subscription.name, class: "text-lg font-semibold tracking-tight") %>
  <% if plan %>
    <p class="flex items-baseline gap-1">
      <span class="text-base font-medium tabular-nums"><%= pay_amount_to_currency(subscription) %></span>
      <span class="text-sm text-muted-foreground">/ <%= formatted_plan_interval(plan) %></span>
    </p>
    <% if plan.charge_per_unit? || subscription.quantity > 1 %>
      <% seat = plan.unit_label? ? t(".per_unit", unit: plan.unit_label) : t(".each") %>
      <%= poetry_badge(variant: :outline, class: "tabular-nums") do %>
        <%= t(".quantity", quantity: subscription.quantity, price: pay_amount_to_currency(plan), unit: seat) %>
      <% end %>
    <% end %>
  <% end %>
</div>
