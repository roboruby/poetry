<%# Poetry recreation of Jumpstart's users/passwords/new: request a password
    reset link. Posts user[email] to passwords_path, as the original does. %>
<% content_for :title, t("users.passwords.new.title") %>

<div class="mx-auto w-full max-w-md px-4 py-10 lg:px-6">
  <header class="mb-8 space-y-2 text-center">
    <h1 class="text-2xl font-semibold tracking-tight"><%= t("users.passwords.new.forgot_your_password") %></h1>
  </header>

  <%= form_with url: passwords_path, scope: :user do %>
    <%= poetry_field_group do %>
      <%= poetry_field(id: "user_email", label_text: User.human_attribute_name(:email)) do |field| %>
        <%= poetry_input(type: "email", name: "user[email]", autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                         **field.control_attributes.transform_keys(&:to_sym)) %>
      <% end %>
    <% end %>

    <div class="mt-6">
      <%= poetry_button(type: :submit, class: "w-full") { t("users.passwords.new.send_me_reset_password_instructions") } %>
    </div>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= poetry_link(href: login_path, class: "text-muted-foreground") { t("back") } %>
  </p>
</div>
