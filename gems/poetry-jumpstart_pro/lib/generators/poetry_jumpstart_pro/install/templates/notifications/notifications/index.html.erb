<%# Poetry recreation of Jumpstart's notifications/index. %>
<% content_for :title, t(".title") %>

<div class="mx-auto w-full max-w-2xl px-4 py-8 lg:px-6">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
    <% if @notifications.any? %>
      <%= form_with(url: mark_as_read_notifications_path, method: :patch) do %>
        <%= poetry_button(type: :submit, variant: :outline, size: :sm) { t(".mark_all_as_read") } %>
      <% end %>
    <% end %>
  </header>

  <% if @notifications.any? %>
    <div class="mt-6 divide-y divide-border overflow-hidden rounded-lg border">
      <%= render partial: "notifications/notification", collection: @notifications, cached: true %>
    </div>

    <% if @page.multiple_pages? %>
      <div class="mt-8 flex justify-center">
        <%= poetry_pagination_nav(@page) %>
      </div>
    <% end %>
  <% else %>
    <%= poetry_empty(media_variant: :icon, title_tag: :h2, class: "mt-6 rounded-lg border border-dashed py-12") do |empty| %>
      <% empty.with_media { poetry_icon(name: :bell) } %>
      <% empty.with_title { t(".empty_placeholder") } %>
      <% empty.with_description { t("notifications.empty_description") } %>
    <% end %>
  <% end %>
</div>
