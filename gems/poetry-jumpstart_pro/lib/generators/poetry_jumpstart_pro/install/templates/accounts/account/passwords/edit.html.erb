<%# Poetry recreation of Jumpstart's account/passwords/edit: the password
    change form on the Poetry builder (password fields never round-trip),
    then two-factor authentication - enabling navigates to the backup codes,
    disabling confirms in an AlertDialog that submits the DELETE form. %>
<% content_for :title, t(".title") %>

<header class="flex flex-col gap-4">
  <h1 class="text-2xl font-semibold tracking-tight"><%= t(".title") %></h1>
  <%= poetry_separator %>
</header>

<%= form_with(model: current_user, url: account_password_path, method: :put, builder: Poetry::Ui::FormBuilder, class: "mt-6 max-w-md space-y-6") do |form| %>
  <%= render "application/error_messages", resource: current_user %>

  <%= form.group do %>
    <%= form.password_field :password_challenge, autocomplete: "current-password", hint: t("users.registrations.edit.we_need_your_current_password_to_confirm_your_changes") %>
    <%= form.password_field :password, autocomplete: "new-password", hint: t("users.shared.minimum_password_length", count: User::MINIMUM_PASSWORD_LENGTH) %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
  <% end %>

  <div>
    <%= form.submit t(".update") %>
  </div>
<% end %>

<%= poetry_separator(class: "my-10") %>

<section class="space-y-4" aria-labelledby="two-factor-title">
  <div class="space-y-1">
    <h2 id="two-factor-title" class="text-lg font-semibold"><%= t(".two_factor.title") %></h2>
    <p class="text-sm text-muted-foreground"><%= t(".two_factor.description") %></p>
  </div>

  <% if current_user.otp_required_for_login? %>
    <%= form_with(url: user_two_factor_path, method: :delete, id: "disable-two-factor-form", class: "hidden") {} %>
    <%= poetry_alert_dialog do |dialog| %>
      <% dialog.with_trigger(variant: :outline, class: "text-destructive") { t(".two_factor.disable") } %>
      <% dialog.with_title { t(".two_factor.disable") } %>
      <% dialog.with_description { t("are_you_sure") } %>
      <% dialog.with_cancel { t("cancel") } %>
      <% dialog.with_action(variant: :destructive, submit: "disable-two-factor-form") { t(".two_factor.disable") } %>
    <% end %>
  <% else %>
    <%= poetry_button(href: backup_codes_user_two_factor_path, variant: :outline) { t(".two_factor.enable") } %>
  <% end %>
</section>
