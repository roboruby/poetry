{
  "name": "@poetry/agent",
  "version": "0.1.4",
  "private": true,
  "description": "poetry-agent's WebMCP runtime: the registrar and declarative-form Stimulus controllers plus the document.modelContext adapter. Importmap-first (the engine pins this tree); the same tree is the npm channel for bundler hosts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./app/javascript/poetry/agent/index.js",
    "./*": "./app/javascript/poetry/agent/*.js"
  },
  "files": [
    "app/javascript"
  ],
  "peerDependencies": {
    "@hotwired/stimulus": ">= 3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hotwired/stimulus": "^3.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.0.0",
    "espree": "^10.4.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "eslint app/javascript && vitest run",
    "manifest": "MANIFEST_WRITE=1 vitest run test/javascript/controllers_manifest.test.js",
    "lint": "eslint app/javascript",
    "jsdoc:floor": "JSDOC_FLOOR_WRITE=1 vitest run test/javascript/jsdoc_floor.test.js"
  }
}
