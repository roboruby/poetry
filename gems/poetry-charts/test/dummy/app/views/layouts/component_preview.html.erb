<!DOCTYPE html>
<html lang="en">
  <head>
    <title>poetry-charts component preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Static assets generated by `rake browser:assets`: the real Tailwind
        build (the css:verify_compiled recipe) + the charts controllers
        served over an importmap - Stimulus actually runs in these pages
        (the W5 upgrade from the W1 inline readiness stamp). %>
    <link rel="stylesheet" href="/assets/poetry.css">
    <style>
      /* Deterministic screenshots (rake test:visual): no motion in the
         preview host - transitions and carets freeze. */
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
        caret-color: transparent !important;
      }
    </style>
    <% if (importmap = Rails.public_path.join("assets/importmap.json")).exist? %>
      <script type="importmap"><%= raw importmap.read %></script>
      <script type="module">
        import { Application } from "@hotwired/stimulus"
        import { registerPoetryChartsControllers } from "@poetry/charts"

        const application = new Application()
        registerPoetryChartsControllers(application)
        await application.start()
        // The browser tasks wait for this flag before running axe / screenshotting.
        document.documentElement.dataset.poetryReady = "true"
      </script>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
