<!DOCTYPE html>
<html lang="en" data-poetry-ready="true">
  <head>
    <title>poetry-charts component preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# The compiled Tailwind build generated by `rake browser:assets` (the
        css:verify_compiled recipe). W1 chrome is fully static, so readiness
        is stamped inline - the importmap/Stimulus block ports over when the
        tooltip controller lands (N10 W5). %>
    <link rel="stylesheet" href="/assets/poetry.css">
    <style>
      /* Deterministic screenshots (rake test:visual): no motion in the
         preview host - transitions and carets freeze. */
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
        caret-color: transparent !important;
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
