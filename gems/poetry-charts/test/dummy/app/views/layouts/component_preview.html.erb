<!DOCTYPE html>
<html lang="en">
  <head>
    <title>poetry-charts component preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# No snapshot cache: Turbo preview renders would connect controllers
        twice and consume the morph registry on the throwaway preview. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%# Static assets generated by `rake browser:assets`: the real Tailwind
        build (the css:verify_compiled recipe) + the charts controllers
        served over an importmap - Stimulus actually runs in these pages
        (an upgrade from the earlier inline readiness stamp). %>
    <link rel="stylesheet" href="/assets/poetry.css">
    <style>
      /* Deterministic screenshots (rake test:visual): the visual/axe
         sessions emulate prefers-reduced-motion: reduce over CDP, and THAT
         is the one switch that freezes the host - the gem's own motion
         stylesheet honors it, and this belt-and-suspenders rule catches
         transitions too. Real motion runs when a human (or the interaction
         task) opens a preview. */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
        }
      }
      *, *::before, *::after {
        caret-color: transparent !important;
      }
    </style>
    <% if (importmap = Rails.public_path.join("assets/importmap.json")).exist? %>
      <script type="importmap"><%= raw importmap.read %></script>
      <script type="module">
        // Turbo makes the /interactive form submit a same-context body swap
        // (the cross-render morph rides it); it is inert on the static previews.
        import "@hotwired/turbo"
        import { Application } from "@hotwired/stimulus"
        import { registerPoetryChartsControllers } from "@poetry/charts"

        const application = new Application()
        registerPoetryChartsControllers(application)
        await application.start()
        // The browser tasks wait for this flag before running axe / screenshotting.
        document.documentElement.dataset.poetryReady = "true"
      </script>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
