<%= render Poetry::Charts::Container::Component.new(config: chart_config, id: chart_id.delete_prefix("chart-")) do %>
  <%= content_tag(:div, frame_attributes.merge("class" => css(:frame))) do %>
  <svg viewBox="0 0 <%= width %> <%= height %>" class="<%= css(:svg) %>" data-slot="chart-svg" aria-label="<%= svg_label %>" preserveAspectRatio="xMidYMid meet" <%= tag.attributes(svg_interaction_attributes) %>>
    <% if polar_grid? %>
      <g data-slot="chart-polar-grid" aria-hidden="true">
        <% if polar_grid_config[:radial_lines] %>
          <% angle_tick_values.each do |tick| %>
            <% x1, y1, x2, y2 = spoke_points(tick) %>
            <line class="<%= css(:grid_circle) %>" x1="<%= fnum(x1) %>" y1="<%= fnum(y1) %>" x2="<%= fnum(x2) %>" y2="<%= fnum(y2) %>"/>
          <% end %>
        <% end %>
        <% grid_radii.each_with_index do |radius, i| %>
          <circle class="<%= grid_fill_class(i) %>" cx="<%= fnum(cx) %>" cy="<%= fnum(cy) %>" r="<%= fnum(radius) %>"/>
        <% end %>
      </g>
    <% end %>
    <% series_entries.each_with_index do |entry, series_index| %>
      <g data-slot="chart-radial-series" data-key="<%= entry.data_key %>">
        <% segments(entry).each do |segment| %>
          <% if entry.background %>
            <path data-slot="chart-radial-background" class="<%= css(:background_ring) %>" d="<%= background_path(segment) %>"/>
          <% end %>
        <% end %>
        <% segments(entry).each do |segment| %>
          <path data-slot="chart-radial-bar" data-key="<%= entry.data_key %>"<% if series_index.zero? %> data-index="<%= segment.index %>"<% end %><% if animate? %> data-motion-sector="<%= motion_sector_value(cx, cy, segment.ring_inner, segment.ring_outer, segment.seg_start, segment.seg_end) %>" data-motion-group="ring-<%= segment.index %>"<% end %> d="<%= segment.path %>" fill="<%= segment.fill %>"/>
        <% end %>
        <% if entry.labels == :inside_start %>
          <g data-slot="chart-labels" data-key="<%= entry.data_key %>" aria-hidden="true">
            <% segments(entry).each do |segment| %>
              <% placement = label_placement(segment) %>
              <text class="<%= css(:inside_label) %>" x="<%= fnum(placement[:x]) %>" y="<%= fnum(placement[:y]) %>" dy="0.355em" text-anchor="<%= placement[:anchor] %>" transform="rotate(<%= fnum(placement[:rotate]) %>, <%= fnum(placement[:x]) %>, <%= fnum(placement[:y]) %>)"><%= entry.label_key ? rows[segment.index][entry.label_key] : segment.value %></text>
            <% end %>
          </g>
        <% end %>
      </g>
    <% end %>
    <% if center_label? %>
      <%# Full gauge (shape/text): text-4xl centered on cy, dy=0.355em
          (recharts dominantBaseline=middle), caption 24 below. Compact
          (stacked half-gauge): text-2xl baseline at cy-16, caption at
          cy+4 - upstream's smaller number above the flat baseline. %>
      <% compact = center_label_config[:compact] %>
      <text data-slot="chart-center-label" x="<%= fnum(cx) %>" y="<%= fnum(cy) %>" text-anchor="middle">
        <% if compact %>
          <tspan class="<%= css(:center_title_compact) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy - 16) %>"><%= center_label_config[:title] %></tspan>
          <% if center_label_config[:subtitle] %>
            <tspan class="<%= css(:center_subtitle) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy + 4) %>"><%= center_label_config[:subtitle] %></tspan>
          <% end %>
        <% else %>
          <tspan class="<%= css(:center_title) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy) %>" dy="0.355em"><%= center_label_config[:title] %></tspan>
          <% if center_label_config[:subtitle] %>
            <tspan class="<%= css(:center_subtitle) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy + 24) %>" dy="0.355em"><%= center_label_config[:subtitle] %></tspan>
          <% end %>
        <% end %>
      </text>
    <% end %>
  </svg>
  <% if legend? %>
    <%= render legend_component %>
  <% end %>
  <% if tooltip? %><%= render tooltip_layer_component %><% end %>
  <script type="application/json" data-slot="chart-coordinates" <%= tag.attributes(stimulus_attributes_for(:coordinates)) %>><%= script_json(coordinates_json) %></script>
  <% end %>
<% end %>
