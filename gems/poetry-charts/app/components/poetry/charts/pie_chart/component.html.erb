<%= render Poetry::Charts::Container::Component.new(config: chart_config, id: chart_id.delete_prefix("chart-")) do %>
  <%= content_tag(:div, frame_attributes.merge("class" => css(:frame))) do %>
  <svg viewBox="0 0 <%= width %> <%= height %>" class="<%= css(:svg) %>" data-slot="chart-svg" aria-label="<%= svg_label %>" preserveAspectRatio="xMidYMid meet" <%= tag.attributes(svg_interaction_attributes) %>>
    <% series_entries.each_with_index do |entry, pie_index| %>
      <g data-slot="chart-pie" data-key="<%= entry.data_key %>">
        <% slices(entry).each do |slice| %>
          <path data-slot="chart-pie-sector" data-key="<%= entry.data_key %>"<% if pie_index.zero? %> data-index="<%= slice.index %>"<% end %><% if entry.active_index == slice.index %> data-active=""<% end %><% if animate? %> data-motion-sector="<%= motion_sector_value(cx, cy, slice.inner, slice.outer, slice.start_angle, slice.end_angle) %>" data-motion-group="pie-<%= pie_index %>"<% end %> d="<%= slice.path %>" fill="<%= slice.fill %>"<% if entry.stroke_width.positive? %> stroke="var(--background)" stroke-width="<%= entry.stroke_width %>"<% end %>/>
        <% end %>
      </g>
      <% if entry.labels == :list %>
        <g data-slot="chart-labels" data-key="<%= entry.data_key %>" aria-hidden="true">
          <% slices(entry).each do |slice| %>
            <text class="<%= css(:inside_label) %>" x="<%= fnum(slice.label_point[0]) %>" y="<%= fnum(slice.label_point[1]) %>" text-anchor="middle" dy="0.355em"><%= slice_label(entry, slice) %></text>
          <% end %>
        </g>
      <% end %>
    <% end %>
    <% if center_label? %>
      <%# dy=0.355em centers each line's midline on its y (recharts'
          dominantBaseline=middle); the subtitle sits 24 below the title,
          both absolute - the upstream donut-text tspan geometry. %>
      <text data-slot="chart-center-label" x="<%= fnum(cx) %>" y="<%= fnum(cy) %>" text-anchor="middle">
        <tspan class="<%= css(:center_title) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy) %>" dy="0.355em"><%= center_label_config[:title] %></tspan>
        <% if center_label_config[:subtitle] %>
          <tspan class="<%= css(:center_subtitle) %>" x="<%= fnum(cx) %>" y="<%= fnum(cy + 24) %>" dy="0.355em"><%= center_label_config[:subtitle] %></tspan>
        <% end %>
      </text>
    <% end %>
  </svg>
  <% if legend? %>
    <%= render legend_component %>
  <% end %>
  <% if tooltip? %><%= render tooltip_layer_component %><% end %>
  <script type="application/json" data-slot="chart-coordinates" <%= tag.attributes(stimulus_attributes_for(:coordinates)) %>><%= script_json(coordinates_json) %></script>
  <% end %>
<% end %>
