<%= render Poetry::Charts::Container::Component.new(config: chart_config, id: chart_id.delete_prefix("chart-")) do %>
  <%= content_tag(:div, class: css(:frame), data: frame_data) do %>
  <svg viewBox="0 0 <%= width %> <%= height %>" class="<%= css(:svg) %>" data-slot="chart-svg" aria-label="<%= svg_label %>" preserveAspectRatio="xMidYMid meet" <%= tag.attributes(svg_interaction_attributes) %>>
    <% if grid? %>
      <g data-slot="chart-grid" aria-hidden="true">
        <% if grid_config.horizontal %>
          <% y_ticks.each do |tick| %>
            <line class="<%= css(:grid_line) %>" x1="<%= fnum(plot_left) %>" x2="<%= fnum(plot_right) %>" y1="<%= fnum(y_scale.call(tick)) %>" y2="<%= fnum(y_scale.call(tick)) %>"/>
          <% end %>
        <% end %>
        <% if grid_config.vertical %>
          <% x_ticks.each do |tick| %>
            <line class="<%= css(:grid_line) %>" x1="<%= fnum(x_scale.call(tick)) %>" x2="<%= fnum(x_scale.call(tick)) %>" y1="<%= fnum(plot_top) %>" y2="<%= fnum(plot_bottom) %>"/>
          <% end %>
        <% end %>
      </g>
    <% end %>
    <g data-slot="chart-scatters">
      <% points.each do |point| %>
        <circle data-slot="chart-scatter-point" data-key="<%= point.key %>" data-index="<%= point.index %>" cx="<%= fnum(point.cx) %>" cy="<%= fnum(point.cy) %>" r="<%= fnum(point.r) %>" fill="var(--color-<%= point.key %>)"/>
      <% end %>
    </g>
    <% series_entries.select(&:error_key).each do |entry| %>
      <g data-slot="chart-error-bars" data-key="<%= entry.key %>" aria-hidden="true">
        <% points.select { |p| p.key == entry.key }.each do |point| %>
          <% range = error_range(point.row, entry.error_key, point.row[y_axis_config.data_key].to_f) %>
          <% if range %>
            <path class="<%= css(:error_bar) %>" d="<%= error_bar_path(point.cx, y_scale.call(range[0]), y_scale.call(range[1]), entry.error_width) %>" fill="none"/>
          <% end %>
        <% end %>
      </g>
    <% end %>
    <%= reference_marks_svg %>
    <% if x_axis? %>
      <g data-slot="chart-x-axis">
        <% x_ticks.each do |tick| %>
          <text class="<%= css(:tick) %>" x="<%= fnum(x_scale.call(tick)) %>" y="<%= fnum(plot_bottom + x_axis_config.tick_margin) %>" dy="0.71em" text-anchor="middle"><%= tick_label(tick) %></text>
        <% end %>
      </g>
    <% end %>
    <% if y_axis? %>
      <g data-slot="chart-y-axis">
        <% y_ticks.each do |tick| %>
          <text class="<%= css(:tick) %>" x="<%= fnum(plot_left - y_axis_config.tick_margin) %>" y="<%= fnum(y_scale.call(tick)) %>" dy="0.355em" text-anchor="end"><%= tick_label(tick) %></text>
        <% end %>
      </g>
    <% end %>
  </svg>
  <% if legend? %>
    <%= render Poetry::Charts::LegendContent::Component.new(config: chart_config) %>
  <% end %>
  <% if tooltip? %><%= render tooltip_layer_component %><% end %>
  <script type="application/json" data-slot="chart-coordinates"<% if tooltip? %> data-poetry--charts--tooltip-target="data"<% end %>><%= coordinates_json.html_safe %></script>
  <% end %>
<% end %>
