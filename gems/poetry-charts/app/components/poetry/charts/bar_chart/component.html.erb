<%= render Poetry::Charts::Container::Component.new(config: chart_config, id: chart_id.delete_prefix("chart-")) do %>
  <%= content_tag(:div, class: css(:frame), data: frame_data) do %>
  <svg viewBox="0 0 <%= width %> <%= height %>" class="<%= css(:svg) %>" data-slot="chart-svg" aria-label="<%= svg_label %>" preserveAspectRatio="xMidYMid meet" <%= tag.attributes(svg_interaction_attributes) %>>
    <% if grid? %>
      <g data-slot="chart-grid" aria-hidden="true">
        <% if horizontal? %>
          <%# Value ticks run along X in the horizontal layout. %>
          <% if grid_config.vertical %>
            <% cartesian.y_ticks.each do |tick| %>
              <line class="<%= css(:grid_line) %>" x1="<%= fnum(cartesian.y_scale.call(tick)) %>" x2="<%= fnum(cartesian.y_scale.call(tick)) %>" y1="<%= fnum(cartesian.plot_top) %>" y2="<%= fnum(cartesian.plot_bottom) %>"/>
            <% end %>
          <% end %>
          <% if grid_config.horizontal %>
            <% cartesian.x_centers.each do |y| %>
              <line class="<%= css(:grid_line) %>" x1="<%= fnum(cartesian.plot_left) %>" x2="<%= fnum(cartesian.plot_right) %>" y1="<%= fnum(y) %>" y2="<%= fnum(y) %>"/>
            <% end %>
          <% end %>
        <% else %>
          <% if grid_config.horizontal %>
            <% cartesian.y_ticks.each do |tick| %>
              <line class="<%= css(:grid_line) %>" x1="<%= fnum(cartesian.plot_left) %>" x2="<%= fnum(cartesian.plot_right) %>" y1="<%= fnum(cartesian.y_scale.call(tick)) %>" y2="<%= fnum(cartesian.y_scale.call(tick)) %>"/>
            <% end %>
          <% end %>
          <% if grid_config.vertical %>
            <% cartesian.x_centers.each do |x| %>
              <line class="<%= css(:grid_line) %>" x1="<%= fnum(x) %>" x2="<%= fnum(x) %>" y1="<%= fnum(cartesian.plot_top) %>" y2="<%= fnum(cartesian.plot_bottom) %>"/>
            <% end %>
          <% end %>
        <% end %>
      </g>
    <% end %>
    <g data-slot="chart-bars">
      <% series_entries.each do |entry| %>
        <g data-slot="chart-bar-series" data-key="<%= entry.key %>">
          <% cells(entry).each do |cell| %>
            <path data-slot="chart-bar" data-key="<%= entry.key %>" data-index="<%= cell[:index] %>" d="<%= bar_path(entry, cell) %>" fill="<%= cell_fill(entry, cell) %>"<% if animate? %> data-motion-origin="<%= motion_origin(cell) %>"<% end %><% if active?(entry, cell) %> fill-opacity="0.8" stroke="<%= cell_fill(entry, cell) %>" stroke-width="<%= entry.stroke_width %>" stroke-dasharray="4" stroke-dashoffset="4" data-active=""<% end %>/>
          <% end %>
        </g>
        <% if entry.error_key && !horizontal? %>
          <g data-slot="chart-error-bars" data-key="<%= entry.key %>" aria-hidden="true">
            <% cells(entry).each do |cell| %>
              <% range = error_range(cell[:row], entry.error_key, cell[:value]) %>
              <% if range %>
                <path class="<%= css(:error_bar) %>" d="<%= error_bar_path(cell[:x] + (cell[:width] / 2.0), cartesian.y_scale.call(range[0]), cartesian.y_scale.call(range[1]), entry.error_width) %>" fill="none"/>
              <% end %>
            <% end %>
          </g>
        <% end %>
        <% if entry.labels %>
          <g data-slot="chart-labels" data-key="<%= entry.key %>">
            <% cells(entry).each do |cell| %>
              <text class="<%= css(:label) %>" x="<%= fnum(cell[:x] + (cell[:width] / 2.0)) %>" y="<%= fnum(cell[:y] - 12) %>" text-anchor="middle"><%= cell_label(entry, cell) %></text>
            <% end %>
          </g>
        <% end %>
      <% end %>
    </g>
    <%= reference_marks_svg %>
    <% if horizontal? %>
      <% if y_axis? %>
        <%# The category labels down the left strip (the horizontal/mixed blocks). %>
        <g data-slot="chart-y-axis">
          <% cartesian.categories.each_with_index do |category, i| %>
            <text class="<%= css(:tick) %>" x="<%= fnum(cartesian.plot_left - y_axis_config.tick_margin) %>" y="<%= fnum(cartesian.x_centers[i]) %>" dy="0.355em" text-anchor="end"><%= category_tick_label(category) %></text>
          <% end %>
        </g>
      <% end %>
    <% else %>
      <% if x_axis? %>
        <g data-slot="chart-x-axis">
          <% cartesian.categories.each_with_index do |category, i| %>
            <text class="<%= css(:tick) %>" x="<%= fnum(cartesian.x_centers[i]) %>" y="<%= fnum(cartesian.plot_bottom + x_axis_config.tick_margin) %>" dy="0.71em" text-anchor="middle"><%= x_tick_label(category) %></text>
          <% end %>
        </g>
      <% end %>
      <% if y_axis? %>
        <g data-slot="chart-y-axis">
          <% cartesian.y_ticks.each do |tick| %>
            <text class="<%= css(:tick) %>" x="<%= fnum(cartesian.plot_left - y_axis_config.tick_margin) %>" y="<%= fnum(cartesian.y_scale.call(tick)) %>" dy="0.355em" text-anchor="end"><%= y_tick_label(tick) %></text>
          <% end %>
        </g>
      <% end %>
    <% end %>
  </svg>
  <% if legend? %>
    <%= render Poetry::Charts::LegendContent::Component.new(config: chart_config) %>
  <% end %>
  <% if tooltip? %><%= render tooltip_layer_component %><% end %>
  <script type="application/json" data-slot="chart-coordinates"<% if tooltip? %> data-poetry--charts--tooltip-target="data"<% end %>><%= coordinates_json.html_safe %></script>
  <% if live? %><script type="application/json" data-slot="chart-live-payload" data-poetry--charts--live-target="payload"><%= live_payload_json.html_safe %></script>
<% end %>  <% end %>
<% end %>
