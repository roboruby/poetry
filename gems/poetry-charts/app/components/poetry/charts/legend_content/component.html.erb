<%= content_tag(:div, **root_attributes.to_attributes) do %>
  <% rows.each do |row| %>
    <%= content_tag(toggle ? :button : :div, **(toggle ? toggle_attributes(row) : { data: { slot: "chart-legend-item" }, class: css(:item) })) do %>
      <% unless hide_icon || row[:color].nil? %>
        <div data-slot="chart-legend-swatch" class="<%= css(:swatch) %>" style="<%= swatch_style(row[:color]) %>"></div>
      <% end %>
      <%= row[:name] %>
    <% end %>
  <% end %>
<% end %>
