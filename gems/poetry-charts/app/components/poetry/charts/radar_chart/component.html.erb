<%= render Poetry::Charts::Container::Component.new(config: chart_config, id: chart_id.delete_prefix("chart-")) do %>
  <%= content_tag(:div, frame_attributes.merge("class" => css(:frame))) do %>
  <svg viewBox="0 0 <%= width %> <%= height %>" class="<%= css(:svg) %>" data-slot="chart-svg" aria-label="<%= svg_label %>" preserveAspectRatio="xMidYMid meet" <%= tag.attributes(svg_interaction_attributes) %>>
    <% if grid? %>
      <g data-slot="chart-polar-grid" aria-hidden="true">
        <%# Linework FIRST (rings + spokes), so the tinted fills below can
            wash over it - the translucent ring fills stack on top of the
            grid strokes, leaving them near-invisible. %>
        <% grid_radii.each do |radius| %>
          <% if grid_config.type == :circle %>
            <circle class="<%= css(:grid_line) %>" cx="<%= fnum(cx) %>" cy="<%= fnum(cy) %>" r="<%= fnum(radius) %>" />
          <% else %>
            <path class="<%= css(:grid_line) %>" d="<%= grid_polygon(radius) %>" />
          <% end %>
        <% end %>
        <% if grid_config.radial_lines %>
          <% rows.each_index do |i| %>
            <% x, y = spoke_end(i) %>
            <line class="<%= css(:grid_line) %>" x1="<%= fnum(cx) %>" y1="<%= fnum(cy) %>" x2="<%= fnum(x) %>" y2="<%= fnum(y) %>" />
          <% end %>
        <% end %>
        <%# The tinted fills: EVERY ring fills at the low opacity,
            painted OVER the linework, overlaps compounding toward the
            center - one fill+opacity across the whole grid. Inline
            style, because grid_line sets fill-none and a fill
            ATTRIBUTE loses to that CSS. %>
        <% if grid_fill_attribute %>
          <% grid_radii.each do |radius| %>
            <% if grid_config.type == :circle %>
              <circle class="<%= css(:grid_fill) %>" cx="<%= fnum(cx) %>" cy="<%= fnum(cy) %>" r="<%= fnum(radius) %>" style="fill: <%= grid_fill_attribute %>" fill-opacity="<%= grid_config.opacity %>" />
            <% else %>
              <path class="<%= css(:grid_fill) %>" d="<%= grid_polygon(radius) %>" style="fill: <%= grid_fill_attribute %>" fill-opacity="<%= grid_config.opacity %>" />
            <% end %>
          <% end %>
        <% end %>
      </g>
    <% end %>
    <g data-slot="chart-radars">
      <% series_entries.each do |entry| %>
        <path data-slot="chart-radar" data-key="<%= entry.data_key %>" d="<%= series_path(entry) %>" fill="var(--color-<%= entry.data_key %>)" fill-opacity="<%= entry.fill_opacity %>"<% if entry.stroke_width.positive? %> stroke="var(--color-<%= entry.data_key %>)" stroke-width="<%= entry.stroke_width %>"<% end %> />
        <% if entry.dots %>
          <g data-slot="chart-dots" data-key="<%= entry.data_key %>">
            <% rows.each_index do |i| %>
              <% x, y = vertex(entry, i) %>
              <circle data-slot="chart-dot" cx="<%= fnum(x) %>" cy="<%= fnum(y) %>" r="<%= entry.dot_radius %>" fill="var(--color-<%= entry.data_key %>)" />
            <% end %>
          </g>
        <% end %>
      <% end %>
    </g>
    <% if angle_axis? %>
      <g data-slot="chart-angle-axis">
        <% rows.each_index do |i| %>
          <% placement = angle_label(i) %>
          <text class="<%= css(:tick) %>" x="<%= fnum(placement[:x]) %>" y="<%= fnum(placement[:y]) %>" dy="0.355em" text-anchor="<%= placement[:anchor] %>"><%= placement[:text] %></text>
        <% end %>
      </g>
    <% end %>
    <% if tooltip? %>
      <g data-slot="chart-hit-wedges">
        <% rows.each_index do |i| %>
          <path data-slot="chart-hit-wedge" data-index="<%= i %>" d="<%= hit_wedge(i) %>" fill="transparent" />
        <% end %>
      </g>
    <% end %>
  </svg>
  <% if legend? %>
    <%= render legend_component %>
  <% end %>
  <% if tooltip? %><%= render tooltip_layer_component %><% end %>
  <script type="application/json" data-slot="chart-coordinates" <%= tag.attributes(stimulus_attributes_for(:coordinates)) %>><%= script_json(coordinates_json) %></script>
  <% end %>
<% end %>
