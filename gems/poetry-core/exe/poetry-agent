#!/usr/bin/env ruby
# frozen_string_literal: true

# poetry-agent: the poetry MCP server - newline-delimited
# JSON-RPC 2.0 over stdio, serving list_components / describe_component /
# check from the committed registry. Boot-free: gems load (~0.4s once per
# agent session), the Rails app never boots - every check call after that is
# milliseconds, vs. a full app boot per `rake poetry:check` run.
#
# Usage: poetry-agent [registry-root]
#   registry-root defaults to the bundled poetry-ui gem. In .mcp.json:
#     {"mcpServers": {"poetry": {"command": "bundle", "args": ["exec", "poetry-agent"]}}}

require "poetry/core"

root = ARGV[0] || begin
  spec = Gem::Specification.find_all_by_name("poetry-ui").first
  spec&.gem_dir
end
registry = root && File.join(root, Poetry::Core::Registry::RELATIVE_PATH)
unless registry && File.exist?(registry)
  abort "poetry-agent: no component registry at #{registry || "(no poetry-ui found)"} - " \
        "pass the poetry-ui root as the first argument"
end

# The icon set powers check's icon-name membership tier; a host without
# poetry-lucide still checks icon-name shape.
icon_names = begin
  require "poetry/lucide"
  Poetry::Core::Icons.set(:lucide).names
rescue LoadError, Poetry::Core::Error
  nil
end

# Skills + live helper names ride along whenever poetry-ui is bundled - the
# same catalog poetry-ui's own exe serves. Both gems ship a `poetry-agent`
# executable and nothing guarantees which one a binstub or shim resolves
# (rubygems binstubs hardcode a gem name, last install wins), so the two
# exes must project the SAME agent surface or hosts silently lose get_skill
# depending on install order.
skills, helpers, recipes = begin
  require "poetry/ui"
  [Poetry::Ui.agent_skills, Poetry::Ui.helper_names, Poetry::Ui.recipe_items.summaries]
rescue LoadError
  [{}, nil, []]
end

# app_root (Dir.pwd) is the app the agent runs in: build_page's probe/direct
# steps read its config/theme, degrading gracefully when they cannot.
Poetry::Core::Agent::Server.from_registry(
  root, icon_names: icon_names, helpers: helpers, skills: skills, app_root: Dir.pwd,
        recipes: recipes
).serve
