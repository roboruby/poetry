{
  "name": "@poetry/controllers",
  "version": "0.0.4",
  "private": true,
  "description": "poetry's Stimulus controllers + DOM helpers. Importmap-first; this package is the opt-in npm channel for esbuild/Vite/jsbundling hosts. One source, two channels - never requires a bundler.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./app/javascript/poetry/core/index.js",
    "./*": "./app/javascript/poetry/core/*.js"
  },
  "files": [
    "app/javascript"
  ],
  "peerDependencies": {
    "@hotwired/stimulus": ">= 3.2"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "manifest": "MANIFEST_WRITE=1 vitest run test/javascript/controllers_manifest.test.js test/javascript/state_vocabulary_manifest.test.js"
  }
}
