{
  "name": "note-card",
  "type": "registry:component",
  "title": "Note card",
  "description": "A note in a card, with its author and a pin.",
  "registryDependencies": [
    "button"
  ],
  "dependencies": [],
  "files": [
    {
      "path": "app/components/community/note_card/component.rb",
      "target": "app/components/community/note_card/component.rb"
    },
    {
      "path": "app/components/community/note_card/style.rb",
      "target": "app/components/community/note_card/style.rb"
    }
  ],
  "docs": "Restart a running server after the install.",
  "meta": {
    "community": true,
    "source": {
      "registry": "@acme",
      "item": "note",
      "url": "https://acme.dev/r/note.json",
      "repository": "https://github.com/acme/ui",
      "license": "MIT",
      "copyright": "Copyright (c) 2025 Acme",
      "notice": "MIT License\n\nPermission is hereby granted"
    },
    "version": "44204791b5d3",
    "demo": "<%= community_note_card(body: \"Ship it\", author: \"Ada\") do |note| %>\n  <% note.with_pin { poetry_icon(name: :pin) } %>\n<% end %>",
    "screenshot": {
      "path": "screenshots/note-card.webp",
      "width": 1344,
      "height": 176
    },
    "component": {
      "helper": "community_note_card",
      "options": [
        {
          "name": "author",
          "type": "string",
          "description": "Who wrote the note."
        },
        {
          "name": "body",
          "type": "string",
          "required": true,
          "description": "The note's text."
        },
        {
          "name": "pinned",
          "type": "boolean",
          "default": false,
          "description": "Shows the note pinned."
        }
      ],
      "styles": [
        {
          "name": "size",
          "type": "symbol",
          "variants": [
            "default",
            "sm"
          ],
          "default": "default",
          "required": true
        }
      ],
      "slots": [
        {
          "name": "pin",
          "many": false,
          "description": "The glyph a pinned note shows."
        }
      ],
      "agent_rules": [
        "body: is plain text; a note never renders HTML."
      ]
    }
  }
}
