<%# The top nav: Community, where the site has the section, and the
    Resources panel in the NavigationMenu viewport. The guides and the
    galleries are the sidebar's, so the header repeats none of them and
    leaves the breadcrumb its room. The links that lead into a sidebar
    section open it on arrival (the opener map below, read by the
    sidebar-sections controller). %>
<% section_links = { poetry_docs.agent_skills_path => "AI Native", poetry_docs.mcp_path => "AI Native" } %>
<%= tag.div(class: "hidden lg:block", data: sidebar_opener(section_links)) do %>
  <%= poetry_navigation_menu(label: "Site", viewport: true) do |nav| %>
    <% nav.with_link("Community", href: poetry_docs.community_path) if Poetry::Docs.config.community_section? %>
    <% nav.with_item("Resources", value: "resources") do %>
      <div class="grid w-80 gap-1">
        <%= poetry_navigation_menu_link(href: poetry_docs.llms_path) do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">llms.txt</div>
            <p class="text-xs text-muted-foreground">The site index: every page, guide and machine resource</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/poetry/llms.txt") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">Component catalog (llms.txt)</div>
            <p class="text-xs text-muted-foreground">Every component contract in one file; llms-full.txt inlines the docs</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/installation.md") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">installation.md</div>
            <p class="text-xs text-muted-foreground">Copy-and-follow setup for a coding agent</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: poetry_docs.agent_skills_path) do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">Agent Skills</div>
            <p class="text-xs text-muted-foreground">Installable skills with a discovery index: npx skills add</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: poetry_docs.mcp_path) do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">MCP server</div>
            <p class="text-xs text-muted-foreground">The component contract over MCP, at /mcp and as a stdio exe</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/r/registry.json") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">registry.json</div>
            <p class="text-xs text-muted-foreground">Component registry for poetry:add and tools</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: poetry_docs.openapi_path) do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">openapi.json</div>
            <p class="text-xs text-muted-foreground">The machine endpoints, with an api-catalog beside it</p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
