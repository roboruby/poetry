<% content_for :title, @entry.title %>
<% content_for :breadcrumb do %>
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Docs", href: introduction_path) %>
    <% crumb.with_item(@entry.title) %>
  <% end %>
<% end %>

<div class="flex flex-col gap-10">
  <header class="flex flex-col gap-2">
    <h1 class="text-3xl font-semibold tracking-tight"><%= @entry.title %></h1>
    <p class="max-w-2xl text-muted-foreground"><%= @entry.description %></p>
  </header>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-medium" id="how-it-works">How it works</h2>
    <p class="max-w-2xl text-muted-foreground">
      A community item is a component, a block or a restyle the gems do not ship.
      <code class="text-foreground">poetry:add</code> takes any
      <code class="text-foreground">@poetry</code> name the gems do not know from this site and
      copies its files into your app, where they are yours to edit; nothing overwrites them later.
      Poetry's own components come from the gems at runtime, so an item that composes a Button
      brings no copy of it.
    </p>
    <%= poetry_code_block(code: "bin/rails g poetry:add @poetry/<name>", language: "plaintext", label: "Install") %>
    <p class="max-w-2xl text-sm text-muted-foreground">
      The install records where each item came from in
      <code class="text-foreground">config/poetry_components.yml</code>, with its version and a
      digest of every file written, and an item adapted from another library adds that library's
      license to your <code class="text-foreground">THIRD_PARTY_NOTICES.md</code>.
    </p>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-medium" id="reviewed-not-audited">Reviewed, not audited</h2>
    <p class="max-w-2xl text-muted-foreground">
      A maintainer reviewed every item, and each one passes the registry's checks: it installs
      into a fresh app, <code class="text-foreground">poetry:check</code> is clean there, and its
      demo renders in a browser without an error. Nobody audited the code for security, so read
      what you install, as you would any code you copy. An item adapted from another library
      names its origin and license on its page; only permissive licenses are accepted.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-lg font-medium" id="items">Items</h2>
    <% if @items.any? %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% @items.each do |item| %>
          <%= poetry_card do |card| %>
            <% card.with_title { link_to(item.title, community_item_path(item.name), class: "underline-offset-4 hover:underline") } %>
            <% card.with_description { item.description } %>
            <% card.with_action { poetry_badge(variant: :outline) { item.kind } } %>
            <% if (shot = item.screenshot) %>
              <%= link_to community_item_path(item.name), class: "block overflow-hidden rounded-md border", tabindex: -1, aria: { hidden: true } do %>
                <%= image_tag registry_community_screenshot_path(file: File.basename(shot["path"])),
                              alt: "", loading: "lazy", width: shot["width"].to_i / 2, height: shot["height"].to_i / 2,
                              class: "aspect-video w-full bg-white object-contain" %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="max-w-2xl text-muted-foreground">
        This site serves no community registry, so there is nothing to install from here.
      </p>
    <% end %>
  </section>
</div>
