<%# The Community sidebar: the search, then each filter as a group that
    opens to its choices, with how many items each would give. A group is
    closed until it holds a choice or the visitor opens it, and an opened
    or closed group is remembered (the sidebar-sections cookie, as the
    docs' nav). Every choice is a link, so the address holds the whole
    state. A long filter shows its first choices and a link to the rest;
    one that takes several and has many (the library) is picked in a
    dialog, whose list is fetched when it opens.
    Locals: browse (CommunityBrowse, or a host's own with its readers),
    path (the list's address), noun (what the list holds). %>
<% address = ->(params) { query = params.to_query; query.empty? ? path : "#{path}?#{query}" } %>
<% link = ->(changes) { address.call(browse.params_for(changes)) } %>
<% states = sidebar_section_states %>
<% row = "flex items-center gap-2 rounded-md px-2 py-1 text-sm transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground" %>
<div class="flex flex-col gap-4 px-2 pb-6 pt-2" data-community-filters>
  <%= form_with url: path, method: :get, html: { role: "search", class: "flex flex-col gap-2" } do %>
    <% browse.params_for("q" => nil).each do |param, value| %>
      <%= hidden_field_tag param, value, id: nil %>
    <% end %>
    <label for="community-search" class="text-xs font-medium text-sidebar-foreground/70">Search</label>
    <div class="flex items-center gap-2">
      <%= poetry_input(type: "search", name: "q", value: browse.query, id: "community-search",
                       placeholder: "Search #{local_assigns.fetch(:noun, "components")}", class: "h-8") %>
      <%= poetry_button(type: "submit", variant: :outline, size: :"icon-sm", label: "Search") { poetry_icon(name: :search) } %>
    </div>
  <% end %>
  <div class="flex flex-col gap-0.5">
    <% browse.facets.each do |facet| %>
      <% picked = facet.options.count(&:selected) %>
      <% key = "community:#{facet.param}" %>
      <% noun = facet.label.downcase %>
      <%= poetry_collapsible(open: (states.key?(key) ? states[key] == true : picked.positive?),
                             class: "group/collapsible", data: { filter: facet.param }) do |group| %>
        <% group.with_trigger(variant: :ghost, size: :sm,
                              class: "h-auto w-full justify-start gap-2 px-2 py-1.5 text-sm font-medium " \
                                     "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
                              data: { action: "click->sidebar-sections#remember", sidebar_sections_section_param: key }) do %>
          <span><%= facet.label %></span>
          <% if picked.positive? %>
            <span class="rounded-full bg-sidebar-accent px-1.5 text-xs tabular-nums text-sidebar-accent-foreground" data-filter-picked>
              <%= picked %><span class="sr-only"> chosen</span>
            </span>
          <% end %>
          <%= poetry_icon(name: :"chevron-right",
                          class: "ml-auto size-3.5 shrink-0 transition-transform duration-200 group-data-[open]/collapsible:rotate-90") %>
        <% end %>
        <div class="flex flex-col gap-1 pb-2 pl-2 pt-1">
          <% if facet.options.any? %>
            <ul class="flex flex-col gap-0.5">
              <% facet.options.each do |option| %>
                <li>
                  <%= link_to address.call(browse.toggled(facet.param, option.value)), rel: "nofollow",
                              aria: { current: ("true" if option.selected) },
                              class: class_names(row, option.selected ? "bg-sidebar-accent font-medium text-sidebar-accent-foreground" : "text-sidebar-foreground") do %>
                    <span class="min-w-0 flex-1 truncate"><%= option.label %></span>
                    <% if option.selected %>
                      <%= poetry_icon(name: :x, class: "size-3.5 shrink-0") %><span class="sr-only">Remove this filter</span>
                    <% else %>
                      <span class="shrink-0 text-xs tabular-nums text-sidebar-foreground/60"><%= option.count %></span>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <% if facet.picker %>
            <% picker = address.call(browse.params_for("pick" => facet.param)) %>
            <%= poetry_dialog(content_class: "sm:max-w-lg") do |dialog| %>
              <% dialog.with_trigger(variant: :outline, size: :sm, class: "w-full justify-between font-normal",
                                     data: { filter_picker: facet.param }) do %>
                <span><%= picked.zero? ? "Any #{noun}" : "Choose more" %></span>
                <span class="flex items-center gap-1 text-xs tabular-nums text-muted-foreground">
                  <%= facet.options.size + facet.more %><%= poetry_icon(name: :"chevron-right", class: "size-3.5") %>
                </span>
              <% end %>
              <% dialog.with_title { "Choose #{noun.pluralize}" } %>
              <% dialog.with_description { "Tick any number. The list shows what came from any of them." } %>
              <%# min-w-0: the dialog is a grid, and a grid item is as wide as
                  its widest line unless told it may be narrower; on a phone
                  the list's longest name would push the dialog's content
                  past its edge. %>
              <%= turbo_frame_tag "community-picker-#{facet.param}", src: picker, loading: :lazy, target: "_top", class: "block min-w-0" do %>
                <p class="py-6 text-center text-sm text-muted-foreground">Loading…</p>
              <% end %>
            <% end %>
            <noscript><%= link_to "Choose #{noun.pluralize}", picker, rel: "nofollow", class: "px-2 text-xs underline underline-offset-4" %></noscript>
          <% elsif facet.more.to_i.positive? %>
            <%= link_to "Show all #{facet.options.size + facet.more}", link.call("more" => facet.param), rel: "nofollow",
                        data: { filter_more: true }, class: "inline-block px-2 text-xs text-sidebar-foreground/70 underline underline-offset-4 hover:text-sidebar-foreground" %>
          <% elsif facet.open %>
            <%= link_to "Show fewer", link.call("more" => nil), rel: "nofollow",
                        data: { filter_more: true }, class: "inline-block px-2 text-xs text-sidebar-foreground/70 underline underline-offset-4 hover:text-sidebar-foreground" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
