<%# One assistant message row, rendered from a Poetry::Ui::Chat frame's
    accumulated parts. The stream vreplace-s this same row as frames
    arrive; data-version is the morph guard's monotonic clock. Before the
    first frame the row is a running "Thinking" line; after, its runs
    (Poetry::Docs::AgentActivity): text in a muted bubble, each run of
    reasoning and tool calls as one Trace. A tool waiting on approval is
    asked in the controls below. %>
<div id="row-<%= seg_id %>" data-version="<%= version %>">
  <%= poetry_message do %>
    <div class="flex min-w-0 flex-col gap-2">
      <% if parts.empty? %>
        <%= poetry_trace(id: "trace-#{seg_id}-waiting") do |trace| %>
          <% trace.with_step("Thinking", icon: :brain, status: :running) %>
        <% end %>
      <% end %>
      <% Poetry::Docs::AgentActivity.runs(parts).each_with_index do |run, index| %>
        <% case run.kind %>
        <% when :text %>
          <%= poetry_bubble(variant: :muted) { run.text } %>
        <% when :activity %>
          <%= render "poetry/docs/agent_activity/trace", parts: run.parts, id: "trace-#{seg_id}-#{index}" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
