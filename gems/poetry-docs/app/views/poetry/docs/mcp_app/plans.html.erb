<%# The plans app's template: rendered once, before any call, as the shell
    the fragments fill. The region waits with a skeleton until the host
    delivers the tool result. No card of the page's own: the document asks
    the host for a border (prefers_border), and a chat panel is narrow. %>
<main class="p-4">
  <div class="flex flex-col gap-4" data-mcp-region="plans">
    <header class="flex flex-col gap-1.5">
      <h3 class="font-semibold leading-none">Plans</h3>
      <p class="text-sm text-muted-foreground">Waiting for the plans</p>
    </header>
    <div class="flex flex-col gap-2">
      <%= poetry_skeleton(class: "h-4 w-2/3") %>
      <%= poetry_skeleton(class: "h-4 w-1/2") %>
      <%= poetry_skeleton(class: "h-4 w-3/5") %>
    </div>
  </div>
</main>
