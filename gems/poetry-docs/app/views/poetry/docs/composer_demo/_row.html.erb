<%# One transcript row of the Composer page's live example. The reader's
    row sits at the end and anchors the turn; the reply's row is replaced
    whole as its text grows (data-version is the versioned replace's
    clock), and shows a spinner until the first words arrive. %>
<%= poetry_message_scroller_item(id: id, dom_id: id, anchor: align == :end, class: "px-4 py-2",
                                 data: { version: version }) do %>
  <%= poetry_message(align: align) do %>
    <% if align == :end %>
      <%= poetry_bubble { text } %>
    <% elsif text.blank? %>
      <%= poetry_bubble(variant: :muted) { poetry_spinner(label: "Writing a reply") } %>
    <% else %>
      <%= poetry_bubble(variant: :muted) { text } %>
    <% end %>
  <% end %>
<% end %>
