<%# One message row from an AG-UI transcript, re-rendered by the relay on
    every change: data-version is the versioned replace's clock. User
    turns are bubbles at the end. An assistant turn renders its runs
    (Poetry::Docs::AgentActivity): text in a muted bubble, each run of
    reasoning and tool calls as one Trace, and an activity as its A2UI
    surface or its JSON. %>
<div id="row-<%= message.id %>" data-version="<%= version %>">
  <% if message.role == "user" %>
    <%= poetry_message(align: :end) do %>
      <%= poetry_bubble { message.parts.map { |part| part[:text] }.join } %>
    <% end %>
  <% else %>
    <%= poetry_message do %>
      <div class="flex min-w-0 flex-col gap-2">
        <% Poetry::Docs::AgentActivity.runs(message.parts).each_with_index do |run, index| %>
          <% case run.kind %>
          <% when :text %>
            <%= poetry_bubble(variant: :muted) { run.text } %>
          <% when :activity %>
            <%= render "poetry/docs/agent_activity/trace", parts: run.parts, id: "trace-#{message.id}-#{index}" %>
          <% when :part %>
            <% part = run.part %>
            <% if part[:kind] == :activity && part[:activity_type] == "a2ui-surface" %>
              <%= render "poetry/docs/agui_relay/surface", content: part[:content], errors: local_assigns[:surface_errors] || {} %>
            <% elsif part[:kind] == :activity %>
              <code class="rounded-md border px-3 py-2 text-xs"><%= part[:activity_type] %>: <%= part[:content].to_json %></code>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
