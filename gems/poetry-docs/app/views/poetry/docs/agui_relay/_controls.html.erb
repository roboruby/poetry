<%# What follows a finished run: the interrupt's decision (run 2) as an
    approval prompt, the note beside the tab tool's own prompt while it
    waits on the person (run 1), or the replay link. State is the URL, so every point is
    shareable. %>
<% link = ->(q) { "#{page}?#{q.merge(instant: params[:instant].presence).compact.to_query}" } %>
<% finished = index >= 4 || (index == 3 && decision == false) %>
<div id="agui-relay-next" class="px-4 pb-4">
  <% if transcript.interrupted? %>
    <% interrupt = transcript.interrupts.first %>
    <%= render "poetry/docs/agent_activity/approval", icon: :"calendar-check",
               title: interrupt["message"].presence || "The agent is waiting for an answer (#{interrupt["reason"]})",
               description: "The trial is free for 30 days; nothing is billed until it ends.",
               approve: link.call(s: 3, d: 1, tool_result: params[:tool_result].presence),
               deny: link.call(s: 3, d: 0, tool_result: params[:tool_result].presence) %>
  <% else %>
    <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
      <% if (pending = transcript.pending_client_tools.first)&.dig(:confirm) %>
        <span>The agent asks before it changes this page. Approve and the browser runs <code><%= pending[:name] %></code> through the registrar; deny and the agent is told no.</span>
      <% elsif pending %>
        <span>The browser is running <code><%= pending[:name] %></code> through the registrar…</span>
      <% elsif finished %>
        <%= poetry_button(size: :sm, variant: :outline, href: link.call(s: 1)) { "Replay from the top" } %>
      <% elsif index == 3 %>
        <span>The trial card above is an A2UI surface the agent painted mid-stream; its form posts back into the run.</span>
        <%= poetry_button(size: :sm, variant: :outline, href: link.call(s: 1)) { "Replay from the top" } %>
      <% else %>
        <span>streaming…</span>
      <% end %>
    </div>
  <% end %>
</div>
