<%# The panel animates its height both ways: the controller measures it into
    --collapsible-panel-height while it opens or closes and sets it back to
    auto at rest, so content that grows later is never clipped. %>
<div class="w-full max-w-md">
  <%= poetry_collapsible(content_class: "h-(--collapsible-panel-height) overflow-hidden transition-[height] duration-200 ease-out data-starting-style:h-0 data-ending-style:h-0") do |collapsible| %>
    <% collapsible.with_trigger(variant: :outline, class: "w-full justify-between [&[aria-expanded=true]>svg]:rotate-180") do %>
      Release notes
      <%= poetry_icon(name: :"chevron-down", class: "size-4 text-muted-foreground transition-transform") %>
    <% end %>
    <div class="space-y-2 pt-3 text-sm text-muted-foreground">
      <p>Collapsible measures its panel and hands the size to CSS.</p>
      <p>A height transition reads it, from 0 on the way in and back to 0 on the way out.</p>
      <p>At rest the size is auto again.</p>
    </div>
  <% end %>
</div>
