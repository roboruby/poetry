<%# An error's output: variant: :destructive, the small size, wrapped lines,
    and a footer row. %>
<% output = <<~TEXT
  NoMethodError: undefined method 'sum' for nil
    app/models/invoice.rb:8:in 'Invoice#total'
    app/controllers/invoices_controller.rb:12:in 'InvoicesController#show'
TEXT
%>
<div class="w-full max-w-xl">
  <%= poetry_code_block(code: output, variant: :destructive, size: :sm, wrap: true, label: "Error output") do |block| %>
    <% block.with_footer { "Exited with status 1" } %>
  <% end %>
</div>
