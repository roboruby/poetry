<div class="grid w-full gap-4 sm:grid-cols-2">
  <% [[:grid, :none], [:none, :aurora], [:none, :retro_grid], [:none, :ripple]].each do |pattern, effect| %>
    <%= poetry_background(pattern: pattern, effect: effect, class: "flex h-40 items-center justify-center rounded-xl border") do %>
      <span class="text-sm font-medium"><%= effect == :none ? pattern : effect %></span>
    <% end %>
  <% end %>
</div>
