<%# The MCP App demo on the real host: this site hosts its own plans app the
    way it would host any server's. The page calls show_plans through the
    host (in process), renders the frame the host controller fills, and
    logs the bridge's traffic both ways. With no apps origin configured
    the frame runs the inline sandbox mode (an opaque frame of the page's
    own); with one, the two-origin sandbox the extension asks for. %>
<% host = Poetry::Docs::McpAppShowcase.host(request.base_url) %>
<% team_size = params.fetch(:team_size, 8).to_i.clamp(1, 500) %>
<% call = host.call("poetry-docs", "show_plans", { "team_size" => team_size }) %>
<div class="grid w-full gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]" data-controller="mcp-app-demo"
     data-action="poetry:mcp-app-host:connect->mcp-app-demo#connected poetry:mcp-app-host:message->mcp-app-demo#message poetry:mcp-app-host:context->mcp-app-demo#context poetry:mcp-app-host:display-mode->mcp-app-demo#displayMode poetry:mcp-app-host:trace->mcp-app-demo#trace">
  <div class="flex flex-col gap-4">
    <%= form_with url: request.path, method: :get, class: "flex flex-wrap items-end gap-3", data: { turbo: false } do |form| %>
      <%= poetry_field(id: "mcp-app-team-size", label_text: "Team size", class: "w-32") do |field| %>
        <%= poetry_input(type: "number", name: "team_size", value: team_size, min: 1, **field.control_attributes.transform_keys(&:to_sym)) %>
      <% end %>
      <%= poetry_button(type: :submit) { "Call show_plans" } %>
      <%= poetry_button(variant: :outline, type: :button, data: { action: "click->mcp-app-demo#toggleTheme" }) { "Flip the host theme" } %>
    <% end %>
    <%= tag.div(class: "overflow-hidden rounded-xl border bg-card",
                data: host.frame_data(call, rpc_url: mcp_app_rpc_path).merge("poetry--agent--mcp-app-host-debug-value" => "true")) do %>
      <p class="p-4 text-sm text-muted-foreground" data-poetry--agent--mcp-app-host-target="status">Loading the app</p>
    <% end %>
    <p class="text-sm text-muted-foreground" data-mcp-app-demo-target="status">
      <%= host.sandbox_origin ? "Sandbox on #{host.sandbox_origin}." : "Inline sandbox mode: no apps origin is configured here, so the proxy page runs as an opaque frame of this page's own." %>
    </p>
  </div>
  <div class="flex flex-col gap-3">
    <h3 class="text-sm font-medium">Messages the app sent to the chat</h3>
    <ul class="flex min-h-10 flex-col gap-1 text-sm" data-mcp-app-demo-target="messages"></ul>
    <h3 class="text-sm font-medium">The bridge, both ways</h3>
    <ol class="max-h-80 overflow-auto rounded-lg border bg-muted/40 p-2 font-mono text-xs leading-5" data-mcp-app-demo-target="log"></ol>
    <p class="text-sm text-muted-foreground">
      This is the host side (<code>Poetry::Agent::Apps::Host</code> and the
      <code>poetry--agent--mcp-app-host</code> controller) over this site's own
      server: the page called <code>show_plans</code> through the host, the frame
      read the document and handed it to the sandbox, and the app's own calls
      (<code>choose_plan</code>, a tool only the app may call) go through the
      host's endpoint with its visibility check. The same frame renders in the
      AG-UI Relay demo when the agent's tool has an app.
    </p>
  </div>
</div>
