# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# The family from the tree beside this gem; a published install resolves
# the same names from RubyGems.
sibling = lambda do |name|
  path = File.expand_path("../#{name}", __dir__)
  File.directory?(path) ? { path: path } : {}
end
gem "poetry-core", **sibling.call("poetry-core")
gem "poetry-lucide", **sibling.call("poetry-lucide")
gem "poetry-ui", **sibling.call("poetry-ui")
gem "poetry-charts", **sibling.call("poetry-charts")
gem "poetry-agent", **sibling.call("poetry-agent")

if ENV["POETRY_RAILS"] == "main"
  gem "rails", github: "rails/rails", branch: "main"
else
  gem "rails", "~> 8.1.3"
end

gem "puma", ">= 5.0" # the dummy host's server (bin/dev)
gem "rake", "~> 13.0"
gem "minitest"
gem "bundler-audit", require: false
gem "rubocop-rails-omakase", require: false
gem "herb", "~> 0.11.0", require: false # poetry:check's parser and the herb:compile gate
gem "tailwindcss-ruby" # rake poetry_docs:css builds the committed stylesheet
gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
