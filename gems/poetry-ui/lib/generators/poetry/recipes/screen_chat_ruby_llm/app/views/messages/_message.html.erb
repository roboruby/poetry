<%# locals: (message:, text: nil, streaming: false) %>
<%# installed by the poetry `screen-chat-ruby-llm` recipe - yours to adapt.
    One row of the transcript. The person's words are escaped text in a
    bubble at the end. The reply is the model's Markdown: poetry_markdown
    parses it with the Markdown gem in your Gemfile (commonmarker or
    redcarpet) and lets no markup through. text: is the reply as far as a
    stream has written it, rendered with streaming: so what it has left
    open is closed for display; without it the stored text renders. A
    reply with no text yet shows that it has begun.
    A stored reply carries what a stream cannot: the sources the model
    cited (message.citations, when the chat asked for them or searched),
    marked in the text and listed under it, and the two thumbs. note is
    how the turn ended when it did not end with a reply (Stopped, a
    failure), kept on the message it follows. Both are columns of yours:
    bin/rails g migration AddNoteAndFeedbackToMessages note:string feedback:string %>
<%= poetry_message_scroller_item(id: message.id, dom_id: dom_id(message), anchor: message.role == "user",
                                 class: "px-4 py-2") do %>
  <% if message.role == "user" %>
    <%= poetry_message(align: :end) do %>
      <%= poetry_bubble { message.content } %>
    <% end %>
  <% else %>
    <% written = text || message.content.to_s %>
    <%= poetry_message do %>
      <% if written.blank? %>
        <%= poetry_trace do |trace| %>
          <% trace.with_step("Thinking", icon: :brain, status: :running) %>
        <% end %>
      <% elsif streaming %>
        <%= poetry_bubble(variant: :ghost) do %>
          <%= poetry_markdown(text: written, streaming: true, heading_level: 3) %>
        <% end %>
      <% else %>
        <% marked, sources = Poetry::Ui::Citations.mark(written, message.citations) %>
        <div class="flex min-w-0 flex-col gap-1">
          <%= poetry_bubble(variant: :ghost) do %>
            <%= poetry_markdown(text: marked, sources: sources, heading_level: 3) %>
          <% end %>
          <% if sources.any? %>
            <%= poetry_sources do |list| %>
              <% sources.each do |source| %>
                <% list.with_source(source[:title], href: source[:href], description: source[:description]) %>
              <% end %>
            <% end %>
          <% end %>
          <%= render "messages/feedback", message: message %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <% if message.note.present? %>
    <%= poetry_marker { message.note } %>
  <% end %>
<% end %>
