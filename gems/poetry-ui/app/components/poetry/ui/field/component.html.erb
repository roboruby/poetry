<%= content_tag(:div, **root_attributes.to_attributes) do %>
  <% if label_text.present? %>
    <% if group %>
      <%= render Poetry::Ui::Label::Component.new(for_id: nil, id: label_id).with_content(label_text) %>
    <% else %>
      <%= render Poetry::Ui::Label::Component.new(for_id: id).with_content(label_text) %>
    <% end %>
  <% end %>
  <% hint_body = hint_block ? capture(&hint_block) : hint %>
  <% hint_tag = capture do %>
    <% if hint_present? %><p id="<%= hint_id %>" data-slot="field-hint" class="<%= css(:hint) %>"><%= hint_body %></p><% end %>
  <% end %>
  <%= hint_tag if hint_position == :above %>
  <%= content %>
  <%= hint_tag if hint_position == :below %>
  <% if error.present? %><p id="<%= error_id %>" data-slot="field-error" class="<%= css(:error) %>"><%= error %></p><% end %>
<% end %>
