<% if variant == :input %>
  <%= render input_variant_component %>
<% else %>
  <%= element_tag(:div, **root_attributes) do %>
    <%= element_tag(:label, dropzone_attributes) do %>
      <%= tag(:input, control_attributes) %>
      <%= render Poetry::Ui::Icon::Component.new(name: :upload, class: css(:icon)) %>
      <span data-slot="file-input-prompt" class="<%= css(:prompt) %>"><%= prompt_text %></span>
      <% if hint.present? %><span data-slot="file-input-hint" class="<%= css(:hint) %>"><%= hint %></span><% end %>
    <% end %>
    <%= element_tag(:ul, "", list_attributes) %>
    <%= element_tag(:ul, "", errors_attributes) %>
    <%= element_tag(:button, t("poetry.file_input.clear"), clear_attributes) %>
    <% if overlay %>
      <div data-slot="file-input-overlay" class="<%= css(:overlay) %>" aria-hidden="true">
        <span class="<%= css(:overlay_prompt) %>"><%= t("poetry.file_input.overlay") %></span>
      </div>
    <% end %>
  <% end %>
<% end %>
