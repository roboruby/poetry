<%= content_tag(:div, **root_attributes.to_attributes) do %>
  <% if header? %>
    <div data-slot="card-header" class="<%= css(:header) %>">
      <% if title? %><div data-slot="card-title" class="<%= css(:title) %>"><%= title %></div><% end %>
      <% if description? %><div data-slot="card-description" class="<%= css(:description) %>"><%= description %></div><% end %>
      <% if action? %><div data-slot="card-action" class="<%= css(:action) %>"><%= action %></div><% end %>
    </div>
  <% end %>
  <div data-slot="card-content" class="<%= css(:content) %>"><%= content %></div>
  <% if footer? %><div data-slot="card-footer" class="<%= css(:footer) %>"><%= footer %></div><% end %>
<% end %>
