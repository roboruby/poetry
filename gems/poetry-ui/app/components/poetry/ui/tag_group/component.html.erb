<%# Grid semantics: caption span (aria-labelledby - a grid is not a
    labelable control), then the roving row collection. %>
<%= element_tag(:div, **root_attributes) do %>
  <%= element_tag(:span, label, "id" => label_id, "data-slot" => "tag-group-label", "class" => css(:label)) %>
  <%= element_tag(:div, **grid_attributes) do %>
    <% tags.each do |tag_slot| %><%= tag_slot %><% end %>
  <% end %>
<% end %>
