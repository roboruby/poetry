#!/usr/bin/env ruby
# frozen_string_literal: true

# poetry-agent: the MCP server. An MCP host (Claude Code / Cursor)
# runs this over stdio; it projects the live poetry component contract -
# list_components, describe_component (brief|detailed|full), check
# (verdict-returning lint), and the blocks catalog (list_blocks /
# describe_block) - all read-only. Boot-free: it reads the committed
# registry, so it starts instantly (no Rails).
#
# NOTE: poetry-core ships a same-named exe (for apps without poetry-ui),
# and NOTHING guarantees which one a bare `poetry-agent` resolves to when
# both gems are bundled: rubygems binstubs hardcode a gem name (last
# install wins) and version-manager shims add another layer. The doctrine
# is therefore PARITY - both exes must project the same agent surface;
# core's exe soft-requires poetry/ui and serves the same skills/helpers.
# The blocks-gate run (2026-07-09) learned the shadow lesson the hard way:
# this exe lacked the icon-name injection, so every MCP check ran
# shape-only and a `:filter` guess (lucide renamed it to funnel) sailed
# through to a render crash the icon-membership tier existed to prevent.
#
# Wire it up (Claude Code), from an app that has poetry installed:
#   claude mcp add poetry -- bundle exec poetry-agent

require "poetry/ui"

# The icon set powers check's icon-name membership tier; a host without
# poetry-lucide still checks icon-name shape.
icon_names = begin
  require "poetry/lucide"
  Poetry::Core::Icons.set(:lucide).names
rescue LoadError, Poetry::Core::Error
  nil
end

# app_root is the app the agent runs in (Dir.pwd): build_page's probe/direct
# steps read its config/theme. A miss just degrades those steps gracefully.
Poetry::Core::Agent::Server.from_registry(
  Poetry::Ui.root, helpers: Poetry::Ui.helper_names, icon_names: icon_names,
                   skills: Poetry::Ui.agent_skills, app_root: Dir.pwd
).serve
