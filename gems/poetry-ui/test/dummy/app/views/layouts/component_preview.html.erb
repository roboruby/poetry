<!DOCTYPE html>
<html lang="en">
  <head>
    <title>poetry-ui component preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Static assets generated by `rake browser:assets`: a real Tailwind
        build (the css:verify_compiled recipe) + poetry's controllers served
        over an importmap - Stimulus actually runs in these pages. %>
    <link rel="stylesheet" href="/assets/poetry.css">
    <style>
      /* Deterministic screenshots (rake test:visual): no motion in the
         preview host - spinners freeze, presence animations land instantly. */
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
        caret-color: transparent !important;
      }
    </style>
    <script type="importmap"><%= raw Rails.public_path.join("assets/importmap.json").read %></script>
    <script type="module">
      import { Application } from "@hotwired/stimulus"
      import { registerPoetryControllers } from "@poetry/controllers"

      const application = new Application()
      registerPoetryControllers(application)
      await application.start()
      // The browser tasks wait for this flag before running axe / screenshotting.
      document.documentElement.dataset.poetryReady = "true"
    </script>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
