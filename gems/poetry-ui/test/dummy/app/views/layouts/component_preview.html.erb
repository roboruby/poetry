<!DOCTYPE html>
<html lang="en">
  <head>
    <title>poetry-ui component preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Static assets generated by `rake browser:assets`: a real Tailwind
        build (the css:verify_compiled recipe) + poetry's controllers served
        over an importmap - Stimulus actually runs in these pages. %>
    <link rel="stylesheet" href="/assets/poetry.css">
    <style>
      /* Deterministic screenshots (rake test:visual): no motion in the
         preview host - spinners freeze, presence animations land instantly.
         Scoped behind reduced-motion (the poetry-charts pattern): the
         browser rig emulates it via CDP, while a real browser visiting the
         previews keeps live motion (the D3 viewport-morph lesson - the
         blanket rule masked the transitions it was supposed to prove). */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
          caret-color: transparent !important;
        }
      }
      /* The install-parity body (poetry:install's base.css verbatim): a
         real host's body rides the tokens, so the previews must too -
         without this, flipping .dark leaves dark foregrounds on the UA's
         white canvas (a page no host ever renders), and any theme whose
         light background isn't pure white screenshots wrong. */
      body {
        background-color: var(--background);
        color: var(--foreground);
      }
    </style>
    <%# The importmap is generated by `rake browser:assets` (gitignored); the in-process
        test tiers render this layout without it, so an absent file yields an empty map. %>
    <script type="importmap"><%= raw Rails.public_path.join("assets/importmap.json").then { |map| map.exist? ? map.read : "{}" } %></script>
    <script type="module">
      import { Application } from "@hotwired/stimulus"
      import { registerPoetryControllers } from "@poetry/controllers"

      const application = new Application()
      window.Stimulus = application // the Rails convention hosts follow (controllers/application.js); the testers read it
      registerPoetryControllers(application)
      await application.start()
      // The browser tasks wait for this flag before running axe / screenshotting.
      document.documentElement.dataset.poetryReady = "true"
    </script>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
