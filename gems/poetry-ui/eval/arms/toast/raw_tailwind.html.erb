<%# The raw-Tailwind arm: a FROZEN, representative agent generation for
    the same toast task - deliberately realistic, not a strawman: the
    stack gets a fixed corner and plausible styling, the error even gets
    role=alert, with the typical raw tells (no labeled region, inline
    onclick dismissal, an unnamed x close button, no timer-pause
    semantics, no focus-visible treatment). %>
<div class="fixed right-4 bottom-4 z-50 flex w-80 flex-col gap-2" aria-live="polite">
  <div class="flex items-start gap-3 rounded-md border bg-white p-4 shadow-lg">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 text-green-600" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>
    <div class="flex-1">
      <p class="text-sm font-medium">Saved</p>
      <p class="text-sm text-gray-500">Your changes are live.</p>
    </div>
    <button class="text-gray-400 hover:text-gray-600" onclick="this.closest('div').parentElement.remove()">&times;</button>
  </div>
  <div role="alert" class="flex items-start gap-3 rounded-md border border-red-200 bg-white p-4 shadow-lg">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 text-red-600" fill="none" stroke="currentColor"><path d="M12 8v4m0 4h.01"/></svg>
    <div class="flex-1">
      <p class="text-sm font-medium text-red-600">Payment failed</p>
      <p class="text-sm text-gray-500">Your card was declined.</p>
    </div>
    <button class="rounded-md border px-2 py-1 text-xs font-medium">Retry</button>
    <button class="text-gray-400 hover:text-gray-600" onclick="this.closest('div').parentElement.remove()">&times;</button>
  </div>
</div>
