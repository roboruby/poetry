<%# The poetry arm: a real nav landmark - disclosure triggers with
    aria-expanded/-controls, panels of REAL links, no menu roles. %>
<%= poetry_navigation_menu(label: "Main") do |nav| %>
  <% nav.with_item("Products", value: "products") do %>
    <div class="grid w-64 gap-1">
      <%= poetry_navigation_menu_link(href: "/analytics", active: true) { "Analytics" } %>
      <%= poetry_navigation_menu_link(href: "/automation") { "Automation" } %>
    </div>
  <% end %>
  <% nav.with_link("Pricing", href: "/pricing") %>
  <% nav.with_link("Docs", href: "/docs") %>
<% end %>
