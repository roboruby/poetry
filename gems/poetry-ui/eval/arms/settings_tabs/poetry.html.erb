<%# The poetry arm: real tabs - tablist/tab/tabpanel roles, wired ids,
    a server-rendered active panel, keyboard via roving focus. %>
<%= poetry_tabs(label: "Account settings") do |tabs| %>
  <% tabs.with_tab("Account", value: "account") do %>
    <p>Make changes to your account here.</p>
    <%= poetry_clipboard_text(value: "pk_live_51Nx…9fQ2", label: "API key",
                              text_to_copy: "pk_live_51NxAbCdEfGhIjKlMnOpQrStUvWxYz0123456789fQ2") %>
  <% end %>
  <% tabs.with_tab("Password", value: "password") do %>
    <p>Change your password here.</p>
    <%= poetry_sensitive_input(name: "current_secret", label: "Current API secret",
                              value: "sk_demo_4eC39HqLyjWDarjtT1zdp7dc", copy: true) %>
  <% end %>
  <% tabs.with_tab("Notifications", value: "notifications") do %>
    <p>Choose what you hear about.</p>
  <% end %>
<% end %>
