<%# The poetry arm: "an FAQ accordion (one open at a time) plus a
    'show advanced options' collapsible". %>
<%= poetry_accordion(open: %w[shipping]) do |accordion| %>
  <% accordion.with_item(value: "shipping", title: "How fast is shipping?") { "Two business days, worldwide." } %>
  <% accordion.with_item(value: "returns", title: "What is the return policy?") { "Thirty days, no questions asked." } %>
<% end %>
<%= poetry_collapsible do |collapsible| %>
  <% collapsible.with_trigger(class: "text-sm font-medium hover:underline") { "Show advanced options" } %>
  <div class="pt-2 text-sm text-muted-foreground">Advanced configuration lives here.</div>
<% end %>
