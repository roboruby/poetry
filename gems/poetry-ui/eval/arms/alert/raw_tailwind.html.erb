  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 size-4"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/></svg>
  <div>
    <p class="font-medium">Payment failed</p>
    <p class="text-sm">Your card was declined. Update your billing details and retry.</p>
