<section class="flex w-full max-w-md flex-col gap-3">
  <h2 class="text-lg font-medium">Recent activity</h2>
  <div id="activity" class="flex h-24 w-full items-center justify-center rounded-md bg-gray-100">
    <div class="h-6 w-6 animate-spin rounded-full border-2 border-gray-300 border-t-gray-600"></div>
  </div>
  <script>
    fetch("/activity").then((r) => r.text()).then((html) => {
      document.getElementById("activity").innerHTML = html
    })
  </script>
</section>
