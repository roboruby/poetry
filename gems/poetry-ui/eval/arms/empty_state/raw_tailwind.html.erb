<%# The raw arm: plausible LLM output - the title is a styled div (no
    heading), the actions are clickable divs (no keyboard access). %>
<div class="flex w-full flex-col items-center justify-center rounded-lg border border-dashed p-12 text-center">
  <div class="flex size-10 items-center justify-center rounded-lg bg-gray-100 text-xl">📁</div>
  <div class="mt-4 text-lg font-medium">No projects yet</div>
  <div class="mt-1 text-sm text-gray-500">Get started by creating your first project.</div>
  <div class="mt-4 flex gap-2">
    <div class="cursor-pointer rounded-md bg-gray-900 px-3 py-1.5 text-sm text-white" onclick="createProject()">Create project</div>
    <div class="cursor-pointer rounded-md border px-3 py-1.5 text-sm" onclick="importProject()">Import project</div>
  </div>
</div>
