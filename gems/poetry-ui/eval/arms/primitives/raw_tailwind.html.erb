<%# The raw-Tailwind arm - realistic, with the tells: the spinner is a bare
    animated div with no role/label (silent to AT), and the shortcut keys
    are styled spans, not real <kbd>. %>
<div class="space-y-3">
  <div class="flex items-center gap-2 text-sm">
    <div class="size-4 animate-spin rounded-full border-2 border-gray-300 border-t-gray-600"></div>
    <span>Loading…</span>
  </div>
  <div class="h-4 w-48 animate-pulse rounded-md bg-gray-200"></div>
  <div class="h-px w-full bg-gray-200"></div>
  <p class="text-sm">Press
    <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-sm bg-gray-100 px-1 text-xs">⌘</span>
    <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-sm bg-gray-100 px-1 text-xs">K</span>
    to search.</p>
</div>
