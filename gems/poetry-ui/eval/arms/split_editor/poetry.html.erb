<%# The poetry arm: a resizable split - real separator handles with the
    APG splitter surface (keyboard + aria-value*). %>
<%= poetry_resizable(grip: true, class: "h-48 max-w-md rounded-lg border") do |group| %>
  <% group.with_panel(default_size: 30, min_size: 20) do %>
    <div class="flex h-full items-center justify-center p-6 text-sm">Files</div>
  <% end %>
  <% group.with_panel do %>
    <div class="h-full p-3">
      <%= poetry_code_block(code: "def total\n  line_items.sum(&:amount)\nend", language: "ruby",
                            label: "Editor buffer", line_numbers: true) %>
    </div>
  <% end %>
<% end %>
