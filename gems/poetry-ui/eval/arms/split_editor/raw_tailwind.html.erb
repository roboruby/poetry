<%# The raw arm: plausible LLM output - a mouse-only divider div: no
    separator role, no keyboard, no value announcement. %>
<div class="flex h-48 max-w-md rounded-lg border">
  <div class="w-1/3 min-w-32">
    <div class="flex h-full items-center justify-center p-6 text-sm">Files</div>
  </div>
  <div class="w-1 cursor-col-resize bg-gray-200 hover:bg-gray-300" onmousedown="startResize(event)"></div>
  <div class="flex-1">
    <div class="flex h-full items-center justify-center p-6 text-sm">Editor</div>
  </div>
</div>
