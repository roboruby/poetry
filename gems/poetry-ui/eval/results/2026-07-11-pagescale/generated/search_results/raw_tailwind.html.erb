<%
  search_query = "deployment"

  project_results = [
    {
      title: "Deployment Pipeline Revamp",
      snippet_pre: "Engineering initiative to revamp the ",
      snippet_match: "deployment",
      snippet_post: " pipeline to reduce release time from 40 minutes to under 10.",
      team: "Engineering",
      updated: "Updated 2 hours ago",
      extra: "12 members",
    },
    {
      title: "Q3 Infrastructure Deployment",
      snippet_pre: "Plan to coordinate the ",
      snippet_match: "deployment",
      snippet_post: " schedule across staging and production environments.",
      team: "Platform Ops",
      updated: "Updated yesterday",
      extra: "5 members",
    },
    {
      title: "Customer Success Deployment Playbook",
      snippet_pre: "Standard operating procedure for ",
      snippet_match: "deployment",
      snippet_post: " rollbacks and customer communication.",
      team: "Customer Success",
      updated: "Updated 3 days ago",
      extra: "8 members",
    },
  ]

  document_results = [
    {
      title: "Deployment Runbook v4",
      snippet_pre: "Run the ",
      snippet_match: "deployment",
      snippet_post: " script from the release branch and verify health checks pass before promoting.",
      kind: "Google Doc",
      owner: "Priya Nair",
      updated: "Edited 1 hour ago",
    },
    {
      title: "Zero-downtime deployment strategy",
      snippet_pre: "A blue-green ",
      snippet_match: "deployment",
      snippet_post: " strategy minimizes downtime during cutover to the new release.",
      kind: "PDF · 2.4 MB",
      owner: "Marcus Webb",
      updated: "Uploaded 6 days ago",
    },
    {
      title: "Incident Report: Failed Deployment 2026-06-30",
      snippet_pre: "Root cause of the failed ",
      snippet_match: "deployment",
      snippet_post: " was a misconfigured environment variable in the release job.",
      kind: "Confluence page",
      owner: "Aisha Okafor",
      updated: "Updated 2 weeks ago",
    },
    {
      title: "CI/CD Deployment Checklist",
      snippet_pre: "Checklist to follow before every production ",
      snippet_match: "deployment",
      snippet_post: ", including rollback steps and on-call handoff.",
      kind: "Notion page",
      owner: "Diego Fernandez",
      updated: "Updated 5 days ago",
    },
    {
      title: "Deployment Metrics Dashboard – Q2 Summary",
      snippet_pre: "Tracked ",
      snippet_match: "deployment",
      snippet_post: " frequency, lead time, and change failure rate across all services.",
      kind: "Spreadsheet",
      owner: "Priya Nair",
      updated: "Updated 1 month ago",
    },
  ]

  people_results = []

  total_results = project_results.size + document_results.size + people_results.size
%>
<div class="mx-auto max-w-5xl px-6 py-10">
  <header class="mb-8">
    <form method="get" class="mb-6">
      <label for="global-search" class="sr-only">Search</label>
      <div class="relative">
        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" />
          <path d="M13.5 13.5 18 18" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          name="q"
          id="global-search"
          value="<%= search_query %>"
          class="w-full rounded-lg border border-gray-300 bg-white py-2.5 pl-10 pr-4 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"
        />
      </div>
    </form>

    <h1 class="text-xl font-semibold text-gray-900">
      Search results for &ldquo;<%= search_query %>&rdquo;
    </h1>
    <p class="mt-1 text-sm text-gray-500"><%= total_results %> results across <%= [project_results, document_results, people_results].size %> categories</p>

    <nav aria-label="Result categories" class="mt-6 flex gap-x-6 border-b border-gray-200">
      <a href="#projects-section" class="flex items-center gap-x-2 border-b-2 border-indigo-600 pb-3 text-sm font-medium text-indigo-600">
        Projects
        <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-600"><%= project_results.size %></span>
      </a>
      <a href="#documents-section" class="flex items-center gap-x-2 border-b-2 border-transparent pb-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700">
        Documents
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600"><%= document_results.size %></span>
      </a>
      <a href="#people-section" class="flex items-center gap-x-2 border-b-2 border-transparent pb-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700">
        People
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600"><%= people_results.size %></span>
      </a>
    </nav>
  </header>

  <div class="space-y-10">
    <section id="projects-section" aria-labelledby="projects-heading">
      <div class="mb-4 flex items-baseline gap-x-2">
        <h2 id="projects-heading" class="text-base font-semibold text-gray-900">Projects</h2>
        <span class="text-sm text-gray-500">(<%= project_results.size %>)</span>
      </div>

      <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
        <% project_results.each do |result| %>
          <li class="flex gap-x-4 p-4 hover:bg-gray-50">
            <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-indigo-50">
              <svg class="h-5 w-5 text-indigo-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h3.379a1.5 1.5 0 0 1 1.06.44l1.122 1.12a1.5 1.5 0 0 0 1.06.44H16a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 16 16H4a1.5 1.5 0 0 1-1.5-1.5v-9Z" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <a href="#" class="text-sm font-semibold text-gray-900 hover:text-indigo-600"><%= result[:title] %></a>
              <p class="mt-1 line-clamp-2 text-sm text-gray-600">
                <%= result[:snippet_pre] %><mark class="rounded-sm bg-yellow-200 px-0.5 text-gray-900"><%= result[:snippet_match] %></mark><%= result[:snippet_post] %>
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-x-2 text-xs text-gray-500">
                <span class="font-medium text-gray-600"><%= result[:team] %></span>
                <span aria-hidden="true">&middot;</span>
                <span><%= result[:updated] %></span>
                <span aria-hidden="true">&middot;</span>
                <span><%= result[:extra] %></span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <section id="documents-section" aria-labelledby="documents-heading">
      <div class="mb-4 flex items-baseline gap-x-2">
        <h2 id="documents-heading" class="text-base font-semibold text-gray-900">Documents</h2>
        <span class="text-sm text-gray-500">(<%= document_results.size %>)</span>
      </div>

      <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
        <% document_results.each do |result| %>
          <li class="flex gap-x-4 p-4 hover:bg-gray-50">
            <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-emerald-50">
              <svg class="h-5 w-5 text-emerald-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 3.5h6l3.5 3.5v9.5A1.5 1.5 0 0 1 13 18H5a1.5 1.5 0 0 1-1.5-1.5v-11.5A1.5 1.5 0 0 1 5 3.5Z" stroke-linejoin="round" />
                <path d="M11 3.5V7h3.5" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <a href="#" class="text-sm font-semibold text-gray-900 hover:text-indigo-600"><%= result[:title] %></a>
              <p class="mt-1 line-clamp-2 text-sm text-gray-600">
                <%= result[:snippet_pre] %><mark class="rounded-sm bg-yellow-200 px-0.5 text-gray-900"><%= result[:snippet_match] %></mark><%= result[:snippet_post] %>
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-x-2 text-xs text-gray-500">
                <span class="font-medium text-gray-600"><%= result[:kind] %></span>
                <span aria-hidden="true">&middot;</span>
                <span><%= result[:owner] %></span>
                <span aria-hidden="true">&middot;</span>
                <span><%= result[:updated] %></span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <section id="people-section" aria-labelledby="people-heading">
      <div class="mb-4 flex items-baseline gap-x-2">
        <h2 id="people-heading" class="text-base font-semibold text-gray-900">People</h2>
        <span class="text-sm text-gray-500">(<%= people_results.size %>)</span>
      </div>

      <% if people_results.empty? %>
        <div class="flex flex-col items-center rounded-lg border border-dashed border-gray-300 bg-gray-50 px-6 py-10 text-center">
          <svg class="h-8 w-8 text-gray-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="10" cy="6.5" r="3" />
            <path d="M3.5 17c0-3.038 2.91-5.5 6.5-5.5s6.5 2.462 6.5 5.5" stroke-linecap="round" />
          </svg>
          <p class="mt-3 text-sm font-medium text-gray-700">No people matched &ldquo;<%= search_query %>&rdquo;</p>
          <p class="mt-1 max-w-sm text-sm text-gray-500">People results match on name, title, or team. Try searching for a person&rsquo;s name instead, or check the Projects and Documents results above.</p>
        </div>
      <% else %>
        <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
          <% people_results.each do |result| %>
            <li class="flex gap-x-4 p-4 hover:bg-gray-50"></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</div>
