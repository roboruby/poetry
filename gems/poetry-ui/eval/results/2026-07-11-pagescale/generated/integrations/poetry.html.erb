            </span>
          <% end %>
          <% card.with_description { "Sync invoices and expenses with your books." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :receipt, class: "size-3.5 text-muted-foreground") %>
              </span>
