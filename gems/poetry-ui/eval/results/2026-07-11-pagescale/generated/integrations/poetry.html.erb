            </span>
          <% end %>
          <% card.with_description { "Automate workflows across thousands of apps." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :activity, class: "size-3.5 text-muted-foreground") %>
              </span>
              Datadog
            </span>
          <% end %>
          <% card.with_description { "Stream logs and metrics for observability." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :webhook, class: "size-3.5 text-muted-foreground") %>
              </span>
              Webhooks
            </span>
          <% end %>
          <% card.with_description { "Send custom HTTP callbacks on any event." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</div>
