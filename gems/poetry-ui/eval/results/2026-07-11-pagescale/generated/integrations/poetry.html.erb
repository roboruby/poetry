          <% card.with_description { "Automate subscription billing and dunning." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="space-y-3">
      <h3 class="text-sm font-medium text-muted-foreground">Productivity &amp; storage</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :folder, class: "size-3.5 text-muted-foreground") %>
              </span>
              Google Drive
            </span>
          <% end %>
          <% card.with_description { "Attach and sync files from shared drives." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :"file-text", class: "size-3.5 text-muted-foreground") %>
              </span>
              Notion
            </span>
          <% end %>
          <% card.with_description { "Push project updates into shared Notion docs." } %>
          <% card.with_footer do %>
            <div class="flex justify-end">
              <%= poetry_button(variant: :outline, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :plus) } %>
                Connect
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= poetry_card do |card| %>
          <% card.with_title do %>
            <span class="inline-flex items-center gap-2">
              <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted">
                <%= poetry_icon(name: :cloud, class: "size-3.5 text-muted-foreground") %>
