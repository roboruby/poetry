              <% end %>
              <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :default) { "Warning" } } %>
            <% end %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell(class: "text-muted-foreground tabular-nums") { "6:20 AM" } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">System</div>
