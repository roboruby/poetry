                <div>Chicago, US</div>
                <div class="text-xs tabular-nums">203.0.113.12</div>
              <% end %>
              <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :outline) { "Info" } } %>
            <% end %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell(class: "text-muted-foreground tabular-nums") { "8:03 AM" } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">Unknown</div>
                <div class="text-xs text-muted-foreground">unauthenticated</div>
              <% end %>
              <%= poetry_table_cell { "5 failed sign-in attempts for priya@northwind.io" } %>
              <%= poetry_table_cell(class: "text-muted-foreground") do %>
                <div>Kyiv, UA</div>
                <div class="text-xs tabular-nums">45.83.12.190</div>
              <% end %>
              <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :default) { "Warning" } } %>
            <% end %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell(class: "text-muted-foreground tabular-nums") { "7:51 AM" } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">Priya Natarajan</div>
                <div class="text-xs text-muted-foreground">priya@northwind.io</div>
              <% end %>
              <%= poetry_table_cell { "Created API key \"ci-deploy\"" } %>
              <%= poetry_table_cell(class: "text-muted-foreground") do %>
                <div>Toronto, CA</div>
