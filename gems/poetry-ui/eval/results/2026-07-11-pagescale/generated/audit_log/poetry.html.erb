              <% end %>
              <%= poetry_table_cell { "Nightly workspace backup completed" } %>
              <%= poetry_table_cell(class: "text-muted-foreground") { "—" } %>
              <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :outline) { "Info" } } %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

