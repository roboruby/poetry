  </div>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-muted-foreground">Showing 12 of 214 events</p>
    <%= poetry_pagination(current: 1, total: 18, current_variant: :filled, path: ->(page) { "?page=#{page}" }) %>
  </div>
</section>
