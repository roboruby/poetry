<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
      <p class="max-w-2xl text-sm text-muted-foreground">Security-relevant activity across the Northwind workspace — who did what, when, and from where.</p>
    </div>
    <%= poetry_dropdown_menu(align: :end) do |menu| %>
      <% menu.with_trigger(variant: :outline) do %>
        <%= poetry_icon(name: :download) %> Export
      <% end %>
      <% menu.with_item(href: "?format=csv") { "Export as CSV" } %>
      <% menu.with_item(href: "?format=json") { "Export as JSON" } %>
    <% end %>
  </div>

  <%= form_tag "", method: :get, class: "flex flex-wrap items-end gap-3 rounded-lg border bg-muted/30 p-4" do %>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-search") { "Search" } %>
      <%= poetry_input_group(class: "w-64") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :search) %>
        <% end %>
        <%= poetry_input_group_input(id: "audit-search", name: "q", placeholder: "Actor, event, or IP address…") %>
      <% end %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-severity") { "Severity" } %>
      <%= poetry_native_select(id: "audit-severity", name: "severity",
            options: [["All severities", "all"], ["Critical", "critical"], ["Warning", "warning"], ["Info", "info"]]) %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-event-type") { "Event type" } %>
      <%= poetry_native_select(id: "audit-event-type", name: "event_type",
            options: [["All events", "all"], ["Authentication", "authentication"], ["Permissions", "permissions"],
                      ["Data export", "data_export"], ["Workspace settings", "settings"]]) %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-actor") { "Actor" } %>
      <%= poetry_native_select(id: "audit-actor", name: "actor",
            options: [["Everyone", "all"], ["Priya Natarajan", "priya"], ["Jordan Blake", "jordan"],
                      ["Morgan Ellis", "morgan"], ["Casey Ruiz", "casey"], ["System", "system"]]) %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-from") { "From" } %>
      <%= poetry_input(type: "date", id: "audit-from", name: "from") %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-to") { "To" } %>
      <%= poetry_input(type: "date", id: "audit-to", name: "to") %>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <%= poetry_button(type: :submit) { "Filter" } %>
      <%= poetry_button(variant: :ghost, type: :reset) { "Reset" } %>
    </div>
  <% end %>

  <div class="space-y-8">
    <div class="space-y-3">
      <%= poetry_marker(variant: :separator, tag: :h2) { "Today — July 11, 2026" } %>
      <div class="overflow-hidden rounded-lg border">
        <%= poetry_table do %>
          <%= poetry_table_caption(class: "sr-only") { "Security events on July 11, 2026." } %>
          <%= poetry_table_header do %>
            <%= poetry_table_row do %>
              <%= poetry_table_head(class: "w-24") { "Time" } %>
              <%= poetry_table_head { "Actor" } %>
              <%= poetry_table_head { "Event" } %>
              <%= poetry_table_head { "Location" } %>
              <%= poetry_table_head(class: "text-right") { "Severity" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell(class: "text-muted-foreground tabular-nums") { "9:42 AM" } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">Priya Natarajan</div>
                <div class="text-xs text-muted-foreground">priya@northwind.io</div>
              <% end %>
              <%= poetry_table_cell { "Granted admin role to Jordan Blake" } %>
              <%= poetry_table_cell(class: "text-muted-foreground") do %>
                <div>Toronto, CA</div>
                <div class="text-xs tabular-nums">198.51.100.24</div>
              <% end %>
              <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :destructive) { "Critical" } } %>
            <% end %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell(class: "text-muted-foreground tabular-nums") { "9:15 AM" } %>
              <%= poetry_table_cell do %>
