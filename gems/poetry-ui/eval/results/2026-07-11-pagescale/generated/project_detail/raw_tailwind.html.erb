<%
  project = {
    name: "Harbor Point Redesign",
    status: "In Progress",
    description: "Full redesign of the Harbor Point client portal, covering new information architecture, a refreshed visual system, and a rebuilt onboarding flow ahead of the Q4 client rollout.",
    owner: { name: "Priya Nakamura", initials: "PN", title: "Senior Product Manager" },
    created_on: Date.new(2026, 2, 3),
    start_date: Date.new(2026, 2, 10),
    due_date: Date.new(2026, 9, 30)
  }

  status_styles = {
    "In Progress" => "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200",
    "On Track"    => "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200",
    "At Risk"     => "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200",
    "Archived"    => "bg-gray-100 text-gray-600 ring-1 ring-inset ring-gray-200"
  }

  milestones = [
    { name: "Discovery & Research", date: Date.new(2026, 3, 1), status: "Complete" },
    { name: "Information Architecture Sign-off", date: Date.new(2026, 4, 18), status: "Complete" },
    { name: "Visual System v1", date: Date.new(2026, 7, 25), status: "In Progress" },
    { name: "Onboarding Flow Beta", date: Date.new(2026, 8, 29), status: "Upcoming" },
    { name: "Client Launch", date: Date.new(2026, 9, 30), status: "Upcoming" }
  ]

  milestone_styles = {
    "Complete"    => { dot: "bg-emerald-500", badge: "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200" },
    "In Progress" => { dot: "bg-blue-500 ring-4 ring-blue-100", badge: "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200" },
    "Upcoming"    => { dot: "bg-gray-300", badge: "bg-gray-100 text-gray-500 ring-1 ring-inset ring-gray-200" }
  }

  tasks = [
    { title: "Finalize component spacing tokens", assignee: "Priya Nakamura", initials: "PN", due_date: Date.new(2026, 7, 14), status: "In Progress" },
    { title: "Review onboarding copy with legal", assignee: "Marcus Webb", initials: "MW", due_date: Date.new(2026, 7, 16), status: "Not Started" },
    { title: "Ship updated nav to staging", assignee: "Elena Torres", initials: "ET", due_date: Date.new(2026, 7, 18), status: "In Progress" },
    { title: "Client walkthrough of dashboard v1", assignee: "Priya Nakamura", initials: "PN", due_date: Date.new(2026, 7, 22), status: "Not Started" },
    { title: "Accessibility audit of forms", assignee: "Dev Patel", initials: "DP", due_date: Date.new(2026, 7, 25), status: "Not Started" }
  ]

  task_status_styles = {
    "In Progress" => "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200",
    "Not Started" => "bg-gray-100 text-gray-500 ring-1 ring-inset ring-gray-200",
    "Done"        => "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200"
  }
%>

<main class="mx-auto max-w-5xl px-6 py-10">
  <!-- Header: name, status, description, actions -->
  <header class="border-b border-gray-200 pb-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-semibold tracking-tight text-gray-900"><%= project[:name] %></h1>
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_styles[project[:status]] %>">
            <%= project[:status] %>
          </span>
        </div>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-600"><%= project[:description] %></p>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <a href="#"
           class="inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
          <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M13.586 3.586a2 2 0 1 1 2.828 2.828l-8.5 8.5a2 2 0 0 1-.878.506l-3.106.888a.5.5 0 0 1-.618-.618l.888-3.106a2 2 0 0 1 .506-.878l8.5-8.5Z" />
          </svg>
          Edit
        </a>
        <details class="relative">
          <summary class="list-none inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-white px-3 py-2 text-sm font-medium text-red-600 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-red-50">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1.5a1 1 0 0 1-.5.866V15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6.366A1 1 0 0 1 3.5 5.5V4a1 1 0 0 1 .5-1Zm2 2.5V15a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V6.5H6Zm2 2a.5.5 0 0 1 1 0v5a.5.5 0 0 1-1 0v-5Zm3-.5a.5.5 0 0 0-.5.5v5a.5.5 0 0 0 1 0v-5a.5.5 0 0 0-.5-.5Z" clip-rule="evenodd" />
            </svg>
            Archive
          </summary>
          <div class="absolute right-0 z-10 mt-2 w-72 rounded-md border border-gray-200 bg-white p-4 shadow-lg">
            <p class="text-sm text-gray-700">Archiving hides this project from active views. It can be restored later from the archive list.</p>
            <form action="#" method="post" class="mt-3 flex justify-end gap-2">
              <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-500">
                Confirm archive
              </button>
            </form>
          </div>
        </details>
      </div>
    </div>
  </header>

  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <!-- Owner & key dates -->
    <section aria-labelledby="details-heading" class="lg:col-span-1">
      <h2 id="details-heading" class="text-sm font-semibold text-gray-900">Details</h2>
      <div class="mt-4 rounded-lg border border-gray-200 bg-white p-5">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
            <%= project[:owner][:initials] %>
          </span>
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-gray-900"><%= project[:owner][:name] %></p>
            <p class="truncate text-xs text-gray-500"><%= project[:owner][:title] %></p>
          </div>
        </div>

        <dl class="mt-5 space-y-3 border-t border-gray-100 pt-4">
          <div class="flex items-center justify-between">
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Created</dt>
            <dd class="text-sm text-gray-700"><%= project[:created_on].strftime("%b %-d, %Y") %></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Start date</dt>
            <dd class="text-sm text-gray-700"><%= project[:start_date].strftime("%b %-d, %Y") %></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Due date</dt>
            <dd class="text-sm text-gray-700"><%= project[:due_date].strftime("%b %-d, %Y") %></dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Milestone timeline -->
    <section aria-labelledby="milestones-heading" class="lg:col-span-2">
      <h2 id="milestones-heading" class="text-sm font-semibold text-gray-900">Milestone timeline</h2>
      <ol class="mt-4 rounded-lg border border-gray-200 bg-white p-5">
        <% milestones.each_with_index do |milestone, index| %>
          <li class="relative flex gap-4 pb-6 last:pb-0">
            <% unless index == milestones.length - 1 %>
              <span class="absolute left-[7px] top-3 h-full w-px bg-gray-200" aria-hidden="true"></span>
            <% end %>
            <span class="relative mt-1.5 h-3.5 w-3.5 shrink-0 rounded-full <%= milestone_styles[milestone[:status]][:dot] %>" aria-hidden="true"></span>
            <div class="flex min-w-0 flex-1 flex-wrap items-center justify-between gap-x-4 gap-y-1">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= milestone[:name] %></p>
                <p class="text-xs text-gray-500"><%= milestone[:date].strftime("%B %-d, %Y") %></p>
              </div>
              <span class="inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= milestone_styles[milestone[:status]][:badge] %>">
                <%= milestone[:status] %>
              </span>
            </div>
          </li>
        <% end %>
      </ol>
    </section>
  </div>

  <!-- Recent tasks -->
  <section aria-labelledby="tasks-heading" class="mt-8">
    <div class="flex items-center justify-between">
      <h2 id="tasks-heading" class="text-sm font-semibold text-gray-900">Recent tasks</h2>
      <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View all tasks</a>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Task</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Assignee</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Due date</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% tasks.each do |task| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= task[:title] %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gray-100 text-[10px] font-semibold text-gray-600">
                    <%= task[:initials] %>
                  </span>
                  <span class="text-sm text-gray-700"><%= task[:assignee] %></span>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= task[:due_date].strftime("%b %-d, %Y") %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= task_status_styles[task[:status]] %>">
                  <%= task[:status] %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
