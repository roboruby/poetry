<div class="mx-auto max-w-6xl space-y-8 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Settings", href: "/settings") %>
      <% crumb.with_item("Billing") %>
    <% end %>
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Billing</h1>
      <p class="text-sm text-muted-foreground">Manage the Acme workspace&rsquo;s plan, payment method, and invoice history.</p>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <%= poetry_card do |card| %>
        <% card.with_title { "Team plan" } %>
        <% card.with_description { "Billed monthly · renews August 11, 2026" } %>
        <% card.with_action do %>
          <%= poetry_badge(variant: :success) { "Active" } %>
        <% end %>
        <% card.with_footer do %>
          <div class="flex w-full flex-wrap items-center justify-between gap-4">
            <span class="text-xs text-muted-foreground">Next charge $199.00 on Aug 11, 2026</span>
            <div class="flex items-center gap-2">
              <%= poetry_button(variant: :ghost, size: :sm) { "Cancel plan" } %>
              <%= poetry_button(variant: :outline, size: :sm) { "Change plan" } %>
            </div>
          </div>
        <% end %>
        <div class="space-y-4">
          <p class="text-3xl font-semibold tracking-tight">$199<span class="text-sm font-normal text-muted-foreground">/month</span></p>
          <ul class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
            <li class="flex items-center gap-2">
              <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
              <span>Up to 25 seats</span>
            </li>
            <li class="flex items-center gap-2">
              <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
              <span>500 GB storage</span>
            </li>
            <li class="flex items-center gap-2">
              <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
              <span>100,000 API calls / month</span>
            </li>
            <li class="flex items-center gap-2">
              <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
              <span>Priority support</span>
            </li>
          </ul>
        </div>
      <% end %>
    </div>

    <%= poetry_card do |card| %>
      <% card.with_title { "Payment method" } %>
      <% card.with_description { "Default card for this workspace" } %>
      <% card.with_footer do %>
        <div class="w-full">
          <%= poetry_button(variant: :outline, size: :sm) { "Update payment method" } %>
        </div>
      <% end %>
      <div class="flex items-center gap-3">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted">
          <%= poetry_icon(name: :"credit-card", class: "size-5 text-muted-foreground", label: "Visa card") %>
        </span>
        <div class="space-y-0.5">
          <p class="text-sm font-medium">Visa ending in 4242</p>
          <p class="text-xs text-muted-foreground">Expires 08/2027</p>
        </div>
      </div>
    <% end %>
  </div>

  <%= poetry_card do |card| %>
    <% card.with_title { "Usage this period" } %>
    <% card.with_description { "Jul 1 – Jul 31, 2026" } %>
    <div class="grid gap-6 sm:grid-cols-2">
      <%= poetry_progress(label: "Seats — 18 of 25", value: 18, max: 25) %>
      <%= poetry_progress(label: "Storage — 340 GB of 500 GB", value: 340, max: 500) %>
      <%= poetry_progress(label: "API calls — 82,400 of 100,000", value: 82400, max: 100000) %>
      <%= poetry_progress(label: "Automation runs — 1,240 of 2,000", value: 1240, max: 2000) %>
    </div>
  <% end %>

  <section class="space-y-4">
    <div class="space-y-1">
      <h2 class="text-lg font-semibold tracking-tight">Invoice history</h2>
      <p class="text-sm text-muted-foreground">Past charges for this workspace, with downloadable receipts.</p>
    </div>
    <div class="overflow-hidden rounded-lg border">
      <%= poetry_table do %>
        <%= poetry_table_caption(class: "sr-only") { "Invoice history with date, amount, payment status, and receipt." } %>
        <%= poetry_table_header do %>
          <%= poetry_table_row do %>
            <%= poetry_table_head { "Invoice" } %>
            <%= poetry_table_head { "Date" } %>
            <%= poetry_table_head { "Status" } %>
            <%= poetry_table_head(class: "text-right") { "Amount" } %>
            <%= poetry_table_head(class: "text-right") { "Receipt" } %>
          <% end %>
        <% end %>
        <%= poetry_table_body do %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-2026-0007" } %>
            <%= poetry_table_cell { "Jul 1, 2026" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$199.00" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Download
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-2026-0006" } %>
            <%= poetry_table_cell { "Jun 1, 2026" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$199.00" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Download
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-2026-0005" } %>
            <%= poetry_table_cell { "May 1, 2026" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$199.00" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Download
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-2026-0004" } %>
            <%= poetry_table_cell { "Apr 1, 2026" } %>
            <%= poetry_table_cell { poetry_badge(variant: :warning) { "Pending" } } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$184.00" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, disabled: true, label: "Receipt not yet available") do %>
                <%= poetry_icon(name: :download) %>
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-2026-0003" } %>
            <%= poetry_table_cell { "Mar 1, 2026" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$184.00" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Download
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
