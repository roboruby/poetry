<%
  services = [
    { name: "API", description: "Core REST & GraphQL API", status: :operational },
    { name: "Web Dashboard", description: "app.example.com", status: :operational },
    { name: "Authentication", description: "Login, SSO & tokens", status: :operational },
    { name: "Payments API", description: "Billing & checkout", status: :degraded },
    { name: "Database", description: "Primary data store", status: :operational },
    { name: "Email Delivery", description: "Transactional email", status: :operational },
  ]

  status_meta = {
    operational: { label: "Operational",        dot: "bg-emerald-500", text: "text-emerald-700" },
    degraded:    { label: "Degraded Performance", dot: "bg-amber-500",   text: "text-amber-700" },
    outage:      { label: "Partial Outage",      dot: "bg-red-500",     text: "text-red-700" },
  }

  day_bar_class = {
    up: "bg-emerald-500",
    degraded: "bg-amber-400",
    down: "bg-red-500",
  }

  # Deterministically synthesize 90 days of history per service so the
  # page has a realistic-looking uptime bar without relying on a DB.
  service_history = services.each_with_object({}) do |svc, memo|
    memo[svc[:name]] = Array.new(90) { :up }
  end
  service_history["Email Delivery"][12] = :degraded
  service_history["Database"][47] = :degraded
  service_history["API"][73] = :degraded
  service_history["Payments API"][80] = :degraded
  service_history["Payments API"][88] = :degraded
  service_history["Payments API"][89] = :degraded

  uptime_pct = service_history.transform_values do |days|
    up = days.count { |d| d == :up }
    ((up.to_f / days.length) * 100).round(2)
  end

  overall_degraded = services.any? { |s| s[:status] != :operational }
  today = Date.current
%>
<main class="mx-auto max-w-5xl px-6 py-10 space-y-10">
  <header class="space-y-1">
    <h1 class="text-2xl font-semibold text-slate-900">Acme Cloud Status</h1>
    <p class="text-sm text-slate-500">Real-time status and uptime history for Acme Cloud services.</p>
  </header>

  <% if overall_degraded %>
    <div class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 px-5 py-4" role="status">
      <svg class="mt-0.5 h-6 w-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a1.5 1.5 0 0 0 1.3 2.25h17.76a1.5 1.5 0 0 0 1.3-2.25L13.71 3.86a1.5 1.5 0 0 0-2.42 0Z" />
      </svg>
      <div>
        <p class="font-medium text-amber-800">Degraded Performance</p>
        <p class="text-sm text-amber-700">Payments API is experiencing issues. See the active incident below for details and updates.</p>
      </div>
    </div>
  <% else %>
    <div class="flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-5 py-4" role="status">
      <svg class="mt-0.5 h-6 w-6 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <div>
        <p class="font-medium text-emerald-800">All Systems Operational</p>
        <p class="text-sm text-emerald-700">Everything is running smoothly.</p>
      </div>
    </div>
  <% end %>

  <section aria-labelledby="services-heading" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 id="services-heading" class="text-lg font-semibold text-slate-900">Service Status</h2>
      <ul class="flex items-center gap-4 text-xs text-slate-500">
        <li class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Operational</li>
        <li class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Degraded</li>
        <li class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-red-500"></span>Outage</li>
      </ul>
    </div>

    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% services.each do |svc| %>
        <% meta = status_meta[svc[:status]] %>
        <li class="p-5 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-medium text-slate-900"><%= svc[:name] %></p>
              <p class="text-sm text-slate-500"><%= svc[:description] %></p>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium <%= meta[:text] %>">
              <span class="h-2 w-2 rounded-full <%= meta[:dot] %>"></span>
              <%= meta[:label] %>
            </span>
          </div>

          <div>
            <div class="flex h-8 items-stretch gap-px" role="img" aria-label="<%= svc[:name] %> uptime for the last 90 days: <%= uptime_pct[svc[:name]] %>% uptime">
              <% service_history[svc[:name]].each_with_index do |day_status, i| %>
                <% day_date = today - (89 - i) %>
                <span
                  class="min-w-[2px] flex-1 rounded-[1px] <%= day_bar_class[day_status] %>"
                  title="<%= day_date.strftime("%b %-d, %Y") %>: <%= day_status == :up ? "Operational" : day_status == :degraded ? "Degraded Performance" : "Outage" %>"
                ></span>
              <% end %>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs text-slate-400">
              <span>90 days ago</span>
              <span class="font-medium text-slate-500"><%= uptime_pct[svc[:name]] %>% uptime</span>
              <span>Today</span>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section aria-labelledby="incident-heading" class="space-y-4">
    <h2 id="incident-heading" class="text-lg font-semibold text-slate-900">Active Incident</h2>

    <article class="rounded-lg border border-amber-200 bg-white">
      <header class="flex flex-wrap items-center justify-between gap-2 border-b border-amber-100 bg-amber-50 px-5 py-4 rounded-t-lg">
        <h3 class="font-medium text-slate-900">Elevated errors on Payments API</h3>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          Monitoring
        </span>
      </header>

      <div class="px-5 py-4 space-y-1 text-sm text-slate-500">
        <p>Affected: <span class="font-medium text-slate-700">Payments API</span></p>
        <p>Started <time datetime="2026-07-11T08:12:00Z">Jul 11, 2026, 08:12 UTC</time></p>
      </div>

      <ol class="space-y-5 border-t border-slate-100 px-5 py-5">
        <li class="relative pl-6">
          <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          <p class="text-sm font-medium text-slate-900">Monitoring</p>
          <time datetime="2026-07-11T10:45:00Z" class="text-xs text-slate-400">Jul 11, 2026, 10:45 UTC</time>
          <p class="mt-1 text-sm text-slate-600">A fix has been implemented and we are monitoring the results. Error rates have returned to near-normal levels.</p>
        </li>
        <li class="relative pl-6">
          <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-amber-500"></span>
          <p class="text-sm font-medium text-slate-900">Identified</p>
          <time datetime="2026-07-11T09:30:00Z" class="text-xs text-slate-400">Jul 11, 2026, 09:30 UTC</time>
          <p class="mt-1 text-sm text-slate-600">We've identified the cause as connection pool exhaustion on a downstream database and are deploying a fix.</p>
        </li>
        <li class="relative pl-6">
          <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-slate-400"></span>
          <p class="text-sm font-medium text-slate-900">Investigating</p>
          <time datetime="2026-07-11T08:12:00Z" class="text-xs text-slate-400">Jul 11, 2026, 08:12 UTC</time>
          <p class="mt-1 text-sm text-slate-600">We are investigating reports of elevated error rates and slow response times on the Payments API.</p>
        </li>
      </ol>
    </article>

    <details class="rounded-lg border border-slate-200 bg-white px-5 py-4">
      <summary class="cursor-pointer text-sm font-medium text-slate-700">Past incidents</summary>
      <ul class="mt-3 space-y-3 text-sm">
        <li class="flex items-center justify-between gap-2 border-t border-slate-100 pt-3">
          <span class="text-slate-700">Email delivery delays</span>
          <span class="flex items-center gap-2 text-xs text-slate-400">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600">Resolved</span>
            <time datetime="2026-06-29">Jun 29, 2026</time>
          </span>
        </li>
        <li class="flex items-center justify-between gap-2 border-t border-slate-100 pt-3">
          <span class="text-slate-700">Elevated database latency</span>
          <span class="flex items-center gap-2 text-xs text-slate-400">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600">Resolved</span>
            <time datetime="2026-05-25">May 25, 2026</time>
          </span>
        </li>
      </ul>
    </details>
  </section>

  <section aria-labelledby="subscribe-heading" class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 id="subscribe-heading" class="text-lg font-semibold text-slate-900">Subscribe to updates</h2>
    <p class="mt-1 text-sm text-slate-500">Get an email whenever we post, update, or resolve an incident.</p>

    <form action="#" method="post" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start">
      <div class="flex-1">
        <label for="subscriber_email" class="sr-only">Email address</label>
        <input
          type="email"
          name="subscriber[email]"
          id="subscriber_email"
          required
          placeholder="you@example.com"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200"
        >
      </div>
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2"
      >
        Subscribe
      </button>
    </form>
  </section>
</main>
