<div class="min-h-screen bg-slate-50 py-10">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">

    <header class="mb-8 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-900">Notification settings</h1>
        <p class="mt-1 text-sm text-slate-500">Manage how and when we contact you.</p>
      </div>

      <div>
        <input type="checkbox" id="bookmark-toggle" class="peer sr-only">
        <label
          for="bookmark-toggle"
          class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-slate-300 bg-white text-slate-400 shadow-sm transition hover:text-slate-600 peer-checked:border-amber-300 peer-checked:bg-amber-50 peer-checked:text-amber-500 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-amber-400"
        >
          <span class="sr-only">Bookmark these settings</span>
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M6.32 2.577a49.255 49.255 0 0 1 11.36 0c1.497.174 2.57 1.46 2.57 2.93V21a.75.75 0 0 1-1.085.67L12 18.089l-7.165 3.583A.75.75 0 0 1 3.75 21V5.507c0-1.47 1.073-2.756 2.57-2.93Z" />
          </svg>
        </label>
      </div>
    </header>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <form action="#" method="post" class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-900">Email alerts</p>
          <p class="text-sm text-slate-500">Applies immediately — no separate save needed.</p>
        </div>
        <input type="hidden" name="email_alerts" value="1">
        <button
          type="submit"
          role="switch"
          aria-checked="false"
          aria-label="Toggle email alerts"
          class="relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full bg-slate-200 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
        >
          <span class="inline-block h-4 w-4 translate-x-1 transform rounded-full bg-white shadow transition-transform"></span>
        </button>
      </form>
    </section>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <fieldset>
        <legend class="text-sm font-medium text-slate-900">Layout</legend>
        <p class="mb-3 text-sm text-slate-500">Choose how notifications are displayed.</p>

        <div class="inline-flex rounded-lg border border-slate-200 p-1">
          <input type="radio" name="view_mode" id="view-list" value="list" checked class="peer/list sr-only">
          <label
            for="view-list"
            class="cursor-pointer rounded-md px-4 py-1.5 text-sm font-medium text-slate-600 transition peer-checked/list:bg-indigo-600 peer-checked/list:text-white peer-focus-visible/list:outline peer-focus-visible/list:outline-2 peer-focus-visible/list:outline-offset-2 peer-focus-visible/list:outline-indigo-500"
          >List</label>

          <input type="radio" name="view_mode" id="view-grid" value="grid" class="peer/grid sr-only">
          <label
            for="view-grid"
            class="cursor-pointer rounded-md px-4 py-1.5 text-sm font-medium text-slate-600 transition peer-checked/grid:bg-indigo-600 peer-checked/grid:text-white peer-focus-visible/grid:outline peer-focus-visible/grid:outline-2 peer-focus-visible/grid:outline-offset-2 peer-focus-visible/grid:outline-indigo-500"
          >Grid</label>
        </div>
      </fieldset>
    </section>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <form action="#" method="post">
        <label for="digest-frequency" class="block text-sm font-medium text-slate-900">Digest frequency</label>
        <p class="mt-1 text-sm text-slate-500">Choose a frequency, then submit to apply it.</p>
        <div class="mt-3 flex items-center gap-3">
          <select
            id="digest-frequency"
            name="digest_frequency"
            class="block w-full rounded-md border border-slate-300 bg-white py-2 pl-3 pr-8 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
            <option value="realtime">Real-time</option>
            <option value="daily" selected>Daily digest</option>
            <option value="weekly">Weekly digest</option>
            <option value="monthly">Monthly digest</option>
          </select>
          <button
            type="submit"
            class="inline-flex shrink-0 items-center rounded-md bg-indigo-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >Update</button>
        </div>
      </form>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <form action="#" method="post" class="space-y-6">
        <div>
          <h2 class="text-base font-semibold text-slate-900">Additional preferences</h2>
          <p class="text-sm text-slate-500">These changes are staged until you save.</p>
        </div>

        <div>
          <label for="alert-volume" class="block text-sm font-medium text-slate-900">Alert volume</label>
          <input
            type="range"
            id="alert-volume"
            name="alert_volume"
            min="0"
            max="10"
            step="1"
            value="6"
            list="alert-volume-ticks"
            class="mt-3 w-full accent-indigo-600"
          >
          <datalist id="alert-volume-ticks">
            <option value="0"></option>
            <option value="5"></option>
            <option value="10"></option>
          </datalist>
          <div class="mt-1 flex justify-between text-xs text-slate-400">
            <span>Silent</span>
            <span>Medium</span>
            <span>Loud</span>
          </div>
        </div>

        <div>
          <label for="unsubscribe-note" class="block text-sm font-medium text-slate-900">Unsubscribe note</label>
          <p class="text-sm text-slate-500">Optional — tell us why, in case we can fix it.</p>
          <textarea
            id="unsubscribe-note"
            name="unsubscribe_note"
            rows="3"
            placeholder="e.g. too many emails, wrong topic..."
            class="mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          ></textarea>
        </div>

        <div>
          <label for="confirmation-code" class="block text-sm font-medium text-slate-900">Confirmation code</label>
          <p class="text-sm text-slate-500">Enter the 6-digit code we sent to your email.</p>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            id="confirmation-code"
            name="confirmation_code"
            placeholder="000000"
            class="mt-2 block w-40 rounded-md border border-slate-300 px-3 py-2 text-center text-lg tracking-[0.5em] text-slate-900 shadow-sm placeholder:tracking-[0.5em] placeholder:text-slate-300 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
        </div>

        <div class="flex items-start gap-3 border-t border-slate-100 pt-6">
          <input type="checkbox" id="accept-terms" name="accept_terms" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
          <div>
            <label for="accept-terms" class="block text-sm font-medium text-slate-900">Accept terms</label>
            <p class="text-sm text-slate-500">I agree to the updated notification terms. This won't apply until you save.</p>
          </div>
        </div>

        <div class="flex justify-end border-t border-slate-100 pt-6">
          <button
            type="submit"
            class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >Save changes</button>
        </div>
      </form>
    </section>

  </div>
</div>
