<div class="mx-auto max-w-3xl px-6 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Account settings</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your profile, security, and notification preferences.</p>
  </div>

  <div class="group/tabs">
    <fieldset>
      <legend class="sr-only">Settings section</legend>

      <div class="flex gap-6 border-b border-gray-200">
        <label class="relative cursor-pointer pb-3">
          <input type="radio" name="settings-tab" id="settings-tab-account" class="peer sr-only" checked>
          <span class="text-sm font-medium text-gray-500 peer-checked:text-indigo-600">Account</span>
          <span class="absolute inset-x-0 -bottom-px h-0.5 bg-transparent peer-checked:bg-indigo-600"></span>
        </label>

        <label class="relative cursor-pointer pb-3">
          <input type="radio" name="settings-tab" id="settings-tab-password" class="peer sr-only">
          <span class="text-sm font-medium text-gray-500 peer-checked:text-indigo-600">Password</span>
          <span class="absolute inset-x-0 -bottom-px h-0.5 bg-transparent peer-checked:bg-indigo-600"></span>
        </label>

        <label class="relative cursor-pointer pb-3">
          <input type="radio" name="settings-tab" id="settings-tab-notifications" class="peer sr-only">
          <span class="text-sm font-medium text-gray-500 peer-checked:text-indigo-600">Notifications</span>
          <span class="absolute inset-x-0 -bottom-px h-0.5 bg-transparent peer-checked:bg-indigo-600"></span>
        </label>
      </div>
    </fieldset>

    <!-- Account panel -->
    <div id="account-panel" class="hidden group-has-[#settings-tab-account:checked]/tabs:block mt-6">
      <div class="rounded-lg border border-gray-200 bg-white p-6">
        <h2 class="text-base font-semibold text-gray-900">Profile</h2>
        <p class="mt-1 text-sm text-gray-500">This information will be displayed publicly, so be careful what you share.</p>

        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="account-first-name" class="block text-sm font-medium text-gray-700">First name</label>
            <input type="text" id="account-first-name" name="account[first_name]" value="Matt"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
          <div>
            <label for="account-last-name" class="block text-sm font-medium text-gray-700">Last name</label>
            <input type="text" id="account-last-name" name="account[last_name]" value="Solt"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
          <div>
            <label for="account-username" class="block text-sm font-medium text-gray-700">Username</label>
            <input type="text" id="account-username" name="account[username]" value="mattsolt"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
          <div>
            <label for="account-email" class="block text-sm font-medium text-gray-700">Email address</label>
            <input type="email" id="account-email" name="account[email]" value="mattsolt@gmail.com"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
          <div class="sm:col-span-2">
            <label for="account-bio" class="block text-sm font-medium text-gray-700">Bio</label>
            <textarea id="account-bio" name="account[bio]" rows="3"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
              placeholder="A short description about yourself"></textarea>
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6">
          <button type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Cancel</button>
          <button type="button" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">Save changes</button>
        </div>
      </div>
    </div>

    <!-- Password panel -->
    <div id="password-panel" class="hidden group-has-[#settings-tab-password:checked]/tabs:block mt-6">
      <div class="rounded-lg border border-gray-200 bg-white p-6">
        <h2 class="text-base font-semibold text-gray-900">Change password</h2>
        <p class="mt-1 text-sm text-gray-500">Update your password to keep your account secure.</p>

        <div class="mt-6 grid grid-cols-1 gap-6 sm:max-w-md">
          <div>
            <label for="password-current" class="block text-sm font-medium text-gray-700">Current password</label>
            <input type="password" id="password-current" name="password[current]" autocomplete="current-password"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
          <div>
            <label for="password-new" class="block text-sm font-medium text-gray-700">New password</label>
            <input type="password" id="password-new" name="password[new]" autocomplete="new-password"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <p class="mt-1 text-xs text-gray-500">Must be at least 8 characters.</p>
          </div>
          <div>
            <label for="password-confirm" class="block text-sm font-medium text-gray-700">Confirm new password</label>
            <input type="password" id="password-confirm" name="password[confirmation]" autocomplete="new-password"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6">
          <button type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Cancel</button>
          <button type="button" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">Update password</button>
        </div>
      </div>
    </div>

    <!-- Notifications panel -->
    <div id="notifications-panel" class="hidden group-has-[#settings-tab-notifications:checked]/tabs:block mt-6">
      <div class="rounded-lg border border-gray-200 bg-white p-6">
        <h2 class="text-base font-semibold text-gray-900">Notification preferences</h2>
        <p class="mt-1 text-sm text-gray-500">Choose how you want to be notified about activity on your account.</p>

        <div class="mt-6 divide-y divide-gray-100">
          <div class="flex items-start justify-between gap-4 py-4">
            <div>
              <label for="notify-email" class="block text-sm font-medium text-gray-900">Email notifications</label>
              <p class="text-sm text-gray-500">Receive account activity updates by email.</p>
            </div>
            <input type="checkbox" id="notify-email" name="notifications[email]" checked
              class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
          </div>
          <div class="flex items-start justify-between gap-4 py-4">
            <div>
              <label for="notify-push" class="block text-sm font-medium text-gray-900">Push notifications</label>
              <p class="text-sm text-gray-500">Get a push notification on your devices.</p>
            </div>
            <input type="checkbox" id="notify-push" name="notifications[push]"
              class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
          </div>
          <div class="flex items-start justify-between gap-4 py-4">
            <div>
              <label for="notify-digest" class="block text-sm font-medium text-gray-900">Weekly digest</label>
              <p class="text-sm text-gray-500">A summary of your account activity, sent every Monday.</p>
            </div>
            <input type="checkbox" id="notify-digest" name="notifications[digest]" checked
              class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
          </div>
          <div class="flex items-start justify-between gap-4 py-4">
            <div>
              <label for="notify-marketing" class="block text-sm font-medium text-gray-900">Product updates</label>
              <p class="text-sm text-gray-500">News about new features and product announcements.</p>
            </div>
            <input type="checkbox" id="notify-marketing" name="notifications[marketing]"
              class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
          </div>
        </div>

        <div class="mt-2 flex justify-end gap-3 border-t border-gray-100 pt-6">
          <button type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Cancel</button>
          <button type="button" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">Save preferences</button>
        </div>
      </div>
    </div>
  </div>
</div>
