<section class="mx-auto max-w-xl p-6">
  <%= poetry_alert(variant: :destructive) do |alert| %>
    <% alert.with_icon(name: "triangle-alert") %>
    <% alert.with_title { "Payment failed" } %>
    <p>We couldn't charge your card on file. Update your payment method to avoid an interruption to your subscription.</p>
  <% end %>
</section>
