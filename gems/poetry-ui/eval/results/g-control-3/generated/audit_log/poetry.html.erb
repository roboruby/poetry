<div class="mx-auto max-w-6xl space-y-6 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Acme Manufacturing", href: "/") %>
      <% crumb.with_item("Security", href: "/security") %>
      <% crumb.with_item("Audit log") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
        <p class="text-sm text-muted-foreground">Security-relevant activity across every member, service account, and integration in this workspace.</p>
      </div>
      <%= poetry_button(variant: :outline, tag: :a, href: "?format=csv") do |button| %>
        <% button.with_leading { poetry_icon(name: :download) } %>
        Export
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

  <form method="get" action="?" class="space-y-3 rounded-lg border bg-muted/30 p-4">
    <div class="flex flex-wrap items-end gap-3">
      <div class="flex min-w-64 flex-1 flex-col gap-1.5">
        <%= poetry_label(for_id: "audit-search", class: "sr-only") { "Search the audit log" } %>
        <%= poetry_input_group do %>
          <%= poetry_input_group_addon do %>
            <%= poetry_icon(name: :search) %>
          <% end %>
          <%= poetry_input_group_input(id: "audit-search", name: "q", placeholder: "Search by member, action, or IP address…") %>
        <% end %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= poetry_label(for_id: "audit-severity") { "Severity" } %>
        <%= poetry_native_select(name: "severity", id: "audit-severity",
                                 options: [["All severities", "all"], ["Critical", "critical"],
                                           ["Elevated", "elevated"], ["Info", "info"]]) %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= poetry_label(for_id: "audit-category") { "Event type" } %>
        <%= poetry_native_select(name: "category", id: "audit-category",
                                 options: [["All event types", "all"], ["Authentication", "authentication"],
                                           ["Permissions", "permissions"], ["Data export", "data_export"],
                                           ["Integrations", "integrations"], ["Billing", "billing"]]) %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= poetry_label(for_id: "audit-from") { "From" } %>
        <%= poetry_date_field(name: "from", id: "audit-from") %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= poetry_label(for_id: "audit-to") { "To" } %>
        <%= poetry_date_field(name: "to", id: "audit-to") %>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <%= poetry_button(variant: :ghost, tag: :a, href: "?") { "Reset" } %>
        <%= poetry_button(type: :submit) do |button| %>
          <% button.with_leading { poetry_icon(name: :"list-filter") } %>
          Apply filters
        <% end %>
      </div>
    </div>
  </form>

  <div class="space-y-8">
    <section class="space-y-3">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sm font-semibold tracking-tight">Today &middot; July 22, 2026</h2>
        <p class="text-sm text-muted-foreground">5 events</p>
      </div>
      <div class="overflow-hidden rounded-lg border">
        <%= poetry_item_group do %>
          <%= poetry_item(role: "listitem", media_variant: :image) do |item| %>
            <% item.with_media { poetry_avatar(label: "Priya Nair", size: :sm) { "PN" } } %>
