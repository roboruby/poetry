<%
  severity_meta = {
    "critical" => { label: "Critical", text: "text-red-700",   bg: "bg-red-50",    ring: "ring-red-600/20",   dot: "bg-red-600" },
    "warning"  => { label: "Warning",  text: "text-amber-800", bg: "bg-amber-50",  ring: "ring-amber-600/20", dot: "bg-amber-500" },
    "info"     => { label: "Info",     text: "text-slate-600", bg: "bg-slate-100", ring: "ring-slate-500/10", dot: "bg-slate-400" },
  }

  actor_colors = {
    "PN" => "bg-indigo-600",
    "MW" => "bg-rose-600",
    "DC" => "bg-emerald-600",
    "EF" => "bg-sky-600",
    "JB" => "bg-violet-600",
    "SY" => "bg-slate-500",
    "??" => "bg-slate-300",
  }

  day_groups = [
    {
      label: "Today",
      date: "July 22, 2026",
      events: [
        { time: "9:42 AM", actor: "Priya Nair", initials: "PN", action: "Signed in", detail: "Authenticated via SSO (Okta)", resource: nil, ip: "203.0.113.42", location: "Bengaluru, IN", severity: "info", event_id: "evt_9f2a1c", session_id: "sess_8f2ac1de", agent: "Chrome 126 on macOS" },
        { time: "9:15 AM", actor: "Marcus Webb", initials: "MW", action: "Failed sign-in attempt", detail: "Incorrect password (3rd consecutive attempt)", resource: nil, ip: "198.51.100.7", location: "Kyiv, UA", severity: "critical", event_id: "evt_7b30dd", session_id: "—", agent: "Firefox 128 on Windows" },
        { time: "8:58 AM", actor: "System", initials: "SY", action: "API key created", detail: "Key “ci-deploy-prod” created with write access", resource: "API keys", ip: "10.0.4.18", location: "Internal network", severity: "warning", event_id: "evt_44a1e9", session_id: "sess_2210cbaa", agent: "api.acme.dev/v1" },
        { time: "8:20 AM", actor: "Dana Cole", initials: "DC", action: "Removed member", detail: "Removed jordan@acme.dev from the workspace", resource: "Members", ip: "172.16.5.90", location: "Austin, US", severity: "warning", event_id: "evt_c810f2", session_id: "sess_119ab420", agent: "Safari 17 on macOS" },
      ],
    },
    {
      label: "Yesterday",
      date: "July 21, 2026",
      events: [
        { time: "6:47 PM", actor: "Priya Nair", initials: "PN", action: "Changed member role", detail: "Marcus Webb: Member → Admin", resource: "Members", ip: "203.0.113.42", location: "Bengaluru, IN", severity: "warning", event_id: "evt_a6612b", session_id: "sess_8f2ac1de", agent: "Chrome 126 on macOS" },
        { time: "4:03 PM", actor: "Elena Fischer", initials: "EF", action: "Enabled two-factor authentication", detail: nil, resource: "Account security", ip: "91.203.6.14", location: "Berlin, DE", severity: "info", event_id: "evt_5e01aa", session_id: "sess_6a41ffc2", agent: "Chrome 126 on Windows" },
        { time: "2:31 PM", actor: "System", initials: "SY", action: "Data export completed", detail: "Full customer dataset exported (CSV, 128 MB)", resource: "Exports", ip: "172.16.5.90", location: "Austin, US", severity: "critical", event_id: "evt_bb2210", session_id: "sess_119ab420", agent: "api.acme.dev/v1" },
        { time: "11:12 AM", actor: "Jordan Blake", initials: "JB", action: "Revoked API key", detail: "Key “legacy-webhook” revoked", resource: "API keys", ip: "203.0.113.75", location: "Toronto, CA", severity: "info", event_id: "evt_2f90c4", session_id: "sess_7712edaa", agent: "Firefox 128 on macOS" },
      ],
    },
    {
      label: "Monday",
      date: "July 20, 2026",
      events: [
        { time: "5:58 PM", actor: "Marcus Webb", initials: "MW", action: "Deleted project", detail: "Deleted project “staging-sandbox”", resource: "Projects", ip: "198.51.100.7", location: "Kyiv, UA", severity: "critical", event_id: "evt_004c9a", session_id: "sess_44e0aa10", agent: "Firefox 128 on Windows" },
        { time: "3:20 PM", actor: "Dana Cole", initials: "DC", action: "Updated billing details", detail: "Payment method changed", resource: "Billing", ip: "172.16.5.90", location: "Austin, US", severity: "warning", event_id: "evt_bf1123", session_id: "sess_119ab420", agent: "Safari 17 on macOS" },
        { time: "1:05 PM", actor: "Priya Nair", initials: "PN", action: "Invited member", detail: "Invited sam.diaz@acme.dev as Member", resource: "Members", ip: "203.0.113.42", location: "Bengaluru, IN", severity: "info", event_id: "evt_77aa02", session_id: "sess_8f2ac1de", agent: "Chrome 126 on macOS" },
        { time: "10:44 AM", actor: "System", initials: "SY", action: "Integration connected", detail: "Connected Slack workspace “acme-eng”", resource: "Integrations", ip: "10.0.4.18", location: "Internal network", severity: "info", event_id: "evt_119900", session_id: "sess_2210cbaa", agent: "api.acme.dev/v1" },
        { time: "9:02 AM", actor: "Unknown", initials: "??", action: "Failed sign-in attempt", detail: "5 consecutive failures — IP auto-blocked", resource: nil, ip: "45.83.12.201", location: "Unknown (Tor exit node)", severity: "critical", event_id: "evt_ff2e77", session_id: "—", agent: "curl/8.4.0" },
      ],
    },
    {
      label: "Friday",
      date: "July 17, 2026",
      events: [
        { time: "4:40 PM", actor: "Elena Fischer", initials: "EF", action: "Changed password", detail: nil, resource: "Account security", ip: "91.203.6.14", location: "Berlin, DE", severity: "info", event_id: "evt_301faa", session_id: "sess_6a41ffc2", agent: "Chrome 126 on Windows" },
        { time: "2:12 PM", actor: "Jordan Blake", initials: "JB", action: "Downloaded audit log export", detail: nil, resource: "Exports", ip: "203.0.113.75", location: "Toronto, CA", severity: "warning", event_id: "evt_60cc21", session_id: "sess_7712edaa", agent: "Firefox 128 on macOS" },
        { time: "11:30 AM", actor: "Dana Cole", initials: "DC", action: "Updated security policy", detail: "Enforced SSO-only sign-in for all members", resource: "Security settings", ip: "172.16.5.90", location: "Austin, US", severity: "warning", event_id: "evt_8810bc", session_id: "sess_119ab420", agent: "Safari 17 on macOS" },
        { time: "9:00 AM", actor: "Priya Nair", initials: "PN", action: "Signed in", detail: "Authenticated via SSO (Okta)", resource: nil, ip: "203.0.113.42", location: "Bengaluru, IN", severity: "info", event_id: "evt_00d1ef", session_id: "sess_8f2ac1de", agent: "Chrome 126 on macOS" },
      ],
    },
  ]

  total_events = day_groups.sum { |g| g[:events].size }
  critical_count = day_groups.sum { |g| g[:events].count { |e| e[:severity] == "critical" } }
  warning_count = day_groups.sum { |g| g[:events].count { |e| e[:severity] == "warning" } }
  unique_actors = day_groups.flat_map { |g| g[:events].map { |e| e[:actor] } }.uniq.count
%>
<div class="min-h-full bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">

    <!-- Header -->
    <div class="sm:flex sm:items-end sm:justify-between">
      <div>
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-slate-500">
          <span>Acme Robotics</span>
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-slate-300"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
          <span class="text-slate-700">Settings</span>
        </nav>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Audit log</h1>
        <p class="mt-1 max-w-2xl text-sm text-slate-600">Security-relevant activity across this workspace — who did what, when, and from where.</p>
      </div>

      <div class="mt-4 sm:mt-0">
        <details class="group relative inline-block text-left">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v7.19l2.22-2.22a.75.75 0 111.06 1.06l-3.5 3.5a.75.75 0 01-1.06 0l-3.5-3.5a.75.75 0 111.06-1.06l2.22 2.22V3.75A.75.75 0 0110 3zM3.5 13.75a.75.75 0 01.75.75v.5a1 1 0 001 1h9.5a1 1 0 001-1v-.5a.75.75 0 011.5 0v.5a2.5 2.5 0 01-2.5 2.5h-9.5A2.5 2.5 0 013.25 15v-.5a.75.75 0 01.75-.75z" clip-rule="evenodd" /></svg>
            Export
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-slate-300 transition-transform group-open:rotate-180"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-60 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-slate-900/10">
            <a href="#" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Export visible events as CSV</a>
            <a href="#" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Export visible events as JSON</a>
            <a href="#" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Export full report (PDF)</a>
          </div>
        </details>
      </div>
    </div>

    <!-- Stat tiles -->
    <dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <dt class="text-xs font-medium text-slate-500">Events shown</dt>
        <dd class="mt-1 text-2xl font-semibold text-slate-900"><%= total_events %></dd>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <dt class="text-xs font-medium text-slate-500">Critical</dt>
        <dd class="mt-1 flex items-center gap-1.5 text-2xl font-semibold text-red-700">
          <span class="h-2 w-2 rounded-full bg-red-600"></span>
          <%= critical_count %>
        </dd>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <dt class="text-xs font-medium text-slate-500">Warnings</dt>
        <dd class="mt-1 flex items-center gap-1.5 text-2xl font-semibold text-amber-800">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          <%= warning_count %>
        </dd>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <dt class="text-xs font-medium text-slate-500">Unique actors</dt>
        <dd class="mt-1 text-2xl font-semibold text-slate-900"><%= unique_actors %></dd>
      </div>
    </dl>

    <!-- Filters -->
    <form method="get" action="#" class="mt-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <label for="q" class="block text-xs font-medium text-slate-700">Search</label>
          <div class="relative mt-1">
            <svg viewBox="0 0 20 20" fill="currentColor" class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" /></svg>
            <input type="text" name="q" id="q" placeholder="Actor, action, or resource" class="block w-full rounded-md border-0 py-1.5 pl-8 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-slate-900">
          </div>
        </div>

        <div class="lg:col-span-2">
          <label for="event_type" class="block text-xs font-medium text-slate-700">Event type</label>
          <select id="event_type" name="event_type" class="mt-1 block w-full rounded-md border-0 py-1.5 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-slate-900">
            <option>All types</option>
            <option>Authentication</option>
            <option>Access &amp; permissions</option>
            <option>Data exports</option>
            <option>Billing</option>
            <option>Integrations</option>
            <option>Security settings</option>
          </select>
        </div>

        <div class="lg:col-span-2">
          <label for="actor" class="block text-xs font-medium text-slate-700">Actor</label>
          <select id="actor" name="actor" class="mt-1 block w-full rounded-md border-0 py-1.5 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-slate-900">
            <option>All members</option>
            <option>Priya Nair</option>
            <option>Marcus Webb</option>
            <option>Dana Cole</option>
            <option>Elena Fischer</option>
            <option>Jordan Blake</option>
            <option>System</option>
          </select>
        </div>

        <div class="lg:col-span-2">
          <label for="range" class="block text-xs font-medium text-slate-700">Date range</label>
          <select id="range" name="range" class="mt-1 block w-full rounded-md border-0 py-1.5 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-slate-900">
            <option>Last 24 hours</option>
            <option selected>Last 7 days</option>
            <option>Last 30 days</option>
            <option>Custom range…</option>
          </select>
        </div>

        <div class="lg:col-span-2">
          <span class="block text-xs font-medium text-slate-700">Severity</span>
          <div class="mt-1 flex flex-wrap gap-1.5">
            <label class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 has-[:checked]:border-red-600 has-[:checked]:bg-red-50 has-[:checked]:text-red-700">
              <input type="checkbox" name="severity[]" value="critical" class="sr-only" checked>
              Critical
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:text-amber-800">
              <input type="checkbox" name="severity[]" value="warning" class="sr-only" checked>
              Warning
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-700 has-[:checked]:border-slate-400 has-[:checked]:bg-slate-100 has-[:checked]:text-slate-700">
              <input type="checkbox" name="severity[]" value="info" class="sr-only" checked>
              Info
            </label>
          </div>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span>Active filters:</span>
          <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 font-medium text-slate-700">Last 7 days</span>
          <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 font-medium text-slate-700">All severities</span>
        </div>
        <div class="flex items-center gap-3">
          <button type="reset" class="text-sm font-medium text-slate-600 hover:text-slate-900">Clear filters</button>
          <button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-700">Apply filters</button>
        </div>
      </div>
    </form>

    <p class="mt-6 text-sm text-slate-500">Showing <span class="font-medium text-slate-700"><%= total_events %></span> of 428 events</p>

    <!-- Day groups -->
    <div class="mt-3 space-y-8">
      <% day_groups.each_with_index do |day, day_index| %>
        <% heading_id = "day-heading-#{day_index}" %>
        <section aria-labelledby="<%= heading_id %>">
          <div class="flex items-baseline gap-2 px-1">
            <h2 id="<%= heading_id %>" class="text-sm font-semibold text-slate-900"><%= day[:label] %></h2>
            <span class="text-sm text-slate-400"><%= day[:date] %></span>
            <span class="ml-auto text-xs text-slate-500"><%= day[:events].size %> event<%= day[:events].size == 1 ? "" : "s" %></span>
          </div>

          <div class="mt-2 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-slate-100" aria-labelledby="<%= heading_id %>">
              <thead>
                <tr class="text-left text-xs font-medium text-slate-500">
                  <th scope="col" class="py-2 pl-4 pr-2">Time</th>
                  <th scope="col" class="px-2 py-2">Actor</th>
                  <th scope="col" class="px-2 py-2">Event</th>
                  <th scope="col" class="px-2 py-2">Resource</th>
                  <th scope="col" class="px-2 py-2">Location</th>
                  <th scope="col" class="px-2 py-2">Severity</th>
                  <th scope="col" class="py-2 pl-2 pr-4"><span class="sr-only">Details</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% day[:events].each do |event| %>
                  <% m = severity_meta[event[:severity]] %>
                  <tr class="align-top">
                    <td class="whitespace-nowrap py-3 pl-4 pr-2 text-sm tabular-nums text-slate-500"><%= event[:time] %></td>
                    <td class="px-2 py-3">
                      <div class="flex items-center gap-2">
                        <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full <%= actor_colors.fetch(event[:initials], "bg-slate-400") %> text-xs font-semibold text-white">
                          <%= event[:initials] %>
                        </span>
                        <span class="text-sm font-medium <%= event[:actor] == "Unknown" ? "italic text-slate-400" : "text-slate-900" %>"><%= event[:actor] %></span>
                      </div>
                    </td>
                    <td class="px-2 py-3">
                      <p class="text-sm font-medium text-slate-900"><%= event[:action] %></p>
                      <% if event[:detail] %>
                        <p class="mt-0.5 max-w-sm text-sm text-slate-500"><%= event[:detail] %></p>
                      <% end %>
                    </td>
                    <td class="px-2 py-3 text-sm text-slate-600"><%= event[:resource] || "—" %></td>
                    <td class="px-2 py-3">
                      <p class="text-sm text-slate-600"><%= event[:location] %></p>
                      <p class="text-xs tabular-nums text-slate-400"><%= event[:ip] %></p>
                    </td>
                    <td class="px-2 py-3">
                      <span class="inline-flex items-center gap-1.5 rounded-full <%= m[:bg] %> px-2 py-1 text-xs font-medium <%= m[:text] %> ring-1 ring-inset <%= m[:ring] %>">
                        <span class="h-1.5 w-1.5 flex-none rounded-full <%= m[:dot] %>"></span>
                        <%= m[:label] %>
                      </span>
                    </td>
                    <td class="py-3 pl-2 pr-4 text-right">
                      <details class="group">
                        <summary class="inline-flex cursor-pointer list-none items-center gap-1 rounded px-2 py-1 text-xs font-medium text-slate-500 hover:bg-slate-50 hover:text-slate-900">
                          Details
                          <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform group-open:rotate-180"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
                        </summary>
                        <dl class="mt-2 w-64 rounded-md bg-slate-50 p-3 text-left text-xs text-slate-600 ring-1 ring-inset ring-slate-200">
                          <div class="flex justify-between gap-3 py-0.5">
                            <dt class="text-slate-400">Event ID</dt>
                            <dd class="truncate font-mono text-slate-700"><%= event[:event_id] %></dd>
                          </div>
                          <div class="flex justify-between gap-3 py-0.5">
                            <dt class="text-slate-400">Session</dt>
                            <dd class="truncate font-mono text-slate-700"><%= event[:session_id] %></dd>
                          </div>
                          <div class="flex justify-between gap-3 py-0.5">
                            <dt class="flex-none text-slate-400">Client</dt>
                            <dd class="text-right text-slate-700"><%= event[:agent] %></dd>
                          </div>
                        </dl>
                      </details>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6">
      <p class="text-sm text-slate-500">Showing <%= total_events %> of 428 events</p>
      <nav class="flex gap-2" aria-label="Pagination">
        <span aria-disabled="true" class="pointer-events-none rounded-md border border-slate-200 px-3 py-1.5 text-sm text-slate-300">Previous</span>
        <a href="#" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">Next</a>
      </nav>
    </div>

  </div>
</div>
