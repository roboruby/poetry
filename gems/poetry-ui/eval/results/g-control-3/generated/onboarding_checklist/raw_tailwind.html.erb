<main class="min-h-full bg-slate-50 px-6 py-16 sm:px-8">
  <section class="mx-auto w-full max-w-3xl" aria-labelledby="onboarding-heading">
    <header class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Workspace created</p>
      <h1 id="onboarding-heading" class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Welcome aboard &mdash; let&rsquo;s get your workspace ready
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-base text-slate-600">
        A few quick steps and your team will be up and running. You can always finish these later from your
        workspace settings.
      </p>
    </header>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between gap-4 border-b border-slate-200 px-6 py-4 sm:px-8">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Setup checklist</h2>
          <p class="text-sm text-slate-500">0 of 3 steps complete</p>
        </div>
        <div class="flex items-center gap-3">
          <div
            class="h-2 w-28 overflow-hidden rounded-full bg-slate-200"
            role="progressbar"
            aria-label="Setup progress"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="3"
          >
            <div class="h-full w-0 rounded-full bg-indigo-600"></div>
          </div>
        </div>
      </div>

      <ol class="divide-y divide-slate-200">
        <li class="flex items-start gap-4 px-6 py-5 sm:px-8">
          <span
            class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-full border-2 border-indigo-600 text-sm font-semibold text-indigo-600"
            aria-hidden="true"
          >
            1
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-900">Connect a repository</h3>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                Not started
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600">
              Link your GitHub, GitLab, or Bitbucket repository so we can start tracking activity and pull
              requests.
            </p>
            <a
              href="#"
              class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
            >
              Connect repository
            </a>
          </div>
        </li>

        <li class="flex items-start gap-4 px-6 py-5 sm:px-8">
          <span
            class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-full border-2 border-slate-300 text-sm font-semibold text-slate-500"
            aria-hidden="true"
          >
            2
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-900">Invite the team</h3>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                Not started
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600">
              Bring in teammates by email so everyone can collaborate on projects from day one.
            </p>
            <a
              href="#"
              class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
            >
              Invite teammates
            </a>
          </div>
        </li>

        <li class="flex items-start gap-4 px-6 py-5 sm:px-8">
          <span
            class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-full border-2 border-slate-300 text-sm font-semibold text-slate-500"
            aria-hidden="true"
          >
            3
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-900">Create your first project</h3>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                Not started
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600">
              Set up a project to organize your work and start tracking progress toward your goals.
            </p>
            <a
              href="#"
              class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
            >
              Create project
            </a>
          </div>
        </li>
      </ol>
    </div>

    <div class="mt-6 text-center">
      <a href="#" class="text-sm font-medium text-slate-500 underline-offset-4 hover:text-slate-700 hover:underline">
        Skip for now
      </a>
    </div>
  </section>
</main>
