<% content_for :title, "Billing" if defined?(content_for) %>

<div class="max-w-6xl mx-auto px-6 py-10">
  <header class="mb-8">
    <p class="text-sm font-medium text-indigo-600">Acme Robotics workspace</p>
    <h1 class="mt-1 text-2xl font-semibold text-gray-900">Billing</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your plan, payment method, usage, and invoices.</p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Current plan -->
    <section aria-labelledby="current-plan-heading" class="lg:col-span-2 bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <div class="flex items-start justify-between">
        <div>
          <h2 id="current-plan-heading" class="text-sm font-medium text-gray-500">Current plan</h2>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="text-xl font-semibold text-gray-900">Business</span>
            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Active</span>
          </div>
          <p class="mt-1 text-sm text-gray-500">$199.00 / month &middot; billed monthly</p>
        </div>
        <a href="#" class="shrink-0 inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
          Change plan
        </a>
      </div>

      <dl class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-gray-100 pt-6">
        <div>
          <dt class="text-xs font-medium text-gray-500">Renews on</dt>
          <dd class="mt-1 text-sm font-semibold text-gray-900">August 15, 2026</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-gray-500">Seats included</dt>
          <dd class="mt-1 text-sm font-semibold text-gray-900">25 seats</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-gray-500">Billing cycle</dt>
          <dd class="mt-1 text-sm font-semibold text-gray-900">Monthly</dd>
        </div>
      </dl>
    </section>

    <!-- Payment method -->
    <section aria-labelledby="payment-method-heading" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
      <div class="flex items-start justify-between">
        <h2 id="payment-method-heading" class="text-sm font-medium text-gray-500">Payment method</h2>
        <a href="#" class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">Update</a>
      </div>

      <div class="mt-4 flex items-center gap-3">
        <div class="flex h-8 w-12 shrink-0 items-center justify-center rounded bg-gray-900 text-[10px] font-bold tracking-wide text-white">
          VISA
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Visa ending in 4242</p>
          <p class="text-xs text-gray-500">Expires 09/2027</p>
        </div>
      </div>

      <p class="mt-4 text-xs text-gray-500">
        Billing email: <span class="text-gray-700">billing@acmerobotics.com</span>
      </p>
    </section>
  </div>

  <!-- Usage this period -->
  <section aria-labelledby="usage-heading" class="mt-6 bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <div class="flex items-baseline justify-between">
      <h2 id="usage-heading" class="text-sm font-medium text-gray-500">Usage this period</h2>
      <p class="text-xs text-gray-500">July 15 &ndash; August 14, 2026</p>
    </div>

    <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">Seats</span>
          <span class="text-gray-500">18 / 25</span>
        </div>
        <div class="mt-2 h-2 w-full rounded-full bg-gray-100">
          <div class="h-2 rounded-full bg-indigo-600" style="width: 72%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">Storage</span>
          <span class="text-gray-500">340 GB / 500 GB</span>
        </div>
        <div class="mt-2 h-2 w-full rounded-full bg-gray-100">
          <div class="h-2 rounded-full bg-indigo-600" style="width: 68%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">API calls</span>
          <span class="text-gray-500">1.2M / 2M</span>
        </div>
        <div class="mt-2 h-2 w-full rounded-full bg-gray-100">
          <div class="h-2 rounded-full bg-indigo-600" style="width: 60%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">Automations run</span>
          <span class="text-gray-500">
            <span class="font-semibold text-amber-600">950</span> / 1,000
          </span>
        </div>
        <div class="mt-2 h-2 w-full rounded-full bg-gray-100">
          <div class="h-2 rounded-full bg-amber-500" style="width: 95%"></div>
        </div>
        <p class="mt-1 text-xs text-amber-600">Approaching limit &mdash; consider upgrading your plan.</p>
      </div>
    </div>
  </section>

  <!-- Invoice history -->
  <section aria-labelledby="invoice-history-heading" class="mt-6 bg-white border border-gray-200 rounded-xl shadow-sm">
    <div class="flex items-center justify-between px-6 py-5">
      <h2 id="invoice-history-heading" class="text-sm font-medium text-gray-500">Invoice history</h2>
    </div>

    <div class="overflow-x-auto border-t border-gray-100">
      <table class="min-w-full divide-y divide-gray-100">
        <thead>
          <tr class="text-left text-xs font-medium uppercase tracking-wide text-gray-500">
            <th scope="col" class="px-6 py-3">Date</th>
            <th scope="col" class="px-6 py-3">Description</th>
            <th scope="col" class="px-6 py-3">Amount</th>
            <th scope="col" class="px-6 py-3">Status</th>
            <th scope="col" class="px-6 py-3 text-right">Receipt</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Jul 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Paid</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">Download</a>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Jun 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Paid</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">Download</a>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">May 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">Pending</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <span class="text-gray-400">&mdash;</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Apr 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-600/20">Failed</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <span class="text-gray-400">&mdash;</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Mar 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Paid</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">Download</a>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Feb 15, 2026</td>
            <td class="px-6 py-4 whitespace-nowrap text-gray-700">Business plan &mdash; monthly</td>
            <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">$199.00</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Paid</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">Download</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
