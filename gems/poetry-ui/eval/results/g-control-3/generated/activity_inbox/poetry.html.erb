          <%= poetry_item(role: "listitem", variant: :muted) do |item| %>
            <% item.with_media(media_variant: :icon) { poetry_icon(name: :"git-merge") } %>
            <% item.with_title { "PR #892 changed status to Merged" } %>
            <% item.with_description { "Engineering · checkout-service" } %>
            <% item.with_footer { "2 days ago" } %>
            <% item.with_actions do %>
