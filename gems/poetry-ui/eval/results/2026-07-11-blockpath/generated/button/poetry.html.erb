<div class="mx-auto max-w-xl p-6">
  <section class="space-y-4 rounded-lg border border-destructive/50 p-6" aria-labelledby="delete-account-title">
    <div class="space-y-1">
      <h2 id="delete-account-title" class="text-base font-semibold">Delete account</h2>
      <p class="text-sm text-muted-foreground">Permanently remove your account and all associated data. This action cannot be undone.</p>
    </div>
    <div class="flex items-center justify-end">
      <%= poetry_button(variant: :destructive) do |button| %>
        <% button.with_leading { poetry_icon(name: :trash) } %>
        Delete account
      <% end %>
    </div>
  </section>
</div>
