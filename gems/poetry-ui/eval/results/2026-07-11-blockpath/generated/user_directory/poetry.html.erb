<section class="mx-auto max-w-3xl space-y-6 p-6">
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Home", href: "/") %>
    <% crumb.with_item("Team", href: "/team") %>
    <% crumb.with_item("Directory") %>
  <% end %>

  <div class="space-y-1">
    <h1 class="text-2xl font-semibold tracking-tight">Directory</h1>
    <p class="text-sm text-muted-foreground">Everyone on the team, with a quick way to reach out.</p>
  </div>

  <%= poetry_item_group do %>
    <%= poetry_item(role: "listitem", media_variant: :image) do |item| %>
      <% item.with_media { poetry_avatar(label: "Jordan Lee") { "JL" } } %>
      <% item.with_title { "Jordan Lee" } %>
      <% item.with_description { "Product Designer, Platform team" } %>
      <% item.with_actions { poetry_button(variant: :outline, size: :sm) { "Message" } } %>
    <% end %>
    <%= poetry_item_separator %>
    <%= poetry_item(role: "listitem", media_variant: :image) do |item| %>
      <% item.with_media { poetry_avatar(label: "Priya Nair") { "PN" } } %>
      <% item.with_title { "Priya Nair" } %>
