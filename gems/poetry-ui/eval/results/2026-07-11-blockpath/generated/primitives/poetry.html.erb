<div class="mx-auto max-w-xl p-6">
  <%= poetry_card do |card| %>
    <% card.with_title { "Syncing workspace" } %>
    <% card.with_description { "Fetching your latest data. This should only take a moment." } %>

    <div class="space-y-6">
      <div class="flex items-center gap-3">
        <%= poetry_spinner(label: "Syncing workspace…") %>
        <span class="text-sm text-muted-foreground">Syncing workspace…</span>
      </div>

      <div class="flex items-center gap-3" aria-busy="true">
        <%= poetry_skeleton(class: "h-10 w-10 rounded-full") %>
        <div class="flex-1 space-y-2">
          <%= poetry_skeleton(class: "h-4 w-3/4") %>
          <%= poetry_skeleton(class: "h-4 w-1/2") %>
        </div>
      </div>

      <%= poetry_separator %>

      <div class="flex items-center justify-between text-sm text-muted-foreground">
        <span>Need something now?</span>
        <span class="inline-flex items-center gap-1.5">
          Press
          <span class="inline-flex items-center gap-1">
            <%= poetry_kbd { "⌘" } %>
            <%= poetry_kbd { "K" } %>
          </span>
          to search
        </span>
      </div>
    </div>
  <% end %>
</div>
