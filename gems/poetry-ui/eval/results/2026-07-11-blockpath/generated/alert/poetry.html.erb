<div class="mx-auto max-w-2xl p-6">
  <%= poetry_alert(variant: :destructive) do |alert| %>
    <% alert.with_icon(name: "triangle-alert") %>
    <% alert.with_title { "Payment failed" } %>
    We couldn't charge your card ending in 4242. Update your payment method or retry the charge to avoid a lapse in service.
  <% end %>
</div>
