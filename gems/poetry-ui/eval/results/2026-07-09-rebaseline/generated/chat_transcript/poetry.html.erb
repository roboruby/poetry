<div class="mx-auto flex max-w-2xl flex-col p-6">
  <%= poetry_message_scroller(id: "chat-transcript", jump_button: false) do %>
    <%= poetry_message_scroller_item(id: "divider-today") do %>
      <div class="py-2">
        <%= poetry_marker(variant: :separator) { "Today" } %>
      </div>
    <% end %>

    <%= poetry_message_scroller_item(id: "message-1") do %>
      <%= poetry_message(align: :start) do |message| %>
        <% message.with_avatar do %>
          <%= poetry_avatar(label: "Assistant", size: :default) { "AI" } %>
        <% end %>
        <% message.with_header do %>
          Assistant
        <% end %>
        <% message.with_footer do %>
          10:32 AM
        <% end %>

        <div class="flex flex-col gap-2">
          <%= poetry_bubble(variant: :default, align: :start) do %>
            I've pulled together the Q3 summary you asked for. The full breakdown is
            attached below &mdash; let me know if you'd like me to expand on any section.
          <% end %>

          <%= poetry_attachment(orientation: :horizontal, size: :default, state: :done) do |attachment| %>
            <% attachment.with_media(variant: :icon) do %>
              <%= poetry_icon(name: :"file-text") %>
            <% end %>
            <% attachment.with_title do %>
              Q3-summary.pdf
            <% end %>
            <% attachment.with_description do %>
              248 KB
            <% end %>
            <% attachment.with_action(label: "Download") do %>
              <%= poetry_icon(name: :download) %>
            <% end %>
          <% end %>

          <%= poetry_bubble(variant: :outline, align: :start, tag: :button) do %>
            Expand the revenue section
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= poetry_message_scroller_item(id: "status-thinking") do %>
      <div class="flex items-center gap-2 py-2 pl-11">
        <%= poetry_marker(variant: :default, announce: :status) { "Assistant is thinking…" } %>
      </div>
    <% end %>
  <% end %>
</div>
