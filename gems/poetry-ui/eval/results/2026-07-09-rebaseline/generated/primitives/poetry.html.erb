<div class="mx-auto max-w-2xl p-6 space-y-6">
  <div class="flex items-center gap-3">
    <%= poetry_spinner(label: "Loading dashboard") %>
    <span class="text-sm text-muted-foreground">Loading dashboard…</span>
  </div>

  <div class="flex items-center gap-4" aria-busy="true">
    <%= poetry_skeleton(class: "h-10 w-10 shrink-0 rounded-full") %>
    <div class="flex-1 space-y-2">
      <%= poetry_skeleton(class: "h-4 w-3/4") %>
      <%= poetry_skeleton(class: "h-4 w-1/2") %>
    </div>
  </div>

  <%= poetry_separator %>

  <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground">
    <span>Press</span>
    <span class="inline-flex items-center gap-1">
      <%= poetry_kbd { "⌘" } %>
      <%= poetry_kbd { "K" } %>
    </span>
    <span>to search</span>
  </div>
</div>
