<div class="mx-auto max-w-4xl px-6 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Settings</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your account details, password, and notification preferences.</p>
  </div>

  <div class="
    overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm
    has-[#tab-password:checked]:[&_#panel-account]:hidden
    has-[#tab-notifications:checked]:[&_#panel-account]:hidden
    has-[#tab-password:checked]:[&_#panel-password]:block
    has-[#tab-notifications:checked]:[&_#panel-notifications]:block
  ">
    <div class="border-b border-gray-200 px-6">
      <div class="flex gap-x-8" role="radiogroup" aria-label="Settings sections">
        <label
          for="tab-account"
          class="flex cursor-pointer items-center gap-2 border-b-2 border-transparent py-4 text-sm font-medium text-gray-500 has-[:checked]:border-indigo-600 has-[:checked]:text-indigo-600 has-[:focus-visible]:rounded-sm has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo-600 hover:text-gray-700"
        >
          <input type="radio" id="tab-account" name="settings-tab" class="sr-only" checked>
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 8a3 3 0 100-6 3 3 0 000 6zm-7 8a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
          Account
        </label>

        <label
          for="tab-password"
          class="flex cursor-pointer items-center gap-2 border-b-2 border-transparent py-4 text-sm font-medium text-gray-500 has-[:checked]:border-indigo-600 has-[:checked]:text-indigo-600 has-[:focus-visible]:rounded-sm has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo-600 hover:text-gray-700"
        >
          <input type="radio" id="tab-password" name="settings-tab" class="sr-only">
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
          Password
        </label>

        <label
          for="tab-notifications"
          class="flex cursor-pointer items-center gap-2 border-b-2 border-transparent py-4 text-sm font-medium text-gray-500 has-[:checked]:border-indigo-600 has-[:checked]:text-indigo-600 has-[:focus-visible]:rounded-sm has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo-600 hover:text-gray-700"
        >
          <input type="radio" id="tab-notifications" name="settings-tab" class="sr-only">
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 2a6 6 0 00-6 6c0 3.5-1.5 4.5-1.5 5.5S3 15 4.5 15h11c1.5 0 1.5-.5 1.5-1.5S16 11.5 16 8a6 6 0 00-6-6zM8.5 17a1.5 1.5 0 003 0h-3z" />
          </svg>
          Notifications
        </label>
      </div>
    </div>

    <div id="panel-account" class="px-6 py-8">
      <h2 class="text-base font-semibold text-gray-900">Profile information</h2>
      <p class="mt-1 text-sm text-gray-500">This information may be visible to other people using the service.</p>

      <form class="mt-6 space-y-6" action="#" method="post">
        <div class="flex items-center gap-x-5">
          <span class="flex size-16 items-center justify-center rounded-full bg-indigo-100 text-xl font-semibold text-indigo-700">
            MS
          </span>
          <div class="flex items-center gap-x-3">
            <label for="avatar-upload" class="cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-50 focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-indigo-600">
              Change photo
              <input id="avatar-upload" type="file" accept="image/*" class="sr-only">
            </label>
            <button type="button" class="text-sm font-semibold text-gray-500 hover:text-gray-700">Remove</button>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="full-name" class="block text-sm font-medium text-gray-900">Full name</label>
            <input type="text" id="full-name" name="full-name" value="Matt Solt" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
          </div>
          <div>
            <label for="username" class="block text-sm font-medium text-gray-900">Username</label>
            <input type="text" id="username" name="username" value="mattsolt" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
          </div>
          <div class="sm:col-span-2">
            <label for="email" class="block text-sm font-medium text-gray-900">Email address</label>
            <input type="email" id="email" name="email" value="mattsolt@gmail.com" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
          </div>
          <div class="sm:col-span-2">
            <label for="timezone" class="block text-sm font-medium text-gray-900">Time zone</label>
            <select id="timezone" name="timezone" class="mt-2 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
              <option>Pacific Time (US &amp; Canada)</option>
              <option>Mountain Time (US &amp; Canada)</option>
              <option>Central Time (US &amp; Canada)</option>
              <option>Eastern Time (US &amp; Canada)</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="bio" class="block text-sm font-medium text-gray-900">Bio</label>
            <textarea id="bio" name="bio" rows="3" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">Product designer based in the Bay Area.</textarea>
            <p class="mt-2 text-sm text-gray-500">Brief description for your profile.</p>
          </div>
        </div>

        <div class="flex justify-end gap-x-3 border-t border-gray-200 pt-6">
          <button type="button" class="rounded-md px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-50">Cancel</button>
          <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Save changes</button>
        </div>
      </form>
    </div>

    <div id="panel-password" class="hidden px-6 py-8">
      <h2 class="text-base font-semibold text-gray-900">Change password</h2>
      <p class="mt-1 text-sm text-gray-500">Update the password associated with your account.</p>

      <form class="mt-6 max-w-md space-y-6" action="#" method="post">
        <div>
          <label for="current-password" class="block text-sm font-medium text-gray-900">Current password</label>
          <input type="password" id="current-password" name="current-password" autocomplete="current-password" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
        </div>
        <div>
          <label for="new-password" class="block text-sm font-medium text-gray-900">New password</label>
          <input type="password" id="new-password" name="new-password" autocomplete="new-password" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
          <ul class="mt-2 space-y-1 text-sm text-gray-500">
            <li>At least 8 characters</li>
            <li>At least one number and one symbol</li>
          </ul>
        </div>
        <div>
          <label for="confirm-password" class="block text-sm font-medium text-gray-900">Confirm new password</label>
          <input type="password" id="confirm-password" name="confirm-password" autocomplete="new-password" class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-600 focus:outline focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600">
        </div>

        <div class="flex justify-end gap-x-3 border-t border-gray-200 pt-6">
          <button type="button" class="rounded-md px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-50">Cancel</button>
          <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Update password</button>
        </div>
      </form>
    </div>

    <div id="panel-notifications" class="hidden px-6 py-8">
      <h2 class="text-base font-semibold text-gray-900">Notification preferences</h2>
      <p class="mt-1 text-sm text-gray-500">Choose how you want to be notified about activity on your account.</p>

      <form class="mt-6 space-y-8" action="#" method="post">
        <fieldset>
          <legend class="text-sm font-semibold text-gray-900">Email</legend>
          <div class="mt-3 divide-y divide-gray-200 border-t border-gray-200">
            <label class="flex items-center justify-between gap-4 py-4">
              <span>
                <span class="block text-sm font-medium text-gray-900">Product updates</span>
                <span class="block text-sm text-gray-500">News about new features and improvements.</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <input type="checkbox" class="peer sr-only" checked>
                <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-indigo-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
              </span>
            </label>
            <label class="flex items-center justify-between gap-4 py-4">
              <span>
                <span class="block text-sm font-medium text-gray-900">Security alerts</span>
                <span class="block text-sm text-gray-500">Sign-in attempts and account changes.</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <input type="checkbox" class="peer sr-only" checked>
                <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-indigo-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
              </span>
            </label>
            <label class="flex items-center justify-between gap-4 py-4">
              <span>
                <span class="block text-sm font-medium text-gray-900">Weekly digest</span>
                <span class="block text-sm text-gray-500">A summary of activity from the past week.</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <input type="checkbox" class="peer sr-only">
                <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-indigo-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-gray-900">Push</legend>
          <div class="mt-3 divide-y divide-gray-200 border-t border-gray-200">
            <label class="flex items-center justify-between gap-4 py-4">
              <span>
                <span class="block text-sm font-medium text-gray-900">Mentions</span>
                <span class="block text-sm text-gray-500">When someone mentions you directly.</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <input type="checkbox" class="peer sr-only" checked>
                <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-indigo-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
              </span>
            </label>
            <label class="flex items-center justify-between gap-4 py-4">
              <span>
                <span class="block text-sm font-medium text-gray-900">Direct messages</span>
                <span class="block text-sm text-gray-500">New messages sent straight to you.</span>
              </span>
              <span class="relative inline-flex shrink-0 items-center">
                <input type="checkbox" class="peer sr-only" checked>
                <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-indigo-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600"></span>
                <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="flex justify-end gap-x-3 border-t border-gray-200 pt-6">
          <button type="button" class="rounded-md px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-50">Cancel</button>
          <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Save preferences</button>
        </div>
      </form>
    </div>
  </div>
</div>
