<div class="mx-auto max-w-xl space-y-6 p-6">
  <div class="space-y-1">
    <h1 class="text-2xl font-semibold tracking-tight">Notifications</h1>
    <p class="text-sm text-muted-foreground">Toasts surface transient outcomes without leaving the page.</p>
  </div>

  <%= poetry_toaster(position: :"bottom-right") do %>
    <%= poetry_toast(variant: :success, duration: 5000) do |t| %>
      <% t.with_title { "Saved" } %>
      <% t.with_description { "Your changes have been saved." } %>
    <% end %>

    <%= poetry_toast(variant: :destructive) do |t| %>
      <% t.with_title { "Payment failed" } %>
      <% t.with_description { "We couldn't charge your card on file. Update your payment method or try again." } %>
      <% t.with_action do %>
        <%= poetry_button(size: :sm, variant: :outline) { "Retry" } %>
      <% end %>
    <% end %>
  <% end %>
</div>
