<div class="mx-auto max-w-xl p-6">
  <%= poetry_card title_tag: :h1 do |card| %>
    <% card.with_title { "Choose a framework" } %>
    <% card.with_description { "Search and select the framework your project uses, then continue." } %>

    <%= form_with url: "#", method: :get, class: "space-y-4" do %>
      <div class="space-y-2">
        <%= poetry_label for_id: "framework" do %>Framework<% end %>
        <%= poetry_combobox id: "framework", name: "framework", placeholder: "Select framework...", search_placeholder: "Search frameworks...", width: "w-80" do |c| %>
          <% c.with_item(value: "nextjs") { "Next.js" } %>
          <% c.with_item(value: "sveltekit") { "SvelteKit" } %>
          <% c.with_item(value: "nuxtjs") { "Nuxt.js" } %>
          <% c.with_item(value: "remix") { "Remix" } %>
          <% c.with_item(value: "astro") { "Astro" } %>
        <% end %>
      </div>

      <%= poetry_button type: :submit do %>Continue<% end %>
    <% end %>
  <% end %>
</div>
