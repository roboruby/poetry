<div class="mx-auto max-w-3xl p-6 space-y-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Team", href: "/team") %>
      <% crumb.with_item("Directory") %>
    <% end %>
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Directory</h1>
      <p class="text-sm text-muted-foreground">Everyone on the team, with a quick way to reach them.</p>
    </div>
    <%= poetry_separator %>
  </header>

  <%= poetry_item_group(role: "list", class: "space-y-1") do %>
    <%= poetry_item(size: :default, variant: :default, media_variant: :image, role: "listitem") do |item| %>
      <% item.with_media { poetry_avatar(label: "Amara Osei", size: :lg) { "AO" } } %>
      <% item.with_title { "Amara Osei" } %>
      <% item.with_description { "Product Designer, Growth" } %>
      <% item.with_actions do %>
        <%= poetry_button(variant: :outline, size: :sm) do |button| %>
          <% button.with_leading { poetry_icon(name: :"message-circle") } %>
          Message
        <% end %>
      <% end %>
    <% end %>
    <%= poetry_item_separator %>

    <%= poetry_item(size: :default, variant: :default, media_variant: :image, role: "listitem") do |item| %>
