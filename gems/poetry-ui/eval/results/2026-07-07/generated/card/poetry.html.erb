<div class="mx-auto max-w-xl px-6 py-16">
  <%= poetry_card do |card| %>
    <% card.with_title { "Smart Renewals" } %>
    <% card.with_description { "Automatically catch renewals before they lapse." } %>
    <% card.with_action { poetry_badge(variant: :secondary) { "Beta" } } %>

    <p class="text-sm leading-relaxed">
      Smart Renewals keeps an eye on every subscription in your account and flags
      the ones that need attention 30 days before they're due. When a renewal
      looks at risk, we surface a recommended next step and draft the outreach
      so your team can approve it in a single click.
    </p>
    <p class="mt-3 text-sm leading-relaxed">
      Early access is limited while we tune the risk model against real renewal
      data — feedback from this stage shapes what ships to everyone next quarter.
    </p>

    <% card.with_footer { poetry_link(href: "#") { "Learn more" } } %>
  <% end %>
</div>
