<section class="mx-auto max-w-3xl space-y-16 px-6 py-12">
  <header class="space-y-2">
    <h1 class="text-2xl font-semibold text-gray-900">Floating UI</h1>
    <p class="text-sm text-gray-500">A popover form, a tooltip on an icon control, and a link with a profile hover-card.</p>
  </header>

  <div class="space-y-3">
    <h2 class="text-sm font-medium text-gray-700">Dimensions</h2>

    <button
      type="button"
      popovertarget="dimensions-popover"
      class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
    >
      Open popover
    </button>

    <div
      id="dimensions-popover"
      popover
      class="m-auto w-80 max-w-[90vw] rounded-lg border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/40"
    >
      <form class="flex flex-col gap-4 p-5">
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Dimensions</h3>
          <p class="mt-1 text-xs text-gray-500">Set the width and height for this element.</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col gap-1">
            <label for="dimensions-width" class="text-xs font-medium text-gray-600">Width</label>
            <input
              id="dimensions-width"
              name="width"
              type="number"
              value="100"
              min="0"
              class="rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
            >
          </div>
          <div class="flex flex-col gap-1">
            <label for="dimensions-height" class="text-xs font-medium text-gray-600">Height</label>
            <input
              id="dimensions-height"
              name="height"
              type="number"
              value="100"
              min="0"
              class="rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
            >
          </div>
        </div>

        <label class="flex items-center gap-2 text-xs text-gray-600">
          <input type="checkbox" name="lock_aspect_ratio" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
          Lock aspect ratio
        </label>

        <div class="flex justify-end gap-2 pt-2">
          <button
            type="button"
            popovertarget="dimensions-popover"
            popovertargetaction="hide"
            class="rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-100"
          >
            Cancel
          </button>
          <button
            type="button"
            popovertarget="dimensions-popover"
            popovertargetaction="hide"
            class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500"
          >
            Apply
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="space-y-3">
    <h2 class="text-sm font-medium text-gray-700">Add to library</h2>

    <div class="group/tooltip relative inline-flex">
      <button
        type="button"
        aria-label="Add to library"
        aria-describedby="add-to-library-tooltip"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 bg-white text-gray-600 shadow-sm hover:bg-gray-50 hover:text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>

      <span
        id="add-to-library-tooltip"
        role="tooltip"
        class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 whitespace-nowrap rounded-md bg-gray-900 px-2 py-1 text-xs font-medium text-white opacity-0 shadow-lg transition duration-150 group-hover/tooltip:opacity-100 group-focus-within/tooltip:opacity-100"
      >
        Add to library
        <span class="absolute left-1/2 top-full -translate-x-1/2 border-4 border-transparent border-t-gray-900"></span>
      </span>
    </div>
  </div>

  <div class="space-y-3">
    <h2 class="text-sm font-medium text-gray-700">Mentioned</h2>

    <p class="text-sm text-gray-600">
      Built and maintained by the team behind
      <span class="group/hovercard relative inline-block">
        <a
          href="https://x.com/nextjs"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-indigo-600 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-700"
        >@nextjs</a>

        <span
          role="tooltip"
          class="pointer-events-none absolute left-0 top-full z-10 mt-2 w-80 origin-top-left scale-95 rounded-xl border border-gray-200 bg-white p-4 opacity-0 shadow-2xl transition duration-150 group-hover/hovercard:pointer-events-auto group-hover/hovercard:scale-100 group-hover/hovercard:opacity-100 group-focus-within/hovercard:pointer-events-auto group-focus-within/hovercard:scale-100 group-focus-within/hovercard:opacity-100"
        >
          <div class="flex items-start gap-3">
            <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-black text-base font-bold text-white">N</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-gray-900">Next.js</p>
              <p class="text-xs text-gray-500">@nextjs</p>
            </div>
            <button type="button" class="flex-none rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white hover:bg-gray-700">Follow</button>
          </div>
          <p class="mt-3 text-sm text-gray-700">The React Framework for the Web. Used by some of the world's largest companies.</p>
          <div class="mt-3 flex gap-4 text-xs text-gray-500">
            <span><span class="font-semibold text-gray-900">1.2M</span> Followers</span>
            <span><span class="font-semibold text-gray-900">312</span> Following</span>
          </div>
        </span>
      </span>
      for building the web.
    </p>
  </div>
</section>
