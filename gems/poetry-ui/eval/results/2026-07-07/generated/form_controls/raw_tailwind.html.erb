<section class="mx-auto max-w-3xl px-6 py-10">
  <header class="mb-8">
    <h1 class="text-2xl font-semibold text-slate-900">Notification settings</h1>
    <p class="mt-1 text-sm text-slate-500">Control how and when we reach you, plus a few quick preferences.</p>
  </header>

  <!-- Quick preferences: instant-effect switch, bookmark toggle, exclusive view switcher -->
  <div class="mb-8 flex flex-wrap items-center justify-between gap-6 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <form action="#" method="post" class="flex items-center gap-3">
      <span id="email-alerts-label" class="text-sm font-medium text-slate-700">Email alerts</span>
      <button
        type="submit"
        name="email_alerts"
        value="off"
        role="switch"
        aria-checked="true"
        aria-labelledby="email-alerts-label"
        class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-indigo-600 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
      >
        <span class="inline-block h-4 w-4 translate-x-6 transform rounded-full bg-white shadow transition-transform"></span>
      </button>
      <span class="text-xs text-slate-400">Applies immediately</span>
    </form>

    <div class="flex items-center gap-2">
      <input type="checkbox" id="bookmark-toggle" name="bookmarked" class="peer sr-only">
      <label
        for="bookmark-toggle"
        class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-500 transition-colors hover:border-slate-300 peer-checked:border-amber-300 peer-checked:bg-amber-50 peer-checked:text-amber-600 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400 peer-focus-visible:ring-offset-1"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M6.32 2.577a49.255 49.255 0 0111.36 0c1.497.174 2.57 1.46 2.57 2.93V21a.75.75 0 01-1.085.67L12 18.089l-7.165 3.583A.75.75 0 013.75 21V5.507c0-1.47 1.073-2.756 2.57-2.93z" clip-rule="evenodd" />
        </svg>
        <span>Bookmarked</span>
      </label>
    </div>

    <fieldset>
      <legend class="sr-only">Notification list layout</legend>
      <div class="inline-flex rounded-md border border-slate-200 bg-slate-50 p-1">
        <label class="inline-flex cursor-pointer items-center gap-1.5 rounded px-3 py-1.5 text-sm text-slate-500 transition-colors has-[:checked]:bg-white has-[:checked]:text-slate-900 has-[:checked]:shadow-sm">
          <input type="radio" name="view_mode" value="list" class="sr-only" checked>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3.75 5.25a.75.75 0 01.75-.75h15a.75.75 0 010 1.5h-15a.75.75 0 01-.75-.75zM3.75 10.5a.75.75 0 01.75-.75h15a.75.75 0 010 1.5h-15a.75.75 0 01-.75-.75zM3.75 15.75a.75.75 0 01.75-.75h15a.75.75 0 010 1.5h-15a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
          </svg>
          List
        </label>
        <label class="inline-flex cursor-pointer items-center gap-1.5 rounded px-3 py-1.5 text-sm text-slate-500 transition-colors has-[:checked]:bg-white has-[:checked]:text-slate-900 has-[:checked]:shadow-sm">
          <input type="radio" name="view_mode" value="grid" class="sr-only">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 6a3 3 0 013-3h1.5a3 3 0 013 3v1.5a3 3 0 01-3 3H6a3 3 0 01-3-3V6zM3 15a3 3 0 013-3h1.5a3 3 0 013 3v1.5a3 3 0 01-3 3H6a3 3 0 01-3-3V15zM13.5 6a3 3 0 013-3H18a3 3 0 013 3v1.5a3 3 0 01-3 3h-1.5a3 3 0 01-3-3V6zM13.5 15a3 3 0 013-3H18a3 3 0 013 3v1.5a3 3 0 01-3 3h-1.5a3 3 0 01-3-3V15z" />
          </svg>
          Grid
        </label>
      </div>
    </fieldset>
  </div>

  <!-- Digest frequency: choice saves as soon as it is submitted -->
  <form action="#" method="post" class="mb-8 flex flex-wrap items-end gap-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex-1 min-w-[12rem]">
      <label for="digest_frequency" class="block text-sm font-medium text-slate-700">Digest frequency</label>
      <p class="text-xs text-slate-500">Choosing a new frequency saves right away.</p>
      <select
        id="digest_frequency"
        name="digest_frequency"
        class="mt-2 block w-full max-w-xs rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
      >
        <option value="realtime">Real-time</option>
        <option value="daily" selected>Daily</option>
        <option value="weekly">Weekly</option>
        <option value="monthly">Monthly</option>
        <option value="never">Never</option>
      </select>
    </div>
    <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2">
      Save frequency
    </button>
  </form>

  <!-- Staged settings: nothing here applies until "Save settings" is pressed -->
  <form action="#" method="post" class="space-y-8 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div>
      <label for="alert_volume" class="block text-sm font-medium text-slate-700">Alert volume</label>
      <input
        type="range"
        id="alert_volume"
        name="alert_volume"
        min="0"
        max="100"
        step="25"
        value="50"
        list="alert-volume-ticks"
        class="mt-3 w-full accent-indigo-600"
      >
      <datalist id="alert-volume-ticks">
        <option value="0"></option>
        <option value="25"></option>
        <option value="50"></option>
        <option value="75"></option>
        <option value="100"></option>
      </datalist>
      <div class="mt-1 flex justify-between text-xs text-slate-400">
        <span>Silent</span>
        <span>Loud</span>
      </div>
    </div>

    <div>
      <label for="unsubscribe_note" class="block text-sm font-medium text-slate-700">Unsubscribe note</label>
      <p class="text-xs text-slate-500">Optional &mdash; let us know why you're leaving.</p>
      <textarea
        id="unsubscribe_note"
        name="unsubscribe_note"
        rows="4"
        placeholder="Tell us why you're unsubscribing (optional)"
        class="mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
      ></textarea>
    </div>

    <fieldset>
      <legend class="block text-sm font-medium text-slate-700">Confirmation code</legend>
      <p id="confirmation-code-hint" class="text-xs text-slate-500">Enter the 6-digit code we sent to your email.</p>
      <div class="mt-2 flex gap-2" role="group" aria-describedby="confirmation-code-hint">
        <% 6.times do |i| %>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]"
            maxlength="1"
            autocomplete="<%= i.zero? ? "one-time-code" : "off" %>"
            aria-label="Digit <%= i + 1 %> of 6"
            name="confirmation_code[]"
            class="h-12 w-10 rounded-md border border-slate-300 text-center text-lg font-semibold text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-start gap-3 border-t border-slate-200 pt-6">
      <input type="checkbox" id="accept_terms" name="accept_terms" value="1" required class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-indigo-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
      <label for="accept_terms" class="text-sm text-slate-600">
        I accept the <a href="#" class="font-medium text-indigo-600 underline hover:text-indigo-500">notification terms</a>, and understand these settings take effect once saved.
      </label>
    </div>

    <div class="flex justify-end border-t border-slate-200 pt-6">
      <button type="submit" class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2">
        Save settings
      </button>
    </div>
  </form>
</section>
