<div class="flex justify-center p-8">
  <%= poetry_card do |card| %>
    <% card.with_title { "Version Tags" } %>
    <% card.with_description { "20 releases, newest first" } %>

    <%= poetry_scroll_area(label: "Version tags", class: "h-48 w-48") do %>
      <ul class="flex flex-col gap-2 pr-3">
        <% [
          "v3.4.0", "v3.3.2", "v3.3.1", "v3.3.0", "v3.2.5",
          "v3.2.4", "v3.2.3", "v3.2.2", "v3.2.1", "v3.2.0",
          "v3.1.4", "v3.1.3", "v3.1.2", "v3.1.1", "v3.1.0",
          "v3.0.2", "v3.0.1", "v3.0.0", "v2.9.1", "v2.9.0"
        ].each do |tag| %>
          <li>
            <%= poetry_badge(variant: :outline) { tag } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
