<div class="mx-auto max-w-2xl px-6 py-16">
  <header class="mb-10">
    <h1 class="text-3xl font-semibold tracking-tight">Help &amp; FAQs</h1>
    <p class="mt-3 text-sm">
      Quick answers to the questions we hear most. Still stuck? Open the
      advanced options near the bottom before you contact support.
    </p>
  </header>

  <section aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-lg font-semibold tracking-tight">Frequently asked questions</h2>

    <div class="mt-4">
      <%= poetry_accordion(type: :single, collapsible: true, open: %w[billing]) do |accordion| %>
        <% accordion.with_item(value: "billing", title: "How am I billed for my subscription?") do %>
          <p>
            You're billed automatically at the start of each billing cycle
            using the payment method on file. An invoice is emailed the same
            day and is always available from your billing history.
          </p>
        <% end %>

        <% accordion.with_item(value: "change-plan", title: "Can I change or cancel my plan at any time?") do %>
          <p>
            Yes. Upgrades take effect immediately, and downgrades or
            cancellations apply at the end of your current billing cycle, so
            you keep access to what you've already paid for.
          </p>
        <% end %>

        <% accordion.with_item(value: "refunds", title: "What is your refund policy?") do %>
          <p>
            We offer a full refund within 14 days of your first charge.
            After that, refunds are evaluated case by case &mdash; reach out
            and we'll take a look.
          </p>
        <% end %>

        <% accordion.with_item(value: "data", title: "How is my data stored and protected?") do %>
          <p>
            All data is encrypted in transit and at rest, backed up daily,
            and stored in region-appropriate data centers. You can export or
            permanently delete your data at any time from account settings.
          </p>
        <% end %>

        <% accordion.with_item(value: "support", title: "How do I contact support?") do %>
          <p>
            Email <strong>support@yourcompany.example</strong> or use the
            in-app chat. For technical issues, opening the advanced options
            below and including your diagnostic details helps us resolve
            things faster.
          </p>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="my-10">
    <%= poetry_separator %>
  </div>

  <section aria-labelledby="advanced-heading">
    <h2 id="advanced-heading" class="text-lg font-semibold tracking-tight">Advanced options</h2>
    <p class="mt-3 text-sm">
      Sharing diagnostic details when you contact support helps us track
      down technical issues faster.
    </p>

    <div class="mt-4">
      <%= poetry_collapsible(open: false) do |collapsible| %>
        <% collapsible.with_trigger { "Show advanced options" } %>

        <div class="mt-4 space-y-5">
          <%= poetry_field(id: "diagnostic-id", label_text: "Diagnostic ID", hint: "Reference this when you contact support.") do |field| %>
            <%= poetry_input(**field.control_attributes, name: "diagnostic_id", value: "DG-48213-XR", disabled: true) %>
          <% end %>

          <%= poetry_field(id: "log-verbosity", label_text: "Log verbosity", hint: "Verbose and Debug include more detail in exported logs.") do |field| %>
            <%= poetry_native_select(**field.control_attributes, name: "log_verbosity", options: [["Standard", "standard"], ["Verbose", "verbose"], ["Debug", "debug"]], selected: "standard") %>
          <% end %>

          <%= poetry_checkbox(name: "include_device_info", label: "Include device and browser information in exported logs", checked: true) %>
        </div>
      <% end %>
    </div>
  </section>
</div>
