<div class="mx-auto max-w-5xl p-6">
  <div class="flex flex-col gap-6">
    <header class="flex flex-col gap-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="space-y-1">
          <h1 class="text-2xl font-semibold tracking-tight">API keys</h1>
          <p class="text-sm text-muted-foreground">Keys your integrations use to authenticate with the API.</p>
        </div>
        <%= poetry_button do |button| %>
          <% button.with_leading { poetry_icon(name: :plus) } %>
          New API key
        <% end %>
      </div>
      <%= poetry_separator %>
    </header>

    <div class="flex flex-wrap items-center gap-3">
      <%= poetry_label(for_id: "api-keys-search", class: "sr-only") { "Search API keys" } %>
      <%= poetry_input_group(class: "max-w-xs") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :search) %>
        <% end %>
        <%= poetry_input_group_input(id: "api-keys-search", name: "q", placeholder: "Search API keys…") %>
      <% end %>

      <%= poetry_sheet(side: :right, class: "ml-auto") do |sheet| %>
        <% sheet.with_trigger do %>
          <%= poetry_button(variant: :outline) do |button| %>
            <% button.with_leading { poetry_icon(name: :"list-filter") } %>
            Filter results
          <% end %>
        <% end %>
        <% sheet.with_title { "Filter results" } %>
        <% sheet.with_description { "Narrow the list below by status, scope, and creation date." } %>
        <div class="space-y-6 px-4">
          <fieldset class="space-y-3">
            <legend class="text-sm font-medium">Status</legend>
            <div class="space-y-2">
              <%= poetry_checkbox(name: "status[]", value: "active", checked: true, label: "Active") %>
              <%= poetry_checkbox(name: "status[]", value: "revoked", label: "Revoked") %>
              <%= poetry_checkbox(name: "status[]", value: "expired", label: "Expired") %>
            </div>
          </fieldset>

          <div class="space-y-2">
            <%= poetry_label(for_id: "filter-scope") { "Scope" } %>
            <%= poetry_native_select(id: "filter-scope", name: "scope",
                                     options: [["All scopes", "all"], ["Read only", "read"],
                                               ["Read & write", "read_write"], ["Admin", "admin"]]) %>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-2">
              <%= poetry_label(for_id: "filter-created-after") { "Created after" } %>
              <%= poetry_input(id: "filter-created-after", name: "created_after", type: "date") %>
            </div>
            <div class="space-y-2">
              <%= poetry_label(for_id: "filter-created-before") { "Created before" } %>
              <%= poetry_input(id: "filter-created-before", name: "created_before", type: "date") %>
            </div>
          </div>
        </div>
        <% sheet.with_footer do %>
          <%= poetry_button(variant: :outline) { "Reset" } %>
          <%= poetry_button { "Apply filters" } %>
        <% end %>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg border">
      <%= poetry_table do %>
        <%= poetry_table_caption(class: "sr-only") { "API keys with scope, status, and usage." } %>
        <%= poetry_table_header do %>
          <%= poetry_table_row do %>
            <%= poetry_table_head { "Name" } %>
            <%= poetry_table_head { "Key" } %>
            <%= poetry_table_head { "Scope" } %>
            <%= poetry_table_head { "Status" } %>
            <%= poetry_table_head { "Last used" } %>
            <%= poetry_table_head(class: "text-right") { "Actions" } %>
          <% end %>
        <% end %>
        <%= poetry_table_body do %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "Production server" } %>
            <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") { "sk_live_••••••••a1f2" } %>
            <%= poetry_table_cell { "Read & write" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Active" } } %>
            <%= poetry_table_cell(class: "text-muted-foreground") { "2 hours ago" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_alert_dialog do |dialog| %>
                <% dialog.with_trigger do %>
                  <%= poetry_button(variant: :ghost, size: :"icon-sm", label: "Delete “Production server” API key") do %>
                    <%= poetry_icon(name: :trash) %>
                  <% end %>
                <% end %>
                <% dialog.with_title { "Delete API key?" } %>
                <% dialog.with_description { "“Production server” will stop authenticating immediately. Any service still using this key will start failing requests until it is reconfigured with a new one. This cannot be undone." } %>
                <% dialog.with_cancel(variant: :outline) { "Cancel" } %>
                <% dialog.with_action(variant: :destructive) { "Delete API key" } %>
              <% end %>
            <% end %>
          <% end %>

          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "CI pipeline" } %>
            <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") { "sk_live_••••••••7c3d" } %>
            <%= poetry_table_cell { "Read only" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Active" } } %>
            <%= poetry_table_cell(class: "text-muted-foreground") { "18 minutes ago" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_alert_dialog do |dialog| %>
                <% dialog.with_trigger do %>
                  <%= poetry_button(variant: :ghost, size: :"icon-sm", label: "Delete “CI pipeline” API key") do %>
                    <%= poetry_icon(name: :trash) %>
                  <% end %>
                <% end %>
                <% dialog.with_title { "Delete API key?" } %>
                <% dialog.with_description { "“CI pipeline” will stop authenticating immediately. Any service still using this key will start failing requests until it is reconfigured with a new one. This cannot be undone." } %>
                <% dialog.with_cancel(variant: :outline) { "Cancel" } %>
                <% dialog.with_action(variant: :destructive) { "Delete API key" } %>
              <% end %>
            <% end %>
          <% end %>

          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "Staging worker" } %>
            <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") { "sk_test_••••••••9b41" } %>
            <%= poetry_table_cell { "Read & write" } %>
            <%= poetry_table_cell { poetry_badge(variant: :warning) { "Expiring soon" } } %>
            <%= poetry_table_cell(class: "text-muted-foreground") { "3 days ago" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_alert_dialog do |dialog| %>
                <% dialog.with_trigger do %>
                  <%= poetry_button(variant: :ghost, size: :"icon-sm", label: "Delete “Staging worker” API key") do %>
                    <%= poetry_icon(name: :trash) %>
                  <% end %>
                <% end %>
                <% dialog.with_title { "Delete API key?" } %>
                <% dialog.with_description { "“Staging worker” will stop authenticating immediately. Any service still using this key will start failing requests until it is reconfigured with a new one. This cannot be undone." } %>
                <% dialog.with_cancel(variant: :outline) { "Cancel" } %>
                <% dialog.with_action(variant: :destructive) { "Delete API key" } %>
              <% end %>
            <% end %>
          <% end %>

          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "Local development" } %>
            <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") { "sk_test_••••••••2e08" } %>
            <%= poetry_table_cell { "Admin" } %>
            <%= poetry_table_cell { poetry_badge(variant: :outline) { "Revoked" } } %>
            <%= poetry_table_cell(class: "text-muted-foreground") { "Never" } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_alert_dialog do |dialog| %>
                <% dialog.with_trigger do %>
                  <%= poetry_button(variant: :ghost, size: :"icon-sm", label: "Delete “Local development” API key") do %>
                    <%= poetry_icon(name: :trash) %>
                  <% end %>
                <% end %>
                <% dialog.with_title { "Delete API key?" } %>
                <% dialog.with_description { "“Local development” will stop authenticating immediately. Any service still using this key will start failing requests until it is reconfigured with a new one. This cannot be undone." } %>
                <% dialog.with_cancel(variant: :outline) { "Cancel" } %>
                <% dialog.with_action(variant: :destructive) { "Delete API key" } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <p class="text-sm text-muted-foreground">Showing 4 of 4 API keys</p>
  </div>
</div>
