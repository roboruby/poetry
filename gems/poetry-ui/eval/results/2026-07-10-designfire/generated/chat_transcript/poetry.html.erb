<div class="mx-auto max-w-2xl space-y-6 p-6">
  <header class="space-y-1">
    <h1 class="text-2xl font-semibold tracking-tight">Support conversation</h1>
    <p class="text-sm text-muted-foreground">Ticket #4821 · Billing question</p>
  </header>

  <%= poetry_message_scroller(id: "chat-transcript", default_scroll_position: :end) do %>
    <%= poetry_message_scroller_item(id: "divider-today") do %>
      <div class="flex justify-center py-2">
        <%= poetry_marker(variant: :separator) { "Today" } %>
      </div>
    <% end %>

    <%= poetry_message_scroller_item(id: "msg-1") do %>
      <%= poetry_message(align: :start) do |m| %>
        <% m.with_avatar do %>
          <%= poetry_avatar(label: "Aria, support assistant", size: :sm) { "AI" } %>
        <% end %>
        <% m.with_header { "Aria · Support assistant" } %>
        <% m.with_footer { "9:41 AM" } %>

        <%= poetry_bubble_group do %>
          <%= poetry_bubble(variant: :default) do %>
            I found your invoice from last month - I've attached the PDF below. Let me know if the totals look right.
          <% end %>

          <%= poetry_attachment(orientation: :horizontal, size: :default, state: :done) do |a| %>
            <% a.with_media(variant: :icon) { poetry_icon(name: :"file-text") } %>
            <% a.with_title { "Invoice-2216.pdf" } %>
            <% a.with_description { "284 KB" } %>
            <% a.with_action(label: "Download") { poetry_icon(name: :download) } %>
          <% end %>

          <%= poetry_bubble(tag: :a, href: "#chat-transcript", variant: :outline) { "That looks right, thanks!" } %>
        <% end %>
      <% end %>
    <% end %>

    <%= poetry_message_scroller_item(id: "thinking") do %>
      <%= poetry_marker(variant: :default, announce: :status) do |mk| %>
        <% mk.with_icon(name: :"loader-circle") %>
        Aria is thinking…
      <% end %>
    <% end %>
  <% end %>
</div>
