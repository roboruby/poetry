<div class="mx-auto max-w-2xl p-6">
  <%= poetry_card do |card| %>
    <% card.with_title { "Fetching results" } %>

    <div class="space-y-4" aria-busy="true" aria-live="polite">
      <%= poetry_spinner(label: "Loading results…") %>

      <div class="flex items-center gap-4 rounded-md border p-3">
        <%= poetry_skeleton(class: "h-10 w-10 shrink-0 rounded-full") %>
        <div class="flex-1 space-y-2">
          <%= poetry_skeleton(class: "h-4 w-3/4") %>
          <%= poetry_skeleton(class: "h-4 w-1/2") %>
        </div>
      </div>

      <%= poetry_separator %>

      <p class="flex items-center gap-2 text-sm text-muted-foreground">
        <span>Press</span>
        <span class="inline-flex items-center gap-1">
          <%= poetry_kbd { "⌘" } %>
          <%= poetry_kbd { "K" } %>
        </span>
        <span>to jump to a result while you wait.</span>
      </p>
    </div>
  <% end %>
</div>
