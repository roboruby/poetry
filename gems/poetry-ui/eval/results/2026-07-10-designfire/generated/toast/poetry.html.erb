<div class="mx-auto max-w-xl p-6">
  <div class="mb-6 space-y-1">
    <h2 class="text-2xl font-semibold tracking-tight">Notifications</h2>
    <p class="text-sm text-muted-foreground">Recent activity from your account appears here.</p>
  </div>

  <%= poetry_toaster(position: :"top-right") do %>
    <%= poetry_toast(variant: :success) do |t| %>
      <% t.with_title { "Saved" } %>
      <% t.with_description { "Your changes have been saved." } %>
    <% end %>

    <%= poetry_toast(variant: :destructive) do |t| %>
      <% t.with_title { "Payment failed" } %>
      <% t.with_description { "We couldn't charge your card on file. Please try again." } %>
      <% t.with_action do %>
        <%= poetry_button(label: "Retry", size: :sm, variant: :outline) %>
      <% end %>
    <% end %>
  <% end %>
</div>
