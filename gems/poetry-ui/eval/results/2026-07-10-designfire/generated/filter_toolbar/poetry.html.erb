<div class="mx-auto max-w-5xl p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= poetry_label(for_id: "toolbar-search", class: "sr-only") { "Search" } %>
    <%= poetry_input_group(class: "w-full max-w-sm") do %>
      <%= poetry_input_group_addon do %>
        <%= poetry_icon(name: :search) %>
      <% end %>
      <%= poetry_input_group_input(id: "toolbar-search", name: "q", placeholder: "Search…") %>
      <%= poetry_input_group_addon(align: :"inline-end") do %>
        <span class="inline-flex items-center gap-0.5">
          <%= poetry_kbd { "⌘" } %>
          <%= poetry_kbd { "K" } %>
        </span>
      <% end %>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= poetry_label(for_id: "toolbar-sort", class: "sr-only") { "Sort by" } %>
      <%= poetry_select(name: "sort", id: "toolbar-sort", value: "newest") do |select| %>
        <% select.with_trigger { "Sort by" } %>
        <% select.with_item(value: "newest") { "Newest first" } %>
        <% select.with_item(value: "oldest") { "Oldest first" } %>
        <% select.with_item(value: "name-asc") { "Name (A–Z)" } %>
        <% select.with_item(value: "name-desc") { "Name (Z–A)" } %>
      <% end %>

      <%= poetry_toggle_group(type: :single, value: "list", size: :sm, variant: :outline, label: "View") do |group| %>
        <% group.with_item(value: "list", label: "List view") do %>
          <%= poetry_icon(name: :list) %>
        <% end %>
        <% group.with_item(value: "grid", label: "Grid view") do %>
          <%= poetry_icon(name: :"layout-grid") %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
