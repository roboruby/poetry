<div class="mx-auto flex max-w-3xl items-center justify-center px-6 py-24">
  <%= poetry_empty(media_variant: :icon) do |empty| %>
    <% empty.with_media do %>
      <%= poetry_icon(name: :"folder-plus", label: "No projects") %>
    <% end %>
    <% empty.with_title { "No projects yet" } %>
    <% empty.with_description do %>
      Create your first project to start organizing your work, or import
      an existing one to pick up right where you left off.
    <% end %>

    <div class="flex items-center justify-center gap-2">
      <%= poetry_button(variant: :default) { "Create project" } %>
      <%= poetry_button(variant: :outline) { "Import project" } %>
    </div>
  <% end %>
</div>
