<div class="mx-auto max-w-xl p-6">
  <%= poetry_alert(variant: :destructive) do |alert| %>
    <% alert.with_icon(name: "triangle-alert") %>
    <% alert.with_title { "Payment failed" } %>
    <p>We were unable to charge your card ending in 4242. Please update your payment method to avoid a lapse in service.</p>
  <% end %>
</div>
