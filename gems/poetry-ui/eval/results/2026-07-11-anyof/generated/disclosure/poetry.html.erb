<div class="mx-auto max-w-3xl space-y-8 p-6">
  <div class="space-y-1">
    <h1 class="text-2xl font-semibold tracking-tight">Frequently asked questions</h1>
    <p class="text-sm text-muted-foreground">
      Answers to the questions we hear most often. Can't find what you're
      looking for? Contact support and we'll help you out.
    </p>
  </div>

  <%= poetry_accordion(collapsible: true, open: %w[shipping]) do |accordion| %>
    <% accordion.with_item(value: "shipping", title: "How long does shipping take?") do %>
      <p class="text-sm text-muted-foreground">
        Standard orders arrive within 3-5 business days. Expedited shipping
        is available at checkout and typically arrives within 1-2 business
        days. You'll receive a tracking link by email as soon as your order
        ships.
      </p>
    <% end %>

    <% accordion.with_item(value: "returns", title: "What is your return policy?") do %>
      <p class="text-sm text-muted-foreground">
        We accept returns within 30 days of delivery for a full refund,
        provided the item is unused and in its original packaging. Start a
        return from your order history and we'll email you a prepaid
        shipping label.
      </p>
    <% end %>

    <% accordion.with_item(value: "payment", title: "Which payment methods do you accept?") do %>
      <p class="text-sm text-muted-foreground">
        We accept all major credit cards, PayPal, and Apple Pay. Payment is
        charged when your order ships, not when it's placed.
      </p>
    <% end %>

    <% accordion.with_item(value: "account", title: "Do I need an account to place an order?") do %>
      <p class="text-sm text-muted-foreground">
        No, you can check out as a guest. Creating an account lets you track
        orders, save addresses, and check out faster next time.
      </p>
    <% end %>

    <% accordion.with_item(value: "support", title: "How do I contact support?") do %>
      <p class="text-sm text-muted-foreground">
        Email support@example.com or use the chat widget in the bottom
        corner of any page. Our team typically responds within one business
        day.
      </p>
    <% end %>
  <% end %>

  <div class="border-t border-border pt-6">
    <%= poetry_collapsible(open: false) do |collapsible| %>
      <% collapsible.with_trigger { "Show advanced options" } %>

      <div class="mt-4 space-y-4 rounded-lg border border-border bg-muted/50 p-4">
        <%= poetry_checkbox(name: "search[include_archived]", label: "Include archived results") %>
        <%= poetry_checkbox(name: "search[case_sensitive]", label: "Case-sensitive matching") %>

        <%= poetry_field(id: "advanced-timeout", label_text: "Request timeout (seconds)", hint: "Defaults to 30 seconds") do |field| %>
          <%= poetry_input(**field.control_attributes, name: "search[timeout]", type: "number", value: "30") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
