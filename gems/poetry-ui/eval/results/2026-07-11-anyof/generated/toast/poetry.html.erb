<div class="mx-auto max-w-md p-6">
  <div class="flex flex-col gap-3" role="region" aria-label="Notifications">
    <%= poetry_toast(variant: :success) do |t| %>
      <% t.with_title { "Saved" } %>
      <% t.with_description { "Your changes have been saved." } %>
    <% end %>

    <%= poetry_toast(variant: :destructive) do |t| %>
      <% t.with_title { "Payment failed" } %>
      <% t.with_description { "We couldn't process your payment. Please try again." } %>
      <% t.with_action(variant: :outline, size: :sm) { "Retry" } %>
    <% end %>
  </div>
</div>
