<div class="mx-auto max-w-3xl p-6">
  <%= poetry_empty(media_variant: :icon, title_tag: :h2) do |empty| %>
    <% empty.with_media do %>
      <%= poetry_icon(name: :"folder-plus", label: "Projects") %>
    <% end %>
    <% empty.with_title { "No projects yet" } %>
    <% empty.with_description { "Create your first project to start organizing your work, or import an existing one to pick up right where you left off." } %>

    <div class="flex items-center justify-center gap-3">
      <%= poetry_button(variant: :default) { "Create project" } %>
      <%= poetry_button(variant: :outline) { "Import project" } %>
    </div>
  <% end %>
</div>
