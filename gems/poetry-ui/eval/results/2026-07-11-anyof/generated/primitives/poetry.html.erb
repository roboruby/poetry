<div class="mx-auto max-w-xl p-6">
  <%= poetry_card(title_tag: :h2) do |card| %>
    <% card.with_title { "Search results" } %>
    <% card.with_description { "Fetching the latest matches for your query." } %>

    <div class="space-y-6" aria-busy="true">
      <div class="flex items-center gap-3">
        <%= poetry_spinner(label: "Fetching results…") %>
        <span class="text-sm text-muted-foreground">Fetching results…</span>
      </div>

      <div class="flex items-center gap-3">
        <%= poetry_skeleton(class: "h-10 w-10 shrink-0 rounded-full") %>
        <div class="flex-1 space-y-2">
          <%= poetry_skeleton(class: "h-4 w-3/4") %>
          <%= poetry_skeleton(class: "h-4 w-1/2") %>
        </div>
      </div>
    </div>

    <% card.with_footer do %>
      <div class="flex w-full flex-col gap-3">
        <%= poetry_separator %>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <span>Press</span>
          <span class="inline-flex items-center gap-1">
            <%= poetry_kbd { "⌘" } %>
            <%= poetry_kbd { "K" } %>
          </span>
          <span>to search again</span>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
