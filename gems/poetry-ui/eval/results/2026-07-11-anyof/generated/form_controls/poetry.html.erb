<div class="mx-auto max-w-2xl p-6">
  <%= poetry_card do |card| %>
    <% card.with_title { "Notification settings" } %>
    <% card.with_description { "Manage how and when you hear from us." } %>

    <div class="space-y-8">
      <%= form_with url: "#", method: :patch, local: true, class: "space-y-8" do %>
        <div class="space-y-6">
          <%= poetry_field(id: "accept_terms", label_text: "Accept terms", hint: "Review the updated notification terms, then save to apply.") do |field| %>
            <%= poetry_checkbox(**field.control_attributes, name: "accept_terms", label: "I agree to the updated notification terms") %>
          <% end %>

          <%= poetry_field(id: "digest_frequency", label_text: "Digest frequency", hint: "How often we bundle notifications into a single email.") do |field| %>
            <%= poetry_radio_group(**field.control_attributes, name: "digest_frequency", label: "Digest frequency", value: "weekly", orientation: :horizontal) do |group| %>
              <% group.with_item(value: "daily", label: "Daily") %>
              <% group.with_item(value: "weekly", label: "Weekly") %>
              <% group.with_item(value: "monthly", label: "Monthly") %>
              <% group.with_item(value: "never", label: "Never") %>
            <% end %>
          <% end %>

          <%= poetry_field(id: "alert_volume", label_text: "Alert volume", hint: "How loud push and in-app alerts sound.") do |field| %>
            <%= poetry_slider(**field.control_attributes, name: "alert_volume", min: 0, max: 100, step: 5, value: 60, label: "Alert volume", value_text: "60%") %>
          <% end %>

          <%= poetry_field(id: "unsubscribe_note", label_text: "Unsubscribe note", hint: "Optional — tell us why you're opting out of specific alerts.") do |field| %>
            <%= poetry_textarea(**field.control_attributes, name: "unsubscribe_note", placeholder: "Let us know why you're unsubscribing…", rows: 4) %>
          <% end %>

          <%= poetry_field(id: "confirmation_code", label_text: "Confirmation code", hint: "Enter the 6-digit code we texted to confirm this device.") do |field| %>
            <%= poetry_input_otp(**field.control_attributes, name: "confirmation_code", length: 6) %>
          <% end %>
        </div>

        <div class="flex justify-end">
          <%= poetry_button(type: :submit) { "Save changes" } %>
        </div>
      <% end %>

      <%= poetry_separator %>

      <%= form_with url: "#", method: :patch, local: true do %>
        <%= poetry_field(id: "email_alerts", label_text: "Email alerts", hint: "Applies immediately — no need to save.") do |field| %>
          <%= poetry_switch(**field.control_attributes, name: "email_alerts", label: "Email alerts", checked: true) %>
        <% end %>
      <% end %>

      <%= poetry_separator %>

      <div class="flex items-center justify-between gap-4">
        <div class="space-y-1">
          <p class="text-sm font-medium">Bookmark this panel</p>
          <p class="text-sm text-muted-foreground">Pin notification settings to your quick-access bar.</p>
        </div>
        <%= poetry_toggle(label: "Bookmark", variant: :outline) do %>
          <%= poetry_icon(name: :bookmark, class: "size-4") %>
        <% end %>
      </div>

      <%= poetry_separator %>

      <div class="flex items-center justify-between gap-4">
        <div class="space-y-1">
          <p class="text-sm font-medium">Notification log view</p>
          <p class="text-sm text-muted-foreground">Switch between list and grid layouts.</p>
        </div>
        <%= poetry_toggle_group(type: :single, value: "list", label: "Notification log view") do |group| %>
          <% group.with_item(value: "list", label: "List view") do %>
            <%= poetry_icon(name: :list, class: "size-4") %>
          <% end %>
          <% group.with_item(value: "grid", label: "Grid view") do %>
            <%= poetry_icon(name: :"layout-grid", class: "size-4") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
