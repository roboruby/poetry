<%
  connected_integrations = [
    { name: "Slack", initial: "S", color: "purple", category: "Communication",
      status: :healthy, message: "All systems operational", last_checked: "2 minutes ago" },
    { name: "GitHub", initial: "G", color: "slate", category: "Developer tools",
      status: :healthy, message: "All systems operational", last_checked: "5 minutes ago" },
    { name: "Stripe", initial: "St", color: "indigo", category: "Payments",
      status: :degraded, message: "Elevated webhook latency", last_checked: "1 minute ago" },
    { name: "Google Analytics", initial: "GA", color: "amber", category: "Analytics",
      status: :error, message: "Authentication token expired", last_checked: "14 minutes ago" },
  ]

  status_styles = {
    healthy:  { dot: "bg-emerald-500",  text: "text-emerald-700",  chip: "bg-emerald-50 ring-emerald-600/20",  label: "Healthy" },
    degraded: { dot: "bg-amber-500",    text: "text-amber-700",    chip: "bg-amber-50 ring-amber-600/20",      label: "Degraded" },
    error:    { dot: "bg-red-500",      text: "text-red-700",      chip: "bg-red-50 ring-red-600/20",          label: "Needs attention" },
  }

  avatar_colors = {
    "purple" => "bg-purple-100 text-purple-700",
    "slate"  => "bg-slate-200 text-slate-700",
    "indigo" => "bg-indigo-100 text-indigo-700",
    "amber"  => "bg-amber-100 text-amber-700",
    "sky"    => "bg-sky-100 text-sky-700",
    "teal"   => "bg-teal-100 text-teal-700",
    "rose"   => "bg-rose-100 text-rose-700",
    "green"  => "bg-green-100 text-green-700",
    "orange" => "bg-orange-100 text-orange-700",
    "blue"   => "bg-blue-100 text-blue-700",
    "cyan"   => "bg-cyan-100 text-cyan-700",
    "violet" => "bg-violet-100 text-violet-700",
  }

  catalog = {
    "Communication" => [
      { name: "Microsoft Teams", initial: "MT", color: "blue", description: "Bring alerts and updates directly into Teams channels." },
      { name: "Discord", initial: "D", color: "violet", description: "Notify community channels about product and status events." },
    ],
    "Payments" => [
      { name: "PayPal", initial: "P", color: "sky", description: "Accept and reconcile PayPal payments alongside existing invoices." },
      { name: "Square", initial: "Sq", color: "green", description: "Sync in-person and online Square transactions automatically." },
    ],
    "Analytics" => [
      { name: "Mixpanel", initial: "M", color: "orange", description: "Track product usage events and funnels in real time." },
      { name: "Segment", initial: "Sg", color: "teal", description: "Route customer data to your entire analytics stack from one source." },
    ],
    "Developer tools" => [
      { name: "GitLab", initial: "GL", color: "orange", description: "Mirror issues and deployments from GitLab pipelines." },
      { name: "Jira", initial: "J", color: "blue", description: "Link tickets and sync status changes with your Jira board." },
      { name: "Webhooks", initial: "W", color: "rose", description: "Send custom event payloads to any HTTPS endpoint you control." },
    ],
  }
%>

<main class="mx-auto max-w-7xl px-6 py-10 space-y-12">
  <header class="space-y-1">
    <h1 class="text-2xl font-semibold text-slate-900">Integrations</h1>
    <p class="text-sm text-slate-500">Connect the tools your team already uses and monitor their health from one place.</p>
  </header>

  <section aria-labelledby="connected-heading" class="space-y-4">
    <div class="flex items-baseline justify-between">
      <h2 id="connected-heading" class="text-lg font-semibold text-slate-900">Connected</h2>
      <span class="text-sm text-slate-500"><%= connected_integrations.size %> active</span>
    </div>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% connected_integrations.each do |integration| %>
        <% style = status_styles.fetch(integration[:status]) %>
        <li class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm font-semibold <%= avatar_colors.fetch(integration[:color]) %>">
                <%= integration[:initial] %>
              </div>
              <div>
                <p class="font-medium text-slate-900"><%= integration[:name] %></p>
                <p class="text-xs text-slate-500"><%= integration[:category] %></p>
              </div>
            </div>
          </div>

          <div class="mt-4 flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-xs font-medium ring-1 ring-inset <%= style[:chip] %> <%= style[:text] %> w-fit">
            <span class="h-1.5 w-1.5 rounded-full <%= style[:dot] %>" aria-hidden="true"></span>
            <%= style[:label] %>
          </div>
          <p class="mt-2 text-sm text-slate-600"><%= integration[:message] %></p>
          <p class="text-xs text-slate-400">Checked <%= integration[:last_checked] %></p>

          <div class="mt-4 flex gap-2 border-t border-slate-100 pt-4">
            <button type="button" class="inline-flex flex-1 items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Manage
            </button>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section aria-labelledby="catalog-heading" class="space-y-6">
    <div class="space-y-1">
      <h2 id="catalog-heading" class="text-lg font-semibold text-slate-900">Available integrations</h2>
      <p class="text-sm text-slate-500">Browse by category and connect a new service in a few clicks.</p>
    </div>

    <div class="space-y-8">
      <% catalog.each do |category, integrations| %>
        <div>
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400"><%= category %></h3>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% integrations.each do |integration| %>
              <li class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm font-semibold <%= avatar_colors.fetch(integration[:color]) %>">
                    <%= integration[:initial] %>
                  </div>
                  <p class="font-medium text-slate-900"><%= integration[:name] %></p>
                </div>
                <p class="mt-3 text-sm text-slate-600"><%= integration[:description] %></p>
                <div class="mt-4">
                  <button type="button" class="inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700">
                    Connect
                  </button>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
</main>
