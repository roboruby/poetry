<%
  today = Date.new(2026, 7, 22)

  services = [
    {
      name: "API",
      description: "Core REST and GraphQL API",
      status: :operational,
      bad_days: [45, 46, 78]
    },
    {
      name: "Web Dashboard",
      description: "Customer-facing web application and admin console",
      status: :operational,
      bad_days: [20]
    },
    {
      name: "Authentication",
      description: "Login, SSO, and token issuance",
      status: :degraded,
      bad_days: [0, 1, 33, 67]
    },
    {
      name: "Database",
      description: "Primary data storage cluster",
      status: :operational,
      bad_days: [58]
    },
    {
      name: "CDN & Edge Network",
      description: "Static asset delivery and edge caching",
      status: :operational,
      bad_days: []
    }
  ]

  status_meta = {
    operational: { label: "Operational", dot: "bg-emerald-500", text: "text-emerald-700", chip: "bg-emerald-50 text-emerald-700 ring-emerald-600/20" },
    degraded:    { label: "Degraded Performance", dot: "bg-amber-500", text: "text-amber-700", chip: "bg-amber-50 text-amber-800 ring-amber-600/20" },
    outage:      { label: "Major Outage", dot: "bg-red-500", text: "text-red-700", chip: "bg-red-50 text-red-700 ring-red-600/20" }
  }

  bar_color = {
    operational: "bg-emerald-500",
    degraded: "bg-amber-400",
    outage: "bg-red-500"
  }

  worst = services.map { |s| s[:status] }.max_by { |s| [:operational, :degraded, :outage].index(s) }
  overall = status_meta[worst]
  overall_ok = worst == :operational
%>
<div class="min-h-screen bg-gray-50 py-10">
  <div class="mx-auto max-w-4xl space-y-8 px-4 sm:px-6 lg:px-8">

    <header class="space-y-1">
      <p class="text-sm font-semibold uppercase tracking-wide text-gray-500">Aurora</p>
      <h1 class="text-2xl font-bold text-gray-900">System Status</h1>
    </header>

    <section
      aria-label="Overall status"
      class="flex items-center gap-4 rounded-xl border px-5 py-4 <%= overall_ok ? "border-emerald-200 bg-emerald-50" : "border-amber-200 bg-amber-50" %>"
    >
      <% if overall_ok %>
        <svg class="h-7 w-7 flex-none text-emerald-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.03 7.28-4.5 4.5a.75.75 0 0 1-1.06 0l-2.5-2.5a.75.75 0 1 1 1.06-1.06l1.97 1.97 3.97-3.97a.75.75 0 1 1 1.06 1.06Z" clip-rule="evenodd" />
        </svg>
      <% else %>
        <svg class="h-7 w-7 flex-none text-amber-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.4 3.36a3 3 0 0 1 5.2 0l7.35 12.8a3 3 0 0 1-2.6 4.5H4.65a3 3 0 0 1-2.6-4.5L9.4 3.36ZM12 8.25a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4a.75.75 0 0 1 .75-.75Zm0 8.25a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <div>
        <p class="text-lg font-semibold <%= overall_ok ? "text-emerald-800" : "text-amber-800" %>">
          <%= overall_ok ? "All Systems Operational" : "Some Systems Are Experiencing Issues" %>
        </p>
        <p class="text-sm <%= overall_ok ? "text-emerald-700" : "text-amber-700" %>">
          Last updated <time datetime="2026-07-22T10:32:00Z">July 22, 2026 at 10:32 UTC</time>
        </p>
      </div>
    </section>

    <section aria-labelledby="services-heading" class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 id="services-heading" class="text-base font-semibold text-gray-900">Services</h2>
      </div>

      <ul class="divide-y divide-gray-100">
        <% services.each do |service| %>
          <%
            meta = status_meta[service[:status]]
            day_statuses = Array.new(90) do |days_ago|
              if service[:bad_days].include?(days_ago)
                :degraded
              else
                :operational
              end
            end
            credit = day_statuses.sum { |s| s == :operational ? 1.0 : 0.5 }
            uptime_pct = (credit / 90 * 100).round(2)
          %>
          <li class="px-5 py-4">
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-2.5">
                <span class="h-2.5 w-2.5 flex-none rounded-full <%= meta[:dot] %>" aria-hidden="true"></span>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= service[:name] %></p>
                  <p class="text-xs text-gray-500"><%= service[:description] %></p>
                </div>
              </div>
              <span class="inline-flex flex-none items-center rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset <%= meta[:chip] %>">
                <%= meta[:label] %>
              </span>
            </div>

            <div class="mt-3">
              <div class="flex h-8 items-end gap-[2px]" role="img" aria-label="<%= service[:name] %> uptime over the last 90 days, currently <%= uptime_pct %> percent">
                <% day_statuses.each_with_index do |status, idx| %>
                  <%
                    days_ago = 89 - idx
                    day_date = today - days_ago
                  %>
                  <span
                    class="h-full flex-1 rounded-sm <%= bar_color[status] %>"
                    title="<%= day_date.strftime("%b %-d, %Y") %> · <%= status_meta[status][:label] %>"
                  ></span>
                <% end %>
              </div>
              <div class="mt-1.5 flex items-center justify-between text-xs text-gray-400">
                <span>90 days ago</span>
                <span class="font-medium text-gray-600"><%= uptime_pct %>% uptime</span>
                <span>Today</span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <section aria-labelledby="incident-heading" class="rounded-xl border border-amber-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-amber-100 bg-amber-50 px-5 py-4 rounded-t-xl">
        <h2 id="incident-heading" class="text-base font-semibold text-gray-900">Elevated authentication latency</h2>
        <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
          Monitoring
        </span>
      </div>

      <div class="px-5 py-4">
        <p class="text-sm text-gray-600">
          Affected components:
          <span class="font-medium text-gray-800">Authentication</span>
        </p>

        <ol class="mt-4 space-y-5 border-l border-gray-200 pl-5">
          <li class="relative">
            <span class="absolute -left-[25px] top-1 h-3 w-3 rounded-full border-2 border-white bg-blue-500 ring-1 ring-blue-500"></span>
            <p class="text-sm font-medium text-blue-700">Monitoring</p>
            <time datetime="2026-07-22T10:32:00Z" class="block text-xs text-gray-400">July 22, 2026 at 10:32 UTC</time>
            <p class="mt-1 text-sm text-gray-700">A fix has been deployed and sign-in latency has returned to normal levels. We are continuing to monitor the authentication service closely before marking this incident resolved.</p>
          </li>
          <li class="relative">
            <span class="absolute -left-[25px] top-1 h-3 w-3 rounded-full border-2 border-white bg-orange-500 ring-1 ring-orange-500"></span>
            <p class="text-sm font-medium text-orange-700">Identified</p>
            <time datetime="2026-07-22T09:47:00Z" class="block text-xs text-gray-400">July 22, 2026 at 09:47 UTC</time>
            <p class="mt-1 text-sm text-gray-700">The issue has been traced to a degraded database replica serving the authentication service. We are routing traffic to healthy replicas and applying a fix.</p>
          </li>
          <li class="relative">
            <span class="absolute -left-[25px] top-1 h-3 w-3 rounded-full border-2 border-white bg-red-500 ring-1 ring-red-500"></span>
            <p class="text-sm font-medium text-red-700">Investigating</p>
            <time datetime="2026-07-22T09:14:00Z" class="block text-xs text-gray-400">July 22, 2026 at 09:14 UTC</time>
            <p class="mt-1 text-sm text-gray-700">We are investigating reports of elevated latency and intermittent sign-in errors affecting a subset of users.</p>
          </li>
        </ol>
      </div>
    </section>

    <section aria-labelledby="subscribe-heading" class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <h2 id="subscribe-heading" class="text-base font-semibold text-gray-900">Subscribe to updates</h2>
      <p class="mt-1 text-sm text-gray-500">Get notified by email when we create, update, or resolve an incident.</p>

      <form action="#" method="post" class="mt-4 flex flex-col gap-2 sm:flex-row">
        <label for="subscriber_email" class="sr-only">Email address</label>
        <input
          id="subscriber_email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
          class="w-full rounded-lg border border-gray-300 px-3.5 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 sm:max-w-xs"
        >
        <button
          type="submit"
          class="inline-flex flex-none items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50"
        >
          Subscribe
        </button>
      </form>

      <details class="mt-4 group">
        <summary class="cursor-pointer text-sm font-medium text-indigo-600 hover:text-indigo-500 list-none flex items-center gap-1">
          <svg class="h-4 w-4 transition-transform group-open:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
          </svg>
          Other ways to subscribe
        </summary>
        <ul class="mt-3 space-y-2 pl-5 text-sm text-gray-600">
          <li>RSS feed — <span class="text-gray-500">/history.rss</span></li>
          <li>Atom feed — <span class="text-gray-500">/history.atom</span></li>
          <li>Webhook — configure a URL to receive incident payloads</li>
        </ul>
      </details>
    </section>

    <footer class="pb-4 text-center text-xs text-gray-400">
      <p>All times shown in UTC. Uptime is calculated over the trailing 90 days.</p>
    </footer>

  </div>
</div>
