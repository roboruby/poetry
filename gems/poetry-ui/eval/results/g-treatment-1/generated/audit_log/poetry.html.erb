            <%= poetry_table_row do %>
              <%= poetry_table_head { "Severity" } %>
              <%= poetry_table_head { "Event" } %>
              <%= poetry_table_head { "Actor" } %>
              <%= poetry_table_head { "Location" } %>
              <%= poetry_table_head(class: "text-right") { "Time" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell { poetry_badge(variant: :outline) { "Low" } } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">Signed in</div>
              <% end %>
              <%= poetry_table_cell do %>
                <div class="flex items-center gap-2">
                  <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
