                </div>
              <% end %>
              <%= poetry_table_cell do %>
                <div class="space-y-0.5">
                  <div>San Francisco, US</div>
                  <div class="font-mono text-xs text-muted-foreground">203.0.113.42</div>
                </div>
              <% end %>
              <%= poetry_table_cell(class: "text-right tabular-nums") { "9:14 AM" } %>
            <% end %>
            <%= poetry_table_row do %>
              <%= poetry_table_cell { poetry_badge(variant: :warning) { "High" } } %>
              <%= poetry_table_cell do %>
                <div class="font-medium">Failed sign-in attempt</div>
