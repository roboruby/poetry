<section class="space-y-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Acme Workspace", href: "#") %>
      <% crumb.with_item("Settings", href: "#") %>
      <% crumb.with_item("Audit log") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
        <p class="text-sm text-muted-foreground">Security-relevant activity across Acme Workspace &mdash; who did what, when, and from where.</p>
      </div>
      <div class="flex items-center gap-2">
        <%= poetry_button(variant: :outline) do |button| %>
          <% button.with_leading { poetry_icon(name: :download) } %>
          Export CSV
        <% end %>
      </div>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= poetry_card do %>
      <%= poetry_stat(label: "Events (30d)") { "87" } %>
    <% end %>
    <%= poetry_card do %>
      <%= poetry_stat(label: "Critical events") { "4" } %>
    <% end %>
    <%= poetry_card do %>
      <%= poetry_stat(label: "Failed sign-ins") { "9" } %>
    <% end %>
    <%= poetry_card do %>
      <%= poetry_stat(label: "Active actors") { "6" } %>
    <% end %>
  </div>

  <%= form_tag "", method: :get, class: "flex flex-wrap items-end gap-3" do %>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-search", class: "sr-only") { "Search events" } %>
      <%= poetry_input_group(class: "w-64") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :search) %>
        <% end %>
        <%= poetry_input_group_input(id: "audit-search", name: "q", placeholder: "Search by actor, action, or IP…") %>
      <% end %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-severity", class: "sr-only") { "Filter by severity" } %>
      <%= poetry_native_select(name: "severity", id: "audit-severity",
                               options: [["All severities", "all"], ["Critical", "critical"],
                                         ["High", "high"], ["Medium", "medium"], ["Low", "low"]]) %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-event-type", class: "sr-only") { "Filter by event type" } %>
      <%= poetry_native_select(name: "event_type", id: "audit-event-type",
                               options: [["All event types", "all"], ["Authentication", "authentication"],
                                         ["Access & permissions", "access"], ["Data & exports", "data"],
                                         ["Workspace settings", "settings"], ["Billing", "billing"]]) %>
    </div>
    <div class="space-y-1.5">
      <%= poetry_label(for_id: "audit-range", class: "sr-only") { "Filter by date range" } %>
      <%= poetry_native_select(name: "range", id: "audit-range",
                               options: [["Last 30 days", "30d"], ["Today", "today"],
                                         ["Last 7 days", "7d"], ["All time", "all"]]) %>
    </div>
    <%= poetry_button(type: :submit) { "Filter" } %>
    <%= poetry_link(href: "", underline: :hover, class: "text-sm mb-2.5") { "Clear filters" } %>
  <% end %>

  <div class="space-y-8">
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <h2 class="whitespace-nowrap text-sm font-semibold uppercase tracking-wide text-muted-foreground">Today &middot; July 22, 2026</h2>
        <%= poetry_badge(variant: :secondary) { "5 events" } %>
        <%= poetry_separator(class: "flex-1") %>
      </div>
      <div class="overflow-hidden rounded-lg border">
        <%= poetry_table do %>
