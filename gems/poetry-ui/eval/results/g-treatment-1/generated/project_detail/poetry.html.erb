<div class="mx-auto max-w-5xl space-y-8 p-6">
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Home", href: "/") %>
    <% crumb.with_item("Projects", href: "/projects") %>
    <% crumb.with_item("Atlas Redesign") %>
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="max-w-2xl space-y-2">
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Atlas Redesign</h1>
        <%= poetry_badge(variant: :success) { "On track" } %>
      </div>
      <p class="text-sm text-muted-foreground">
        Rebuilding the Atlas customer portal on the new design system, with a phased
        rollout across web and mobile through the end of the year.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= poetry_button(variant: :outline, href: "#") do |button| %>
        <% button.with_leading { poetry_icon(name: :pencil) } %>
        Edit project
      <% end %>
      <%= poetry_button(variant: :outline, href: "#") do |button| %>
        <% button.with_leading { poetry_icon(name: :archive) } %>
        Archive
      <% end %>
    </div>
  </div>

  <%= poetry_separator %>

  <%= poetry_card do |card| %>
    <% card.with_title { "Owner & key dates" } %>
    <%= poetry_metadata_list(columns: :three, orientation: :vertical) do |list| %>
      <% list.with_item(label: "Owner") do %>
        <div class="flex items-center gap-2">
          <%= poetry_avatar(label: "Priya Anand", size: :sm) { "PA" } %>
          <span>Priya Anand</span>
        </div>
      <% end %>
      <% list.with_item(label: "Start date") do %>
        Jan 12, 2026
      <% end %>
      <% list.with_item(label: "Target date") do %>
        Sep 30, 2026
      <% end %>
      <% list.with_item(label: "Last updated") do %>
        Jul 18, 2026
      <% end %>
    <% end %>
  <% end %>

  <div>
    <h2 class="mb-4 text-lg font-semibold tracking-tight">Milestone timeline</h2>
    <%= poetry_timeline do |t| %>
      <% t.with_item(title: "Discovery & scoping", time: "Jan 2026", completed: true) do %>
        Stakeholder interviews and technical audit completed.
      <% end %>
      <% t.with_item(title: "Design system alignment", time: "Mar 2026", completed: true) do %>
        Shared component library adopted across web surfaces.
      <% end %>
      <% t.with_item(title: "Web rollout", time: "Jun 2026", completed: true) do %>
        Portal redesign shipped to 100% of web traffic.
      <% end %>
      <% t.with_item(title: "Mobile rollout", time: "Sep 2026") do %>
        iOS and Android apps switch to the new experience.
      <% end %>
      <% t.with_item(title: "Legacy sunset", time: "Nov 2026") do %>
        Old portal decommissioned for all customers.
      <% end %>
    <% end %>
  </div>

  <div>
    <h2 class="mb-4 text-lg font-semibold tracking-tight">Recent tasks</h2>
    <%= poetry_table do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Task" } %>
          <%= poetry_table_head { "Assignee" } %>
          <%= poetry_table_head { "Due date" } %>
          <%= poetry_table_head { "Status" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Finalize onboarding flow copy" } %>
          <%= poetry_table_cell { "Priya Anand" } %>
          <%= poetry_table_cell { "Jul 24, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :warning) { "In progress" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Wire up billing metering events" } %>
          <%= poetry_table_cell { "Marcus Webb" } %>
          <%= poetry_table_cell { "Jul 26, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Not started" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "QA pass on mobile settings screen" } %>
          <%= poetry_table_cell { "Dana Lindqvist" } %>
          <%= poetry_table_cell { "Jul 29, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :warning) { "In progress" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Write release notes for v2.4" } %>
          <%= poetry_table_cell { "Priya Anand" } %>
          <%= poetry_table_cell { "Aug 1, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Not started" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Accessibility audit of checkout" } %>
          <%= poetry_table_cell { "Marcus Webb" } %>
          <%= poetry_table_cell { "Aug 5, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Done" } } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
