              <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700">Failed</span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
              <span class="text-gray-300">Download</span>
            </td>
          </tr>
          <tr>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><time datetime="2026-04-14">Apr 14, 2026</time></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">Business plan &mdash; monthly</td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">$149.00</td>
            <td class="whitespace-nowrap px-6 py-4">
              <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">Paid</span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
              <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">Download</a>
            </td>
          </tr>
          <tr>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><time datetime="2026-03-14">Mar 14, 2026</time></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">Business plan &mdash; monthly</td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">$149.00</td>
