<div class="mx-auto max-w-6xl px-6 py-10">
  <header class="mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Billing</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your plan, payment method, usage, and invoices for the Acme Robotics workspace.</p>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Current plan -->
    <section aria-labelledby="plan-heading" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="plan-heading" class="text-sm font-medium text-gray-500">Current plan</h2>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="text-xl font-semibold text-gray-900">Business</span>
            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">Active</span>
          </div>
          <p class="mt-1 text-sm text-gray-500">$149/month &middot; billed monthly &middot; renews on <time datetime="2026-08-14">August 14, 2026</time></p>
        </div>
        <div class="flex shrink-0 gap-2">
          <a href="#" class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Change plan</a>
          <a href="#" class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50">Cancel plan</a>
        </div>
      </div>
    </section>

    <!-- Payment method -->
    <section aria-labelledby="payment-heading" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <h2 id="payment-heading" class="text-sm font-medium text-gray-500">Payment method</h2>
        <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">Update</a>
      </div>
      <div class="mt-3 flex items-center gap-3">
        <div class="flex h-8 w-12 items-center justify-center rounded bg-gray-900 text-[10px] font-bold tracking-wide text-white">VISA</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Visa ending in 4242</p>
          <p class="text-sm text-gray-500">Expires 09/2028</p>
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500">Billing address on file: 500 Market St, Suite 400, San Francisco, CA 94105</p>
    </section>
  </div>

  <!-- Usage this period -->
  <section aria-labelledby="usage-heading" class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex items-baseline justify-between">
      <h2 id="usage-heading" class="text-sm font-medium text-gray-500">Usage this period</h2>
      <p class="text-xs text-gray-500">Jul 14 &ndash; Aug 14, 2026</p>
    </div>

    <dl class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div>
        <div class="flex items-baseline justify-between">
          <dt class="text-sm text-gray-700">Team seats</dt>
          <dd class="text-sm text-gray-500">18 of 25</dd>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-100" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100" aria-label="Team seats used">
          <div class="h-full rounded-full bg-indigo-600" style="width: 72%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <dt class="text-sm text-gray-700">API requests</dt>
          <dd class="text-sm text-gray-500">842K of 1M</dd>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-100" role="progressbar" aria-valuenow="84" aria-valuemin="0" aria-valuemax="100" aria-label="API requests used">
          <div class="h-full rounded-full bg-amber-500" style="width: 84%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <dt class="text-sm text-gray-700">Storage</dt>
          <dd class="text-sm text-gray-500">210 GB of 500 GB</dd>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-100" role="progressbar" aria-valuenow="42" aria-valuemin="0" aria-valuemax="100" aria-label="Storage used">
          <div class="h-full rounded-full bg-emerald-500" style="width: 42%"></div>
        </div>
      </div>
    </dl>

    <p class="mt-4 text-xs text-gray-500">Approaching the API request limit for this period &mdash; consider upgrading if usage continues to grow. <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500">View plan limits</a></p>
  </section>

  <!-- Invoice history -->
  <section aria-labelledby="invoices-heading" class="mt-6 rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 p-6">
      <h2 id="invoices-heading" class="text-sm font-medium text-gray-500">Invoice history</h2>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
