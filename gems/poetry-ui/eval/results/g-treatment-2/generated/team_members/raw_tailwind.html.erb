            </svg>
          </div>
          <div>
            <div class="text-sm font-medium text-gray-900">hana@northbeam.co</div>
            <div class="text-sm text-gray-500">Invited as Member &middot; sent 2 days ago</div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="hidden items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 sm:inline-flex">Pending</span>
          <form method="post" action="#">
            <button type="submit" class="rounded-md px-3 py-1.5 text-sm font-medium text-indigo-600 hover:bg-indigo-50">Resend</button>
          </form>
          <form method="post" action="#">
