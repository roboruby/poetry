          </tr>

          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-violet-100 text-sm font-semibold text-violet-700">GR</div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Grace Reyes</div>
                  <div class="text-sm text-gray-500">grace@northbeam.co</div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-700">Viewer</span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500">Active 3 weeks ago</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pending invitations -->
  <div class="space-y-4">
    <h2 class="text-sm font-semibold text-gray-900">Pending invitations <span class="font-normal text-gray-400">(3)</span></h2>

    <ul class="divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 bg-white">
