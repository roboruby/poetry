                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-rose-100 text-sm font-semibold text-rose-700">PC</div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Priya Chandran</div>
                  <div class="text-sm text-gray-500">priya@northbeam.co</div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
