                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-semibold text-sky-700">OA</div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Omar Ahmadi</div>
                  <div class="text-sm text-gray-500">omar@northbeam.co</div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">Member</span>
