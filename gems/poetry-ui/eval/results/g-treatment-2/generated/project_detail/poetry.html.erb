<div class="mx-auto max-w-6xl space-y-8 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Projects", href: "/projects") %>
      <% crumb.with_item("Atlas Platform Migration") %>
    <% end %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-2xl space-y-2">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-semibold tracking-tight">Atlas Platform Migration</h1>
          <%= poetry_badge(variant: :info) { "In progress" } %>
        </div>
        <p class="text-sm text-muted-foreground">
          Migrate core billing services off the legacy monolith onto the Atlas platform, with zero downtime for
          existing subscriptions and a full audit trail for finance.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= poetry_button(variant: :outline, href: "/projects/atlas-platform-migration/edit") do |button| %>
          <% button.with_leading { poetry_icon(name: :pencil) } %>
          Edit
        <% end %>
        <%= poetry_alert_dialog do |dialog| %>
          <% dialog.with_trigger(variant: :outline) do %>
            <%= poetry_icon(name: :archive) %>
            Archive
          <% end %>
          <% dialog.with_title { "Archive this project?" } %>
          <% dialog.with_description do %>
            Atlas Platform Migration will move out of your active projects list. Tasks and milestones stay intact
            and you can restore it from the archive at any time.
          <% end %>
          <% dialog.with_cancel(variant: :outline) { "Cancel" } %>
          <% dialog.with_action(variant: :destructive) { "Archive project" } %>
        <% end %>
      </div>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:order-2 lg:col-span-1">
      <%= poetry_card do |card| %>
        <% card.with_title { "Overview" } %>
        <% card.with_description { "Owner and key dates" } %>
        <%= poetry_metadata_list(orientation: :horizontal, columns: :one) do |list| %>
          <% list.with_item(label: "Owner") do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
              <span>Priya Shah</span>
            </div>
          <% end %>
          <% list.with_item(label: "Start date") { "Jan 6, 2026" } %>
          <% list.with_item(label: "Target date") { "Sep 30, 2026" } %>
          <% list.with_item(label: "Created") { "Dec 2, 2025" } %>
          <% list.with_item(label: "Last updated") { "Jul 20, 2026" } %>
        <% end %>
      <% end %>
    </div>

    <div class="space-y-6 lg:order-1 lg:col-span-2">
      <%= poetry_card do |card| %>
        <% card.with_title { "Milestones" } %>
        <% card.with_description { "Progress toward general availability" } %>
        <%= poetry_timeline do |timeline| %>
          <% timeline.with_item(title: "Kickoff & discovery", time: "Jan 6, 2026", completed: true) do %>
            Requirements gathered from finance and support; migration scope locked.
          <% end %>
          <% timeline.with_item(title: "Architecture review", time: "Mar 3, 2026", completed: true) do %>
            Platform team signed off on the dual-write strategy and rollback plan.
          <% end %>
          <% timeline.with_item(title: "Beta rollout", time: "Aug 15, 2026", completed: false) do %>
            Cut over a 5% subscriber cohort behind a feature flag.
          <% end %>
          <% timeline.with_item(title: "General availability", time: "Sep 30, 2026", completed: false) do %>
            Full cutover and decommission of the legacy billing service.
          <% end %>
        <% end %>
      <% end %>

      <%= poetry_card do |card| %>
        <% card.with_title { "Recent tasks" } %>
        <% card.with_description { "The five most recently updated tasks" } %>
        <div class="overflow-hidden rounded-lg border">
          <%= poetry_table do %>
            <%= poetry_table_caption(class: "sr-only") { "Five most recent tasks with assignee, due date, and status." } %>
            <%= poetry_table_header do %>
              <%= poetry_table_row do %>
                <%= poetry_table_head { "Task" } %>
                <%= poetry_table_head { "Assignee" } %>
                <%= poetry_table_head { "Due date" } %>
                <%= poetry_table_head(class: "text-right") { "Status" } %>
              <% end %>
            <% end %>
            <%= poetry_table_body do %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "font-medium") { "Migrate billing service to v2 schema" } %>
                <%= poetry_table_cell do %>
                  <div class="flex items-center gap-2">
                    <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
                    <span>Priya Shah</span>
                  </div>
                <% end %>
                <%= poetry_table_cell { "Jul 25, 2026" } %>
                <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :info) { "In progress" } } %>
              <% end %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "font-medium") { "Write rollback runbook" } %>
                <%= poetry_table_cell do %>
                  <div class="flex items-center gap-2">
                    <%= poetry_avatar(label: "Devon Ruiz", size: :sm) { "DR" } %>
                    <span>Devon Ruiz</span>
                  </div>
                <% end %>
                <%= poetry_table_cell { "Jul 28, 2026" } %>
                <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :secondary) { "Not started" } } %>
              <% end %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "font-medium") { "QA regression pass" } %>
                <%= poetry_table_cell do %>
                  <div class="flex items-center gap-2">
                    <%= poetry_avatar(label: "Mina Osei", size: :sm) { "MO" } %>
                    <span>Mina Osei</span>
                  </div>
                <% end %>
                <%= poetry_table_cell { "Aug 1, 2026" } %>
                <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :destructive) { "Blocked" } } %>
              <% end %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "font-medium") { "Update customer-facing docs" } %>
                <%= poetry_table_cell do %>
                  <div class="flex items-center gap-2">
                    <%= poetry_avatar(label: "Devon Ruiz", size: :sm) { "DR" } %>
                    <span>Devon Ruiz</span>
                  </div>
                <% end %>
                <%= poetry_table_cell { "Aug 4, 2026" } %>
                <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :secondary) { "Not started" } } %>
              <% end %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "font-medium") { "Load test staging environment" } %>
                <%= poetry_table_cell do %>
                  <div class="flex items-center gap-2">
                    <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
                    <span>Priya Shah</span>
                  </div>
                <% end %>
                <%= poetry_table_cell { "Aug 8, 2026" } %>
                <%= poetry_table_cell(class: "text-right") { poetry_badge(variant: :info) { "In progress" } } %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
