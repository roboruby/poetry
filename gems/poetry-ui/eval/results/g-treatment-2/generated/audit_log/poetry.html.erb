<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
      <p class="text-sm text-muted-foreground">Security-relevant activity across the Northwind workspace.</p>
    </div>
    <%= poetry_button(tag: :a, href: "?format=csv", variant: :outline) do |button| %>
      <% button.with_leading { poetry_icon(name: :download) } %>
      Export
    <% end %>
  </div>

  <form method="get" class="flex flex-wrap items-center gap-3 rounded-lg border p-3">
    <%= poetry_label(for_id: "audit-search", class: "sr-only") { "Search events" } %>
    <%= poetry_input_group(class: "max-w-xs") do %>
      <%= poetry_input_group_addon do %>
        <%= poetry_icon(name: :search) %>
      <% end %>
      <%= poetry_input_group_input(id: "audit-search", name: "q", placeholder: "Search actor, event, IP…") %>
    <% end %>

    <%= poetry_label(for_id: "audit-severity", class: "sr-only") { "Filter by severity" } %>
    <%= poetry_native_select(name: "severity", id: "audit-severity",
                              options: [["All severities", "all"], ["Critical", "critical"],
                                        ["High", "high"], ["Medium", "medium"], ["Low", "low"]]) %>

    <%= poetry_label(for_id: "audit-event-type", class: "sr-only") { "Filter by event type" } %>
    <%= poetry_native_select(name: "event_type", id: "audit-event-type",
                              options: [["All event types", "all"], ["Authentication", "auth"],
                                        ["Access control", "access"], ["Data export", "export"],
                                        ["Configuration", "config"]]) %>

    <%= poetry_label(for_id: "audit-actor", class: "sr-only") { "Filter by actor" } %>
    <%= poetry_native_select(name: "actor", id: "audit-actor",
                              options: [["All actors", "all"], ["People", "people"], ["System", "system"],
                                        ["API keys", "api_keys"]]) %>

    <%= poetry_label(for_id: "audit-range", class: "sr-only") { "Filter by time range" } %>
    <%= poetry_native_select(name: "range", id: "audit-range",
                              options: [["Last 24 hours", "24h"], ["Last 7 days", "7d"],
                                        ["Last 30 days", "30d"], ["Custom range", "custom"]]) %>

    <div class="ml-auto flex items-center gap-2">
      <%= poetry_button(tag: :a, href: "?", variant: :ghost, size: :sm) { "Clear" } %>
      <%= poetry_button(type: :submit, variant: :secondary, size: :sm) { "Apply filters" } %>
    </div>
  </form>

