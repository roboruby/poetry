          ip: "203.0.113.42", location: "San Francisco, CA, US", device: "Chrome 126 on macOS",
          severity: "high",
          details: { "cidr_added" => "203.0.113.0/24", "previous_entries" => "4", "enforced" => "true" },
        },
        {
          time: "7:30 AM", actor: "Elena Ruiz", initials: "ER",
          action: "Exported member directory", target: "CSV · 214 rows",
          ip: "192.0.2.11", location: "Austin, TX, US", device: "Firefox 128 on Windows",
          severity: "critical",
          details: { "export_format" => "csv", "row_count" => "214", "fields" => "name, email, role, last_active" },
        },
      ],
    },
    {
      label: "Yesterday",
      date: "Tuesday, July 21, 2026",
      events: [
