<div class="mx-auto max-w-6xl space-y-8 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Settings", href: "/settings") %>
      <% crumb.with_item("Billing") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Billing</h1>
        <p class="text-sm text-muted-foreground">Manage your plan, payment method, and invoice history for Acme Workspace.</p>
      </div>
      <%= poetry_button(variant: :outline) do |button| %>
        <% button.with_leading { poetry_icon(name: :"arrow-up-right") } %>
        Compare plans
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <%= poetry_card do |card| %>
      <% card.with_title { "Pro plan" } %>
      <% card.with_description { "Best for growing teams that need advanced automation and priority support." } %>
      <% card.with_action do %>
        <%= poetry_badge(variant: :success) { "Active" } %>
      <% end %>
      <% card.with_footer do %>
        <div class="flex w-full flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-muted-foreground">Auto-renews unless canceled</span>
          <div class="flex items-center gap-2">
            <%= poetry_button(variant: :outline, size: :sm) { "Change plan" } %>
            <%= poetry_button(variant: :ghost, size: :sm) { "Cancel plan" } %>
          </div>
        </div>
      <% end %>
      <%= poetry_metadata_list(columns: :three) do |list| %>
        <% list.with_item(label: "Price") { "$49 / seat / month" } %>
        <% list.with_item(label: "Seats") { "12 of 20 used" } %>
        <% list.with_item(label: "Renews on") { "August 14, 2026" } %>
      <% end %>
    <% end %>

    <%= poetry_card do |card| %>
      <% card.with_title { "Payment method" } %>
      <% card.with_description { "The card charged for your subscription and usage overages." } %>
      <% card.with_footer do %>
        <div class="flex w-full flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-muted-foreground">Billing email: mattsolt@gmail.com</span>
          <%= poetry_button(variant: :outline, size: :sm) { "Update payment method" } %>
        </div>
      <% end %>
      <%= poetry_item(variant: :outline, media_variant: :icon) do |item| %>
        <% item.with_media { poetry_icon(name: :"credit-card") } %>
        <% item.with_title { "Visa •••• 4242" } %>
        <% item.with_description { "Expires 09/2027" } %>
      <% end %>
    <% end %>
  </div>

  <%= poetry_card do |card| %>
    <% card.with_title { "Usage this period" } %>
    <% card.with_description { "Jul 1 – Jul 31, 2026 billing cycle" } %>
    <% card.with_action do %>
      <%= poetry_badge(variant: :secondary) { "10 days left" } %>
    <% end %>
    <% card.with_footer do %>
      <div class="flex w-full items-center justify-between gap-4">
        <span class="text-xs text-muted-foreground">Usage resets at the start of each billing cycle.</span>
        <%= poetry_link(href: "/billing/usage", underline: :always, class: "inline-flex items-center gap-1") do %>
          View usage details <%= poetry_icon(name: :"arrow-right", class: "size-3.5") %>
        <% end %>
      </div>
    <% end %>
    <div class="space-y-5">
      <%= poetry_meter(label: "Seats", value: 12, max: 20, show_value: true, value_label: "12 of 20 seats") %>
      <%= poetry_meter(label: "API requests", value: 842, max: 1000, show_value: true, value_label: "842K of 1M requests") %>
      <%= poetry_meter(label: "Storage", value: 68, max: 100, show_value: true, value_label: "68 GB of 100 GB") %>
    </div>
  <% end %>

  <section class="space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h2 class="text-lg font-semibold tracking-tight">Invoice history</h2>
        <p class="text-sm text-muted-foreground">Amounts, payment status, and downloadable receipts for past invoices.</p>
      </div>
    </div>
    <div class="overflow-hidden rounded-lg border">
      <%= poetry_table do %>
        <%= poetry_table_caption(class: "sr-only") { "Invoice history with date, amount, status, and receipt." } %>
        <%= poetry_table_header do %>
          <%= poetry_table_row do %>
            <%= poetry_table_head { "Invoice" } %>
            <%= poetry_table_head { "Date" } %>
            <%= poetry_table_head(class: "text-right") { "Amount" } %>
            <%= poetry_table_head { "Status" } %>
            <%= poetry_table_head(class: "text-right") { "Receipt" } %>
          <% end %>
        <% end %>
        <%= poetry_table_body do %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1046" } %>
            <%= poetry_table_cell { "Jul 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$588.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, href: "/billing/invoices/INV-1046/receipt") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Receipt
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1045" } %>
            <%= poetry_table_cell { "Jun 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$588.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, href: "/billing/invoices/INV-1045/receipt") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Receipt
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1044" } %>
            <%= poetry_table_cell { "May 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$539.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :destructive) { "Failed" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <span class="text-sm text-muted-foreground">—</span>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1043" } %>
            <%= poetry_table_cell { "Apr 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$539.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, href: "/billing/invoices/INV-1043/receipt") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Receipt
              <% end %>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1042" } %>
            <%= poetry_table_cell { "Mar 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$539.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :warning) { "Pending" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <span class="text-sm text-muted-foreground">—</span>
            <% end %>
          <% end %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "font-medium") { "INV-1041" } %>
            <%= poetry_table_cell { "Feb 1, 2026" } %>
            <%= poetry_table_cell(class: "text-right tabular-nums") { "$539.00" } %>
            <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
            <%= poetry_table_cell(class: "text-right") do %>
              <%= poetry_button(variant: :ghost, size: :sm, href: "/billing/invoices/INV-1041/receipt") do |button| %>
                <% button.with_leading { poetry_icon(name: :download) } %>
                Receipt
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <p class="text-sm text-muted-foreground">Showing 6 of 6 invoices</p>
  </section>
</div>
