<section class="mx-auto max-w-4xl space-y-4 p-6">
  <div class="space-y-1">
    <h1 class="text-lg font-semibold tracking-tight">Invoices</h1>
    <p class="text-sm text-muted-foreground">Recent invoices billed to your account.</p>
  </div>

  <div class="overflow-hidden rounded-lg border">
    <%= poetry_table do %>
      <%= poetry_table_caption { "A list of your recent invoices." } %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Invoice" } %>
          <%= poetry_table_head { "Status" } %>
          <%= poetry_table_head { "Method" } %>
          <%= poetry_table_head(class: "text-right") { "Amount" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV001" } %>
          <%= poetry_table_cell { poetry_badge { "Paid" } } %>
          <%= poetry_table_cell { "Credit Card" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$250.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV002" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Pending" } } %>
          <%= poetry_table_cell { "PayPal" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$150.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV003" } %>
          <%= poetry_table_cell { poetry_badge(variant: :destructive) { "Unpaid" } } %>
          <%= poetry_table_cell { "Bank Transfer" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$350.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV004" } %>
          <%= poetry_table_cell { poetry_badge { "Paid" } } %>
          <%= poetry_table_cell { "Credit Card" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$450.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV005" } %>
          <%= poetry_table_cell { poetry_badge { "Paid" } } %>
          <%= poetry_table_cell { "PayPal" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$550.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV006" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Pending" } } %>
          <%= poetry_table_cell { "Bank Transfer" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$200.00" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(class: "font-medium") { "INV007" } %>
          <%= poetry_table_cell { poetry_badge(variant: :destructive) { "Unpaid" } } %>
          <%= poetry_table_cell { "Credit Card" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$300.00" } %>
        <% end %>
      <% end %>
      <%= poetry_table_footer do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell(colspan: 3) { "Total" } %>
          <%= poetry_table_cell(class: "text-right tabular-nums") { "$2,250.00" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
