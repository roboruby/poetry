<div class="mx-auto max-w-2xl p-6">
  <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
  <p class="mt-1 text-sm text-muted-foreground">
    Manage your account preferences and confirm changes before they apply.
  </p>

  <div class="mt-6">
    <%= poetry_dialog(dismissible: false) do |d| %>
      <% d.with_trigger(variant: :outline) { "Open settings" } %>
      <% d.with_title { "Settings" } %>
      <% d.with_description { "Review your preferences below. Confirming will save these settings to your account." } %>
      <div class="py-2">
        <%= poetry_checkbox(name: "dont_show_again", label: "Don't show this again") %>
      </div>
      <% d.with_footer do %>
        <%= poetry_button(variant: :outline, data: { action: "poetry--core--dialog#close" }) { "Cancel" } %>
        <%= poetry_button(variant: :default, data: { action: "poetry--core--dialog#close" }) { "Save changes" } %>
      <% end %>
    <% end %>
  </div>
</div>
