<%
  customers = [
    "Acme Corp", "Globex Inc", "Initech", "Umbrella LLC", "Stark Industries",
    "Wayne Enterprises", "Hooli", "Soylent Corp", "Aperture Science",
    "Cyberdyne Systems", "Wonka Industries", "Gringotts Bank"
  ]
  statuses = ["Paid", "Overdue", "Draft"]

  all_invoices = (1001..1080).map do |num|
    idx = num - 1001
    {
      number: num,
      customer: customers[idx % customers.length],
      issue_date: Date.new(2026, 1, 1) + (idx * 3),
      amount: (((idx * 137 + 250) % 4200) + 99.0).round(2),
      status: statuses[idx % statuses.length]
    }
  end

  query = params[:q].to_s.strip
  sortable_columns = %w[number customer issue_date amount status]
  sort_col = sortable_columns.include?(params[:sort]) ? params[:sort] : "number"
  sort_dir = params[:dir] == "desc" ? "desc" : "asc"

  filtered = all_invoices.select do |inv|
    query.blank? ||
      inv[:number].to_s.include?(query) ||
      inv[:customer].downcase.include?(query.downcase) ||
      inv[:status].downcase.include?(query.downcase)
  end

  sorted = filtered.sort_by { |inv| inv[sort_col.to_sym] }
  sorted = sorted.reverse if sort_dir == "desc"

  per_page = 10
  total_count = sorted.length
  total_pages = [(total_count.to_f / per_page).ceil, 1].max
  current_page = params[:page].to_i
  current_page = 1 if current_page < 1
  current_page = total_pages if current_page > total_pages
  offset = (current_page - 1) * per_page
  page_invoices = sorted.slice(offset, per_page) || []

  sort_link = ->(label, col) do
    next_dir = (sort_col == col && sort_dir == "asc") ? "desc" : "asc"
    is_active = sort_col == col
    arrow = is_active ? (sort_dir == "asc" ? "&#9650;" : "&#9660;") : ""
    query_params = { sort: col, dir: next_dir }
    query_params[:q] = query if query.present?
    href = "?#{query_params.to_query}"
    active_classes = is_active ? "text-gray-900" : "text-gray-500"
    link_to(href, class: "group inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide #{active_classes} hover:text-gray-900") do
      safe_join([label, content_tag(:span, arrow.html_safe, class: "text-gray-400 group-hover:text-gray-600 #{'text-gray-700' if is_active}")])
    end
  end

  page_href = ->(page_num) do
    query_params = { sort: sort_col, dir: sort_dir, page: page_num }
    query_params[:q] = query if query.present?
    "?#{query_params.to_query}"
  end

  status_classes = {
    "Paid" => "bg-green-50 text-green-700 ring-green-600/20",
    "Overdue" => "bg-red-50 text-red-700 ring-red-600/10",
    "Draft" => "bg-gray-100 text-gray-600 ring-gray-500/20"
  }

  range_start = total_count.zero? ? 0 : offset + 1
  range_end = [offset + per_page, total_count].min
  page_total = page_invoices.sum { |inv| inv[:amount] }
%>

<div class="mx-auto max-w-6xl px-6 py-10">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Invoices</h1>
      <p class="mt-1 text-sm text-gray-500">Browse, search, and sort all invoices.</p>
    </div>
  </div>

  <form method="get" action="" class="mt-6 flex items-center gap-3">
    <input type="hidden" name="sort" value="<%= sort_col %>">
    <input type="hidden" name="dir" value="<%= sort_dir %>">
    <div class="relative w-full max-w-sm">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </div>
      <input
        type="text"
        name="q"
        value="<%= query %>"
        placeholder="Filter by invoice #, customer, or status"
        class="block w-full rounded-md border-0 bg-white py-1.5 pl-9 pr-3 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600"
      >
    </div>
    <button type="submit" class="rounded-md bg-indigo-600 px-3.5 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
      Filter
    </button>
    <% if query.present? %>
      <%= link_to "Clear", "?#{{ sort: sort_col, dir: sort_dir }.to_query}", class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
    <% end %>
  </form>

  <div class="mt-6 overflow-hidden rounded-lg ring-1 ring-gray-200 shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="py-3 pl-4 pr-3 text-left"><%= sort_link.call("Invoice #", "number") %></th>
          <th scope="col" class="px-3 py-3 text-left"><%= sort_link.call("Customer", "customer") %></th>
          <th scope="col" class="px-3 py-3 text-left"><%= sort_link.call("Issue date", "issue_date") %></th>
          <th scope="col" class="px-3 py-3 text-right"><%= sort_link.call("Amount", "amount") %></th>
          <th scope="col" class="px-3 py-3 text-left"><%= sort_link.call("Status", "status") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% if page_invoices.empty? %>
          <tr>
            <td colspan="5" class="px-3 py-10 text-center text-sm text-gray-500">
              No invoices match "<%= query %>".
            </td>
          </tr>
        <% else %>
          <% page_invoices.each do |inv| %>
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap py-3 pl-4 pr-3 text-sm font-medium text-gray-900">INV-<%= inv[:number] %></td>
              <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-700"><%= inv[:customer] %></td>
              <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500"><%= inv[:issue_date].strftime("%b %-d, %Y") %></td>
              <td class="whitespace-nowrap px-3 py-3 text-right text-sm text-gray-700"><%= number_to_currency(inv[:amount]) %></td>
              <td class="whitespace-nowrap px-3 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset <%= status_classes[inv[:status]] %>">
                  <%= inv[:status] %>
                </span>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <% if page_invoices.present? %>
        <tfoot class="bg-gray-50">
          <tr>
            <th scope="row" colspan="3" class="py-3 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">
              Page total
            </th>
            <td class="whitespace-nowrap px-3 py-3 text-right text-sm font-semibold text-gray-900">
              <%= number_to_currency(page_total) %>
            </td>
            <td></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      <% if total_count.zero? %>
        Showing 0 invoices
      <% else %>
        Showing <span class="font-medium text-gray-900"><%= range_start %></span>&ndash;<span class="font-medium text-gray-900"><%= range_end %></span>
        of <span class="font-medium text-gray-900"><%= total_count %></span> invoices
      <% end %>
    </p>

    <nav class="flex items-center gap-1" aria-label="Pagination">
      <% if current_page > 1 %>
        <%= link_to "Previous", page_href.call(current_page - 1), class: "rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-600 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% else %>
        <span class="rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-300 ring-1 ring-inset ring-gray-200">Previous</span>
      <% end %>

      <% (1..total_pages).each do |p| %>
        <% if p == current_page %>
          <span aria-current="page" class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white"><%= p %></span>
        <% else %>
          <%= link_to p, page_href.call(p), class: "rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-50" %>
        <% end %>
      <% end %>

      <% if current_page < total_pages %>
        <%= link_to "Next", page_href.call(current_page + 1), class: "rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-600 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% else %>
        <span class="rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-300 ring-1 ring-inset ring-gray-200">Next</span>
      <% end %>
    </nav>
  </div>
</div>
