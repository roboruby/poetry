<%
  email_alerts_enabled = true
  bookmarked = false
  current_view = "list"
  digest_frequency = "weekly"
  alert_volume = 65
%>

<section aria-labelledby="notification-settings-heading" class="mx-auto max-w-3xl px-6 py-10 space-y-8">
  <header>
    <h1 id="notification-settings-heading" class="text-2xl font-semibold text-gray-900">Notification settings</h1>
    <p class="mt-1 text-sm text-gray-500">Control how and when we contact you. Some changes apply instantly, others need to be saved.</p>
  </header>

  <!-- Quick toggles: bookmark + exclusive view switcher (both instant) -->
  <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-sm">
    <form method="post" action="#">
      <input type="hidden" name="bookmarked" value="<%= bookmarked ? "0" : "1" %>">
      <button
        type="submit"
        aria-pressed="<%= bookmarked %>"
        class="inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors <%= bookmarked ? "bg-amber-50 text-amber-600" : "text-gray-500 hover:bg-gray-50" %>"
      >
        <svg class="h-5 w-5" fill="<%= bookmarked ? "currentColor" : "none" %>" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.32 2.577a49 49 0 0 1 11.36 0c1.497.174 2.57 1.46 2.57 2.93V21a.75.75 0 0 1-1.085.67L12 18.089l-7.165 3.583A.75.75 0 0 1 3.75 21V5.507c0-1.47 1.073-2.756 2.57-2.93Z" />
        </svg>
        <span><%= bookmarked ? "Bookmarked" : "Bookmark this page" %></span>
      </button>
    </form>

    <nav aria-label="Display mode" class="inline-flex rounded-md border border-gray-200 bg-gray-50 p-1">
      <a
        href="?view=list"
        aria-current="<%= current_view == "list" ? "true" : "false" %>"
        class="rounded px-3 py-1.5 text-sm font-medium transition-colors <%= current_view == "list" ? "bg-white text-gray-900 shadow-sm" : "text-gray-500 hover:text-gray-700" %>"
      >
        List view
      </a>
      <a
        href="?view=grid"
        aria-current="<%= current_view == "grid" ? "true" : "false" %>"
        class="rounded px-3 py-1.5 text-sm font-medium transition-colors <%= current_view == "grid" ? "bg-white text-gray-900 shadow-sm" : "text-gray-500 hover:text-gray-700" %>"
      >
        Grid view
      </a>
    </nav>
  </div>

  <!-- Instant-effect switch -->
  <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-4 py-4 shadow-sm">
    <div>
      <p class="text-sm font-medium text-gray-900">Email alerts</p>
      <p class="text-sm text-gray-500">Applies immediately &mdash; no need to save.</p>
    </div>
    <form method="post" action="#">
      <input type="hidden" name="email_alerts" value="<%= email_alerts_enabled ? "0" : "1" %>">
      <button
        type="submit"
        role="switch"
        aria-checked="<%= email_alerts_enabled %>"
        aria-label="Toggle email alerts"
        class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors <%= email_alerts_enabled ? "bg-indigo-600" : "bg-gray-200" %>"
      >
        <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform <%= email_alerts_enabled ? "translate-x-6" : "translate-x-1" %>"></span>
      </button>
    </form>
  </div>

  <!-- Submitting choice: digest frequency -->
  <form method="post" action="#" class="flex flex-col gap-3 rounded-lg border border-gray-200 bg-white px-4 py-4 shadow-sm sm:flex-row sm:items-end sm:justify-between">
    <div class="flex-1">
      <label for="digest_frequency" class="block text-sm font-medium text-gray-900">Digest frequency</label>
      <p class="text-sm text-gray-500">Choose how often you receive a summary email.</p>
      <select
        id="digest_frequency"
        name="digest_frequency"
        class="mt-2 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:max-w-xs"
      >
        <option value="daily" <%= "selected" if digest_frequency == "daily" %>>Daily</option>
        <option value="weekly" <%= "selected" if digest_frequency == "weekly" %>>Weekly</option>
        <option value="monthly" <%= "selected" if digest_frequency == "monthly" %>>Monthly</option>
        <option value="never" <%= "selected" if digest_frequency == "never" %>>Never</option>
      </select>
    </div>
    <button type="submit" class="inline-flex shrink-0 items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
      Update frequency
    </button>
  </form>

  <!-- Submitting entry: 6-digit confirmation code -->
  <form method="post" action="#" class="rounded-lg border border-gray-200 bg-white px-4 py-4 shadow-sm">
    <label for="confirmation_code" class="block text-sm font-medium text-gray-900">Confirmation code</label>
    <p class="text-sm text-gray-500">Enter the 6-digit code we sent to your email.</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <input
        type="text"
        id="confirmation_code"
        name="confirmation_code"
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        autocomplete="one-time-code"
        placeholder="000000"
        class="w-40 rounded-md border border-gray-300 px-3 py-2 text-center font-mono text-lg tracking-[0.5em] text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
      >
      <button type="submit" class="inline-flex items-center justify-center rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-700">
        Verify code
      </button>
    </div>
  </form>

  <!-- Staged form: accept terms, alert volume, unsubscribe note -->
  <form method="post" action="#" class="space-y-6 rounded-lg border border-gray-200 bg-white px-4 py-5 shadow-sm">
    <fieldset class="space-y-2">
      <legend class="text-sm font-medium text-gray-900">Alert volume</legend>
      <p id="alert_volume_help" class="text-sm text-gray-500">How loud push notifications sound on your device.</p>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-400">Quiet</span>
        <input
          type="range"
          id="alert_volume"
          name="alert_volume"
          min="0"
          max="100"
          step="5"
          value="<%= alert_volume %>"
          aria-describedby="alert_volume_help"
          class="h-2 w-full cursor-pointer appearance-none rounded-full bg-gray-200 accent-indigo-600"
        >
        <span class="text-xs text-gray-400">Loud</span>
      </div>
    </fieldset>

    <div>
      <label for="unsubscribe_note" class="block text-sm font-medium text-gray-900">Unsubscribe note</label>
      <p class="text-sm text-gray-500">Optional &mdash; let us know why you're adjusting your preferences.</p>
      <textarea
        id="unsubscribe_note"
        name="unsubscribe_note"
        rows="3"
        placeholder="Tell us more (optional)"
        class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
      ></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input type="checkbox" id="accept_terms" name="accept_terms" value="1" class="mt-1 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
      <label for="accept_terms" class="text-sm text-gray-700">
        <span class="font-medium text-gray-900">I accept the updated notification terms</span>
        <span class="block text-gray-500">This change won't apply until you save.</span>
      </label>
    </div>

    <div class="flex justify-end border-t border-gray-100 pt-4">
      <button type="submit" class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
        Save changes
      </button>
    </div>
  </form>
</section>
