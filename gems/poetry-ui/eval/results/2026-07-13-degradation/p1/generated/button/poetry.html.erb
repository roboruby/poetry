<div class="mx-auto max-w-xl p-6">
  <section class="space-y-4 rounded-lg border border-destructive/50 p-6" aria-labelledby="delete-account-title">
    <div class="space-y-1">
      <h2 id="delete-account-title" class="text-base font-semibold">Delete account</h2>
      <p class="text-sm text-muted-foreground">Your profile, files, and billing history are permanently removed. Anyone you've shared projects with will lose access immediately.</p>
    </div>
    <%= poetry_alert(variant: :destructive) do |alert| %>
      <% alert.with_icon(name: "triangle-alert") %>
      <% alert.with_title { "This cannot be undone" } %>
    <% end %>
    <div class="flex items-center justify-end gap-2">
      <%= poetry_button(variant: :outline) { "Keep my account" } %>
      <%= poetry_button(variant: :destructive) do |button| %>
        <% button.with_leading { poetry_icon(name: :trash) } %>
        Delete account
      <% end %>
    </div>
  </section>
</div>
