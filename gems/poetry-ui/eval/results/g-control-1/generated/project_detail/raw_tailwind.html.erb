<% status_styles = {
  "on_track" => "bg-green-100 text-green-800 ring-green-600/20",
  "at_risk" => "bg-amber-100 text-amber-800 ring-amber-600/20",
  "off_track" => "bg-red-100 text-red-800 ring-red-600/20",
  "completed" => "bg-blue-100 text-blue-800 ring-blue-600/20"
} %>

<% milestone_styles = {
  "done" => { dot: "bg-emerald-500", label: "bg-emerald-50 text-emerald-700 ring-emerald-600/20", text: "Completed" },
  "in_progress" => { dot: "bg-blue-500", label: "bg-blue-50 text-blue-700 ring-blue-600/20", text: "In progress" },
  "upcoming" => { dot: "bg-gray-300", label: "bg-gray-50 text-gray-600 ring-gray-500/20", text: "Upcoming" }
} %>

<main class="mx-auto max-w-5xl px-6 py-10">
  <!-- Header: name, status, description, actions -->
  <div class="flex items-start justify-between gap-6 border-b border-gray-200 pb-6">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight text-gray-900">Atlas Platform Migration</h1>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= status_styles["at_risk"] %>">
          At risk
        </span>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-600">
        Migrate the core billing and identity services from the legacy monolith onto the new
        Atlas platform, with zero downtime and full parity on reporting exports.
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <a href="#" class="inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
        <svg class="h-4 w-4 text-gray-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M13.586 3.586a2 2 0 1 1 2.828 2.828l-.793.793-2.828-2.828.793-.793ZM11.379 5.793 3 14.172V17h2.828l8.38-8.379-2.83-2.828Z" />
        </svg>
        Edit
      </a>
      <details class="relative">
        <summary class="list-none inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-700 shadow-xs ring-1 ring-inset ring-red-200 hover:bg-red-50">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Zm1 3h10l-.7 9.1A2 2 0 0 1 12.31 18H7.69a2 2 0 0 1-1.99-1.9L5 7Zm3 2a.75.75 0 0 0-.75.75v5a.75.75 0 0 0 1.5 0v-5A.75.75 0 0 0 8 9Zm4 0a.75.75 0 0 0-.75.75v5a.75.75 0 0 0 1.5 0v-5A.75.75 0 0 0 12 9Z" clip-rule="evenodd" />
          </svg>
          Archive
        </summary>
        <div class="absolute right-0 z-10 mt-2 w-72 rounded-md border border-gray-200 bg-white p-4 text-sm shadow-lg">
          <p class="font-medium text-gray-900">Archive this project?</p>
          <p class="mt-1 text-gray-600">It will be hidden from active project lists but can be restored later.</p>
          <form action="#" method="post" class="mt-3 flex justify-end gap-2">
            <button type="button" onclick="this.closest('details').removeAttribute('open')" class="rounded-md px-3 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</button>
            <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-500">Archive</button>
          </form>
        </div>
      </details>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-3 gap-8">
    <!-- Owner and key dates -->
    <section aria-labelledby="details-heading" class="col-span-1">
      <h2 id="details-heading" class="text-sm font-semibold text-gray-900">Details</h2>
      <dl class="mt-4 space-y-5">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Owner</dt>
          <dd class="mt-1 flex items-center gap-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700">
              PN
            </span>
            <span class="text-sm text-gray-900">Priya Nandan</span>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Start date</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <time datetime="2026-02-02">Feb 2, 2026</time>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Target completion</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <time datetime="2026-09-30">Sep 30, 2026</time>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Last updated</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <time datetime="2026-07-20">Jul 20, 2026</time>
          </dd>
        </div>
      </dl>
    </section>

    <!-- Milestone timeline -->
    <section aria-labelledby="milestones-heading" class="col-span-2">
      <h2 id="milestones-heading" class="text-sm font-semibold text-gray-900">Milestone timeline</h2>
      <ol class="mt-4 space-y-0">
        <% [
          { name: "Discovery & audit of legacy services", date: "Feb 14, 2026", state: "done" },
          { name: "Identity service cutover", date: "Apr 25, 2026", state: "done" },
          { name: "Billing service dual-write enabled", date: "Jul 11, 2026", state: "in_progress" },
          { name: "Reporting exports parity sign-off", date: "Aug 22, 2026", state: "upcoming" },
          { name: "Legacy monolith decommission", date: "Sep 30, 2026", state: "upcoming" }
        ].each_with_index do |milestone, index| %>
          <% style = milestone_styles[milestone[:state]] %>
          <li class="relative flex gap-4 pb-8 last:pb-0">
            <div class="flex flex-col items-center">
              <span class="mt-1 h-3 w-3 shrink-0 rounded-full <%= style[:dot] %>"></span>
              <% unless index == 4 %>
                <span class="mt-1 w-px flex-1 bg-gray-200"></span>
              <% end %>
            </div>
            <div class="min-w-0 flex-1 -mt-0.5">
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                <p class="text-sm font-medium text-gray-900"><%= milestone[:name] %></p>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= style[:label] %>">
                  <%= style[:text] %>
                </span>
              </div>
              <p class="mt-0.5 text-sm text-gray-500">
                <time><%= milestone[:date] %></time>
              </p>
            </div>
          </li>
        <% end %>
      </ol>
    </section>
  </div>

  <!-- Recent tasks -->
  <section aria-labelledby="recent-tasks-heading" class="mt-10 border-t border-gray-200 pt-8">
    <div class="flex items-center justify-between">
      <h2 id="recent-tasks-heading" class="text-sm font-semibold text-gray-900">Recent tasks</h2>
      <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View all tasks</a>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Task</th>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Assignee</th>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Due date</th>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% [
            { name: "Wire dual-write flag for invoices table", assignee: "Priya Nandan", initials: "PN", due: "Jul 24, 2026", status: "In progress", tone: "bg-blue-50 text-blue-700 ring-blue-600/20" },
            { name: "Backfill customer identity mappings", assignee: "Dev Okonkwo", initials: "DO", due: "Jul 25, 2026", status: "In progress", tone: "bg-blue-50 text-blue-700 ring-blue-600/20" },
            { name: "Review reporting export schema diff", assignee: "Sasha Lim", initials: "SL", due: "Jul 28, 2026", status: "Not started", tone: "bg-gray-50 text-gray-600 ring-gray-500/20" },
            { name: "Load test billing cutover path", assignee: "Priya Nandan", initials: "PN", due: "Aug 1, 2026", status: "Not started", tone: "bg-gray-50 text-gray-600 ring-gray-500/20" },
            { name: "Draft rollback runbook for identity service", assignee: "Marcus Feld", initials: "MF", due: "Aug 4, 2026", status: "Not started", tone: "bg-gray-50 text-gray-600 ring-gray-500/20" }
          ].each do |task| %>
            <tr>
              <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= task[:name] %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-indigo-100 text-[10px] font-semibold text-indigo-700">
                    <%= task[:initials] %>
                  </span>
                  <span class="text-sm text-gray-700"><%= task[:assignee] %></span>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500">
                <time><%= task[:due] %></time>
              </td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= task[:tone] %>">
                  <%= task[:status] %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
