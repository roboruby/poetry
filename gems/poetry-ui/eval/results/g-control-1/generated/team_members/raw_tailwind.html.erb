<%
  members = [
    { initials: "AS", color: "violet", name: "Ava Simmons",     email: "ava.simmons@northwind.co",     role: "Owner",  last_active: "Active now" },
    { initials: "MC", color: "blue",   name: "Marcus Chen",     email: "marcus.chen@northwind.co",     role: "Admin",  last_active: "Active 2h ago" },
    { initials: "PN", color: "emerald",name: "Priya Nair",      email: "priya.nair@northwind.co",      role: "Member", last_active: "Active yesterday" },
    { initials: "DA", color: "amber",  name: "Diego Alvarez",   email: "diego.alvarez@northwind.co",   role: "Member", last_active: "Active 3 days ago" },
    { initials: "SK", color: "rose",   name: "Sofia Kowalski",  email: "sofia.kowalski@northwind.co",  role: "Member", last_active: "Active 1 week ago" },
    { initials: "TR", color: "cyan",   name: "Tomás Reyes",     email: "tomas.reyes@northwind.co",     role: "Viewer", last_active: "Active 3 weeks ago" },
  ]

  pending_invitations = [
    { email: "jordan.lee@example.com",   role: "Admin",  invited_by: "Ava Simmons",   invited_at: "2 days ago" },
    { email: "hannah.park@example.com",  role: "Member", invited_by: "Marcus Chen",   invited_at: "5 days ago" },
    { email: "felix.brandt@example.com", role: "Viewer", invited_by: "Ava Simmons",   invited_at: "1 week ago" },
  ]

  role_badge_classes = {
    "Owner"  => "bg-purple-100 text-purple-700",
    "Admin"  => "bg-blue-100 text-blue-700",
    "Member" => "bg-gray-100 text-gray-700",
    "Viewer" => "bg-slate-100 text-slate-600",
  }

  avatar_color_classes = {
    "violet"  => "bg-violet-100 text-violet-700",
    "blue"    => "bg-blue-100 text-blue-700",
    "emerald" => "bg-emerald-100 text-emerald-700",
    "amber"   => "bg-amber-100 text-amber-700",
    "rose"    => "bg-rose-100 text-rose-700",
    "cyan"    => "bg-cyan-100 text-cyan-700",
  }
%>

<main class="mx-auto max-w-6xl px-6 py-10 space-y-8">
  <header class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Team members</h1>
      <p class="mt-1 text-sm text-gray-500">Manage who has access to this workspace and what they can do.</p>
    </div>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600">
      <%= members.length %> members
    </span>
  </header>

  <!-- Invite teammate -->
  <section aria-labelledby="invite-heading" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 id="invite-heading" class="text-base font-semibold text-gray-900">Invite a teammate</h2>
    <p class="mt-1 text-sm text-gray-500">They'll receive an email invitation to join this workspace.</p>

    <%= form_with url: "#", method: :post, local: true, class: "mt-4 flex flex-col gap-4 sm:flex-row sm:items-end" do %>
      <div class="flex-1">
        <label for="invite_email" class="block text-sm font-medium text-gray-700">Email address</label>
        <input
          type="email"
          name="invite[email]"
          id="invite_email"
          required
          placeholder="teammate@company.com"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        >
      </div>

      <div class="sm:w-48">
        <label for="invite_role" class="block text-sm font-medium text-gray-700">Role</label>
        <select
          name="invite[role]"
          id="invite_role"
          class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        >
          <option value="admin">Admin</option>
          <option value="member" selected>Member</option>
          <option value="viewer">Viewer</option>
        </select>
      </div>

      <div>
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
        >
          Send invite
        </button>
      </div>
    <% end %>
  </section>

  <!-- Member list -->
  <section aria-labelledby="members-heading" class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-gray-200 p-6 sm:flex-row sm:items-center sm:justify-between">
      <h2 id="members-heading" class="text-base font-semibold text-gray-900">Members</h2>

      <form role="search" method="get" action="#" class="sm:w-72">
        <label for="member_search" class="sr-only">Search members</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="9" cy="9" r="6" stroke-width="1.5" />
            <path d="M17 17l-3.5-3.5" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            name="q"
            id="member_search"
            placeholder="Search by name or email"
            class="w-full rounded-md border border-gray-300 py-2 pl-9 pr-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
        </div>
      </form>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <caption class="sr-only">Workspace members and their roles</caption>
      <thead>
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Member</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Role</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Last active</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% members.each do |member| %>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-medium <%= avatar_color_classes[member[:color]] %>" aria-hidden="true">
                  <%= member[:initials] %>
                </span>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= member[:name] %></p>
                  <p class="text-sm text-gray-500"><%= member[:email] %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-3">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= role_badge_classes[member[:role]] %>">
                <%= member[:role] %>
              </span>
            </td>
            <td class="px-6 py-3 text-sm text-gray-500">
              <%= member[:last_active] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <!-- Pending invitations -->
  <section aria-labelledby="invitations-heading" class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 p-6">
      <h2 id="invitations-heading" class="text-base font-semibold text-gray-900">Pending invitations</h2>
      <p class="mt-1 text-sm text-gray-500">Invitations that haven't been accepted yet.</p>
    </div>

    <% if pending_invitations.any? %>
      <ul class="divide-y divide-gray-100">
        <% pending_invitations.each do |invitation| %>
          <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-400" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                  <path d="M3 5h14v10H3z" stroke-width="1.5" stroke-linejoin="round" />
                  <path d="M3 5l7 6 7-6" stroke-width="1.5" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= invitation[:email] %></p>
                <p class="text-sm text-gray-500">
                  Invited by <%= invitation[:invited_by] %> &middot; <%= invitation[:invited_at] %>
                </p>
              </div>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= role_badge_classes[invitation[:role]] %>">
                <%= invitation[:role] %>
              </span>
            </div>

            <div class="flex items-center gap-2 sm:shrink-0">
              <%= form_with url: "#", method: :post, local: true do %>
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                >
                  Resend
                </button>
              <% end %>

              <%= form_with url: "#", method: :delete, local: true do %>
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                >
                  Revoke
                </button>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-6 py-8 text-center text-sm text-gray-500">No pending invitations.</p>
    <% end %>
  </section>
</main>
