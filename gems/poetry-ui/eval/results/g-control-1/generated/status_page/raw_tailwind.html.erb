<%
  services = [
    { name: "API", uptime: 99.98, status: :operational },
    { name: "Web Dashboard", uptime: 99.99, status: :operational },
    { name: "Payments Processing", uptime: 98.42, status: :partial_outage },
    { name: "Authentication", uptime: 100.0, status: :operational },
    { name: "Database", uptime: 99.95, status: :operational },
    { name: "CDN & Static Assets", uptime: 100.0, status: :operational },
  ]

  status_meta = {
    operational:     { label: "Operational",       dot: "bg-emerald-500", text: "text-emerald-700", bar: "bg-emerald-500" },
    degraded:        { label: "Degraded Performance", dot: "bg-amber-400",  text: "text-amber-700",  bar: "bg-amber-400" },
    partial_outage:  { label: "Partial Outage",     dot: "bg-orange-500",  text: "text-orange-700",  bar: "bg-orange-500" },
    major_outage:    { label: "Major Outage",       dot: "bg-red-500",     text: "text-red-700",     bar: "bg-red-500" },
  }

  # build 90-day history bars per service (oldest -> newest, left -> right)
  histories = services.each_with_object({}) do |service, memo|
    days = Array.new(90, :operational)
    if service[:status] == :partial_outage
      days[-1] = :partial_outage
      days[-2] = :degraded
      days[-7] = :degraded
    end
    memo[service[:name]] = days
  end

  any_disrupted = services.any? { |s| s[:status] != :operational }
%>
<div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
  <header class="mb-8 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Acme Cloud Status</h1>
      <p class="mt-1 text-sm text-gray-500">Current status for all Acme Cloud services</p>
    </div>
    <a
      href="#subscribe"
      class="inline-flex shrink-0 items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500"
    >
      Subscribe to updates
    </a>
  </header>

  <% if any_disrupted %>
    <div class="mb-8 flex items-start gap-3 rounded-lg border border-orange-200 bg-orange-50 p-4" role="status">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
      </svg>
      <div>
        <p class="font-medium text-orange-800">Partial System Outage</p>
        <p class="mt-0.5 text-sm text-orange-700">One or more services are currently experiencing degraded performance. See the active incident below for details.</p>
      </div>
    </div>
  <% else %>
    <div class="mb-8 flex items-center gap-3 rounded-lg border border-emerald-200 bg-emerald-50 p-4" role="status">
      <svg class="h-5 w-5 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
      <p class="font-medium text-emerald-800">All Systems Operational</p>
    </div>
  <% end %>

  <section aria-labelledby="services-heading" class="mb-10">
    <h2 id="services-heading" class="mb-4 text-lg font-semibold text-gray-900">Service status</h2>
    <div class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
      <% services.each do |service| %>
        <% meta = status_meta.fetch(service[:status]) %>
        <div class="p-4 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <span class="font-medium text-gray-900"><%= service[:name] %></span>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium <%= meta[:text] %>">
              <span class="h-2 w-2 rounded-full <%= meta[:dot] %>" aria-hidden="true"></span>
              <%= meta[:label] %>
            </span>
          </div>

          <div class="mt-3" role="img" aria-label="90 day uptime history for <%= service[:name] %>: <%= service[:uptime] %>% uptime">
            <div class="flex h-8 items-stretch gap-px" aria-hidden="true">
              <% histories[service[:name]].each do |day_status| %>
                <span class="min-w-[2px] flex-1 rounded-[1px] <%= status_meta.fetch(day_status)[:bar] %>"></span>
              <% end %>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs text-gray-400">
              <span>90 days ago</span>
              <span class="font-medium text-gray-500"><%= service[:uptime] %>% uptime</span>
              <span>Today</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="incident-heading" class="mb-10">
    <h2 id="incident-heading" class="mb-4 text-lg font-semibold text-gray-900">Active incident</h2>
    <div class="rounded-lg border border-orange-200 bg-white">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-orange-100 bg-orange-50 px-4 py-3 sm:px-5">
        <h3 class="font-medium text-gray-900">Elevated errors on Payments Processing</h3>
        <span class="inline-flex items-center rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-medium text-orange-800">
          Identified
        </span>
      </div>
      <ol class="divide-y divide-gray-100">
        <li class="px-4 py-4 sm:px-5">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800">Identified</span>
            <time datetime="2026-07-22T14:32:00Z" class="text-xs text-gray-400">Jul 22, 2026 &middot; 14:32 UTC</time>
          </div>
          <p class="mt-2 text-sm text-gray-600">We've identified the root cause as a misbehaving connection to a downstream card network and are rolling out a fix. Some payments may fail or be delayed during this time.</p>
        </li>
        <li class="px-4 py-4 sm:px-5">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Investigating</span>
            <time datetime="2026-07-22T13:50:00Z" class="text-xs text-gray-400">Jul 22, 2026 &middot; 13:50 UTC</time>
          </div>
          <p class="mt-2 text-sm text-gray-600">We are investigating reports of elevated error rates and slow response times on payment processing.</p>
        </li>
        <li class="px-4 py-4 sm:px-5">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Investigating</span>
            <time datetime="2026-07-22T13:41:00Z" class="text-xs text-gray-400">Jul 22, 2026 &middot; 13:41 UTC</time>
          </div>
          <p class="mt-2 text-sm text-gray-600">We are aware of an issue affecting Payments Processing and are looking into it. Further updates to follow shortly.</p>
        </li>
      </ol>
    </div>

    <details class="mt-4 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-gray-700 sm:px-5">
        Past incidents
      </summary>
      <ul class="divide-y divide-gray-100 border-t border-gray-100">
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm sm:px-5">
          <span class="text-gray-700">Scheduled database maintenance completed successfully</span>
          <time datetime="2026-07-15" class="text-xs text-gray-400">Jul 15, 2026</time>
        </li>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm sm:px-5">
          <span class="text-gray-700">Brief latency increase on API resolved</span>
          <time datetime="2026-06-30" class="text-xs text-gray-400">Jun 30, 2026</time>
        </li>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm sm:px-5">
          <span class="text-gray-700">CDN cache invalidation delay resolved</span>
          <time datetime="2026-06-11" class="text-xs text-gray-400">Jun 11, 2026</time>
        </li>
      </ul>
    </details>
  </section>

  <section id="subscribe" aria-labelledby="subscribe-heading" class="scroll-mt-8 rounded-lg border border-gray-200 bg-white p-5">
    <h2 id="subscribe-heading" class="text-lg font-semibold text-gray-900">Subscribe to updates</h2>
    <p class="mt-1 text-sm text-gray-500">Get an email whenever we create, update, or resolve an incident.</p>
    <form action="/eval/status_page/subscriptions" method="post" class="mt-4 flex flex-col gap-3 sm:flex-row">
      <label for="subscriber_email" class="sr-only">Email address</label>
      <input
        type="email"
        name="email"
        id="subscriber_email"
        required
        placeholder="you@example.com"
        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:max-w-sm"
      >
      <button
        type="submit"
        class="inline-flex shrink-0 items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500"
      >
        Subscribe
      </button>
    </form>
  </section>
</div>
