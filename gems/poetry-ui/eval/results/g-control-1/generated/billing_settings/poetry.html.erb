<div class="mx-auto max-w-6xl p-6 space-y-8">
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Home", href: "/") %>
    <% crumb.with_item("Settings", href: "/settings") %>
    <% crumb.with_item("Billing") %>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Billing</h1>
      <p class="text-sm text-muted-foreground">Plan, payment method, usage, and invoices for the Acme Studio workspace.</p>
    </div>
    <%= poetry_button(variant: :outline, tag: :a, href: "#") do |button| %>
      <% button.with_leading { poetry_icon(name: :download) } %>
      Export all invoices
    <% end %>
  </div>
  <%= poetry_separator %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <%= poetry_card do |card| %>
      <% card.with_title { "Team plan" } %>
      <% card.with_description { "Billed monthly · next charge $149.00 on August 22, 2026" } %>
      <% card.with_action { poetry_badge(variant: :success) { "Active" } } %>
      <% card.with_footer do %>
        <div class="flex w-full items-center justify-between gap-4">
          <span class="text-xs text-muted-foreground">Renews automatically every month</span>
          <%= poetry_button(variant: :outline, size: :sm, tag: :a, href: "#") { "Change plan" } %>
        </div>
      <% end %>
      <%= poetry_metadata_list(columns: :two) do |list| %>
        <% list.with_item(label: "Plan") { "Team" } %>
        <% list.with_item(label: "Price") { "$149.00 / month" } %>
        <% list.with_item(label: "Seats") { "18 of 25 used" } %>
        <% list.with_item(label: "Renewal date") { "August 22, 2026" } %>
      <% end %>
    <% end %>

    <%= poetry_card do |card| %>
      <% card.with_title { "Payment method" } %>
      <% card.with_description { "Charged automatically for this workspace's subscription." } %>
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-md border bg-muted">
            <%= poetry_icon(name: :"credit-card", class: "size-4 text-muted-foreground") %>
          </span>
          <div>
            <p class="text-sm font-medium">Visa ending in 4242</p>
            <p class="text-xs text-muted-foreground">Expires 09/2027 · billing name Acme Studio Inc.</p>
          </div>
        </div>
        <%= poetry_button(variant: :outline, size: :sm, tag: :a, href: "#") { "Update" } %>
      </div>
    <% end %>
  </div>

  <%= poetry_card do |card| %>
    <% card.with_title { "Usage this period" } %>
    <% card.with_description { "July 1 – July 31, 2026 · resets in 9 days" } %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <%= poetry_meter(label: "Seats", value: 18, max: 25, value_label: "18 of 25 seats") %>
      <%= poetry_meter(label: "API requests", value: 842, max: 1000, value_label: "842K of 1M requests") %>
      <%= poetry_meter(label: "Storage", value: 68, max: 100, value_label: "68 GB of 100 GB") %>
    </div>
  <% end %>

  <%= poetry_card do |card| %>
    <% card.with_title { "Invoice history" } %>
    <% card.with_description { "Statements for past billing periods, with downloadable receipts." } %>
    <%= poetry_table do %>
      <%= poetry_table_caption { "Invoices billed to the Acme Studio workspace." } %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Invoice" } %>
          <%= poetry_table_head { "Date" } %>
          <%= poetry_table_head { "Amount" } %>
          <%= poetry_table_head { "Status" } %>
          <%= poetry_table_head { "Receipt" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-0007" } %>
          <%= poetry_table_cell { "Jul 1, 2026" } %>
          <%= poetry_table_cell { "$149.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-0006" } %>
          <%= poetry_table_cell { "Jun 1, 2026" } %>
          <%= poetry_table_cell { "$149.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-0005" } %>
          <%= poetry_table_cell { "May 1, 2026" } %>
          <%= poetry_table_cell { "$149.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-0004" } %>
          <%= poetry_table_cell { "Apr 1, 2026" } %>
          <%= poetry_table_cell { "$149.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :info) { "Refunded" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-0003" } %>
          <%= poetry_table_cell { "Mar 1, 2026" } %>
          <%= poetry_table_cell { "$149.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "#") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
