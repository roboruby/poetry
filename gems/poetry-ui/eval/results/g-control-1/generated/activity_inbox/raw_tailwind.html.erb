        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.85 23.85 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
          </svg>
        </span>
        <div>
          <h1 class="text-base font-semibold text-slate-900">Activity</h1>
          <p class="text-xs text-slate-500">Mentions, assignments, and status changes</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-100">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
        4 unread
