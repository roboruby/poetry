      <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 ring-1 ring-transparent transition-colors hover:bg-slate-100 has-checked:bg-indigo-600 has-checked:text-white has-checked:hover:bg-indigo-600 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-400">
