<div class="flex min-h-screen items-center justify-center bg-muted/30 p-6">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span class="flex size-8 items-center justify-center rounded-md bg-primary text-primary-foreground">
        <%= poetry_icon(name: :"shield-check", class: "size-4") %>
      </span>
      <span class="text-lg font-semibold tracking-tight">Meridian</span>
    </div>

    <%= poetry_card(title_tag: :h1) do |card| %>
      <% card.with_title { "Sign in to your workspace" } %>
      <% card.with_description { "Enter your email and password to continue" } %>
      <% card.with_footer do %>
        <div class="w-full text-center text-sm text-muted-foreground">
          New to Meridian?
          <%= poetry_link(href: "/request-access", underline: :hover) { "Request access" } %>
        </div>
      <% end %>

      <%= form_with url: "/session", method: :post, local: true, class: "space-y-4" do %>
        <%= poetry_field(id: "email", label_text: "Email", required: true) do |field| %>
          <%= poetry_input(**field.control_attributes, type: "email", name: "email", placeholder: "you@company.com", autocomplete: "email") %>
        <% end %>

        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <%= poetry_label(for_id: "password") { "Password" } %>
            <%= poetry_link(href: "/password/new", underline: :hover, class: "text-sm") { "Forgot password?" } %>
          </div>
          <%= poetry_sensitive_input(id: "password", name: "password", label: "Password", placeholder: "••••••••", required: true) %>
        </div>

        <%= poetry_button(type: :submit, class: "w-full") { "Sign in" } %>

        <div class="relative py-1">
          <div class="absolute inset-0 flex items-center">
            <%= poetry_separator %>
          </div>
          <div class="relative flex justify-center text-xs uppercase tracking-wide">
            <span class="bg-card px-2 text-muted-foreground">Or continue with</span>
          </div>
        </div>

        <%= poetry_button(variant: :outline, type: :button, tag: :a, href: "/auth/sso", class: "w-full") do |button| %>
          <% button.with_leading { poetry_icon(name: :"key-round") } %>
          Continue with SSO
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
