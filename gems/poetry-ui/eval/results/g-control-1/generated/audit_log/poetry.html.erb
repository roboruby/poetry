<section class="mx-auto max-w-6xl space-y-6 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Northwind Traders", href: "/") %>
      <% crumb.with_item("Settings", href: "/settings") %>
      <% crumb.with_item("Audit log") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
        <p class="text-sm text-muted-foreground">
          Security-relevant activity across the Northwind Traders workspace — who did what, when, and from where.
        </p>
      </div>
      <%= poetry_dropdown_menu do |menu| %>
        <% menu.with_trigger(variant: :outline) do |button| %>
          <% button.with_leading { poetry_icon(name: :download) } %>
          Export
        <% end %>
        <% menu.with_item { "Export as CSV" } %>
        <% menu.with_item { "Export as JSON" } %>
        <% menu.with_separator %>
        <% menu.with_item { "Export current view only" } %>
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

  <%= form_with url: "", method: :get, class: "space-y-3" do %>
    <div class="flex flex-wrap items-center gap-3">
      <%= poetry_label(for_id: "audit-search", class: "sr-only") { "Search events" } %>
      <%= poetry_input_group(class: "max-w-xs") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :search) %>
        <% end %>
        <%= poetry_input_group_input(id: "audit-search", name: "q", placeholder: "Search actor, action, or target…") %>
      <% end %>

      <%= poetry_label(for_id: "audit-severity", class: "sr-only") { "Filter by severity" } %>
      <%= poetry_native_select(name: "severity", id: "audit-severity",
                               options: [["All severities", "all"], ["Critical", "critical"],
                                         ["Warning", "warning"], ["Info", "info"]]) %>

      <%= poetry_label(for_id: "audit-event-type", class: "sr-only") { "Filter by event type" } %>
      <%= poetry_native_select(name: "event_type", id: "audit-event-type",
                               options: [["All event types", "all"], ["Authentication", "authentication"],
                                         ["Access control", "access_control"], ["Data export", "data_export"],
                                         ["Billing", "billing"], ["Settings", "settings"]]) %>

      <%= poetry_label(for_id: "audit-actor", class: "sr-only") { "Filter by actor" } %>
      <%= poetry_native_select(name: "actor", id: "audit-actor",
                               options: [["All members", "all"], ["Priya Natarajan", "priya"],
                                         ["Marcus Webb", "marcus"], ["Elena Cho", "elena"],
                                         ["Jordan Blake", "jordan"], ["Sam Reyes", "sam"]]) %>

      <div class="flex items-center gap-2">
        <%= poetry_date_field(name: "from", label: "From date") %>
        <span class="text-sm text-muted-foreground" aria-hidden="true">to</span>
        <%= poetry_date_field(name: "to", label: "To date") %>
      </div>

      <div class="ml-auto flex items-center gap-2">
        <%= poetry_button(type: :submit) { "Apply filters" } %>
        <%= poetry_button(variant: :ghost, type: :reset) do |button| %>
          <% button.with_leading { poetry_icon(name: :"rotate-ccw") } %>
          Reset
        <% end %>
      </div>
    </div>
  <% end %>

