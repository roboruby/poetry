<div class="mx-auto max-w-3xl space-y-6 p-6">
  <header class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold tracking-tight">Activity</h1>
          <%= poetry_badge(variant: :info) { "3 unread" } %>
        </div>
        <p class="text-sm text-muted-foreground">Mentions, assignments, and status changes across your work.</p>
      </div>
      <%= poetry_button(variant: :outline) do |button| %>
        <% button.with_leading { poetry_icon(name: :"check-check") } %>
        Mark all as read
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

  <%= poetry_tabs(label: "Filter activity by type", default: "all") do |tabs| %>
    <% tabs.with_tab("All", value: "all") do %>
      <%= poetry_item_group(class: "mt-4") do %>
        <%= poetry_item(role: "listitem", size: :sm, variant: :default) do |item| %>
          <% item.with_media(media_variant: :icon) { poetry_icon(name: :"at-sign", label: "Mention") } %>
          <% item.with_title do %>
            <span class="flex flex-wrap items-center gap-2">
              <span><span class="font-medium">Priya Nair</span> mentioned you in <span class="font-medium">Q3 roadmap</span></span>
              <%= poetry_badge(variant: :info) { "Unread" } %>
            </span>
          <% end %>
          <% item.with_description { "12m ago — “Can you take a look at the timeline section?”" } %>
          <% item.with_actions do %>
            <%= poetry_button_group("aria-label": "Row actions") do %>
              <%= poetry_button(variant: :ghost, size: :sm) do |b| %>
                <% b.with_leading { poetry_icon(name: :check) } %>
                Mark as read
              <% end %>
              <%= poetry_button(variant: :outline, size: :sm, tag: :a, href: "#") do |b| %>
                Open
                <% b.with_trailing { poetry_icon(name: :"arrow-up-right") } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_item_separator %>
