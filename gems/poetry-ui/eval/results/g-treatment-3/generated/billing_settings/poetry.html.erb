<div class="mx-auto max-w-5xl space-y-8 p-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Billing</h1>
      <p class="text-sm text-muted-foreground">Manage the plan, payment method, and invoices for the Acme Inc. workspace.</p>
    </div>
    <%= poetry_button(variant: :outline) do |button| %>
      <% button.with_leading { poetry_icon(name: :download) } %>
      Export invoices
    <% end %>
  </div>

  <%= poetry_separator %>

  <div class="grid gap-6 md:grid-cols-2">
    <%= poetry_card(title_tag: :h2) do |card| %>
      <% card.with_title { "Team plan" } %>
      <% card.with_description { "Billed monthly" } %>
      <% card.with_action do %>
        <%= poetry_badge(variant: :success) { "Active" } %>
      <% end %>
      <% card.with_footer do %>
        <div class="flex w-full items-center justify-between gap-4">
          <span class="text-xs text-muted-foreground">Billed to Acme Inc.</span>
          <div class="flex items-center gap-2">
            <%= poetry_button(variant: :ghost, size: :sm) { "Cancel plan" } %>
            <%= poetry_button(variant: :outline, size: :sm) { "Change plan" } %>
          </div>
        </div>
      <% end %>
      <div class="space-y-4 text-sm">
        <div class="flex items-baseline gap-1">
          <span class="text-3xl font-semibold tabular-nums">$49</span>
          <span class="text-sm text-muted-foreground">/ month</span>
        </div>
        <p class="text-muted-foreground">Next renewal on <span class="font-medium text-foreground">August 14, 2026</span></p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2">
            <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
            <span>Up to 25 seats</span>
          </li>
          <li class="flex items-center gap-2">
            <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
            <span>500 GB storage</span>
          </li>
          <li class="flex items-center gap-2">
            <%= poetry_icon(name: :check, class: "size-4 text-muted-foreground") %>
            <span>Priority support</span>
          </li>
        </ul>
      </div>
    <% end %>

    <%= poetry_card(title_tag: :h2) do |card| %>
      <% card.with_title { "Payment method" } %>
      <% card.with_description { "Used for the next invoice" } %>
      <% card.with_action do %>
        <%= poetry_badge(variant: :outline) { "Default" } %>
      <% end %>
      <% card.with_footer do %>
        <%= poetry_button(variant: :outline, size: :sm) do |button| %>
          <% button.with_leading { poetry_icon(name: :"credit-card") } %>
          Update payment method
        <% end %>
      <% end %>
      <div class="space-y-4 text-sm">
        <div class="flex items-center gap-3">
          <%= poetry_icon(name: :"credit-card", class: "size-6 text-muted-foreground") %>
          <div class="leading-tight">
            <div class="font-medium">Visa ending in 4242</div>
            <div class="text-xs text-muted-foreground">Expires 08/2027</div>
          </div>
        </div>
        <%= poetry_metadata_list(columns: :one) do |list| %>
          <% list.with_item(label: "Cardholder") { "Riley Chen" } %>
          <% list.with_item(label: "Billing email") { "billing@acme.example" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= poetry_card(title_tag: :h2) do |card| %>
    <% card.with_title { "Usage this period" } %>
    <% card.with_description { "Billing period: Jun 14 – Jul 14, 2026 · resets Jul 14" } %>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="space-y-1.5">
        <%= poetry_progress(label: "Seats", value: 18, max: 25) %>
        <p class="text-xs text-muted-foreground">18 of 25 seats used</p>
      </div>
      <div class="space-y-1.5">
        <%= poetry_progress(label: "API requests", value: 842, max: 1000) %>
        <p class="text-xs text-muted-foreground">842,300 of 1,000,000 requests</p>
      </div>
      <div class="space-y-1.5">
        <%= poetry_progress(label: "Storage", value: 312, max: 500) %>
        <p class="text-xs text-muted-foreground">312 GB of 500 GB used</p>
      </div>
    </div>
  <% end %>

  <%= poetry_card(title_tag: :h2) do |card| %>
    <% card.with_title { "Invoice history" } %>
    <% card.with_description { "Past invoices for this workspace" } %>
    <%= poetry_table do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Date" } %>
          <%= poetry_table_head { "Amount" } %>
          <%= poetry_table_head { "Status" } %>
          <%= poetry_table_head(class: "text-right") { "Receipt" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Jul 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$49.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell(class: "text-right") do %>
            <%= poetry_button(variant: :outline, size: :xs, href: "#", tag: :a) do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Jun 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$49.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell(class: "text-right") do %>
            <%= poetry_button(variant: :outline, size: :xs, href: "#", tag: :a) do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Download
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "May 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$49.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :warning) { "Pending" } } %>
          <%= poetry_table_cell(class: "text-right text-xs text-muted-foreground") { "Not available yet" } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Apr 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$49.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :destructive) { "Failed" } } %>
          <%= poetry_table_cell(class: "text-right text-xs text-muted-foreground") { "—" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
