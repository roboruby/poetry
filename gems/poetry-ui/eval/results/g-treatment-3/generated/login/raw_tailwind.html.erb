<div class="min-h-full flex items-center justify-center bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" />
        </svg>
      </span>
      <h1 class="mt-4 text-xl font-semibold tracking-tight text-slate-900">Meridian</h1>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <div class="mb-6 text-center">
        <h2 class="text-lg font-semibold text-slate-900">Sign in to your account</h2>
        <p class="mt-1 text-sm text-slate-500">Welcome back. Please enter your details.</p>
      </div>

      <form action="/session" method="post" class="space-y-5" novalidate>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700">Email address</label>
          <div class="mt-1.5">
            <input
              type="email"
              name="email"
              id="email"
              autocomplete="email"
              required
              class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"
              placeholder="you@company.com"
            >
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
            <a href="/password/new" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">Forgot password?</a>
          </div>
          <div class="mt-1.5">
            <input
              type="password"
              name="password"
              id="password"
              autocomplete="current-password"
              required
              class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"
              placeholder="••••••••••"
            >
          </div>
        </div>

        <div class="flex items-center">
          <input
            type="checkbox"
            name="remember_me"
            id="remember_me"
            class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-500/30"
          >
          <label for="remember_me" class="ml-2 block text-sm text-slate-600">Keep me signed in</label>
        </div>

        <button
          type="submit"
          class="flex w-full justify-center rounded-lg bg-indigo-600 px-3 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:ring-offset-2"
        >
          Sign in
        </button>
      </form>

      <div class="my-6 flex items-center gap-3" role="presentation">
        <div class="h-px flex-1 bg-slate-200"></div>
        <span class="text-xs font-medium uppercase tracking-wide text-slate-400">Or</span>
        <div class="h-px flex-1 bg-slate-200"></div>
      </div>

      <a
        href="/sso"
        class="flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:ring-offset-2"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="10" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        Continue with Single Sign-On
      </a>
    </div>

    <p class="mt-8 text-center text-sm text-slate-500">
      New to Meridian?
      <a href="/access-requests/new" class="font-medium text-indigo-600 hover:text-indigo-500">Request access</a>
    </p>
  </div>
</div>
