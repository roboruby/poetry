<%
  status_meta = {
    operational: { label: "Operational",          dot: "bg-emerald-500", text: "text-emerald-800", bg: "bg-emerald-50",  border: "border-emerald-200", bar: "bg-emerald-500" },
    degraded:    { label: "Degraded Performance",  dot: "bg-amber-500",   text: "text-amber-800",   bg: "bg-amber-50",    border: "border-amber-200",   bar: "bg-amber-400" },
    outage:      { label: "Partial Outage",        dot: "bg-red-500",     text: "text-red-800",     bg: "bg-red-50",      border: "border-red-200",     bar: "bg-red-500" },
  }

  today = Date.current

  build_history = lambda do |overrides|
    history = Array.new(90, :operational)
    overrides.each { |idx, status| history[idx] = status }
    history
  end

  services = [
    {
      name: "API",
      description: "Core REST & GraphQL endpoints",
      status: :operational,
      uptime: 99.98,
      history: build_history.call({ 71 => :degraded }),
    },
    {
      name: "Web Dashboard",
      description: "app.example.com",
      status: :operational,
      uptime: 99.99,
      history: build_history.call({}),
    },
    {
      name: "Database",
      description: "Primary datastore & replicas",
      status: :operational,
      uptime: 99.95,
      history: build_history.call({ 28 => :degraded, 29 => :degraded }),
    },
    {
      name: "Authentication",
      description: "Login, SSO & token issuance",
      status: :operational,
      uptime: 100.0,
      history: build_history.call({}),
    },
    {
      name: "Webhooks",
      description: "Outbound event delivery",
      status: :degraded,
      uptime: 98.72,
      history: build_history.call({ 56 => :outage, 88 => :degraded, 89 => :degraded }),
    },
    {
      name: "Email Delivery",
      description: "Transactional & digest email",
      status: :operational,
      uptime: 99.91,
      history: build_history.call({ 14 => :degraded }),
    },
  ]

  worst = services.map { |s| s[:status] }.max_by { |s| [:operational, :degraded, :outage].index(s) }
  overall = status_meta.fetch(worst)
  overall_headline = case worst
                      when :operational then "All Systems Operational"
                      when :degraded then "Some Systems Degraded"
                      else "Partial System Outage"
                      end

  incident = {
    title: "Elevated webhook delivery delays",
    impact: :degraded,
    updates: [
      { state: "Monitoring",   at: today.strftime("%b %-d, %Y") + " · 10:15 UTC", body: "A fix has been applied and webhook delivery latency has returned to normal levels. We're continuing to monitor before marking this resolved." },
      { state: "Identified",   at: today.strftime("%b %-d, %Y") + " · 09:40 UTC", body: "The cause has been identified as a saturated queue worker pool. Additional capacity is being deployed." },
      { state: "Investigating", at: today.strftime("%b %-d, %Y") + " · 08:55 UTC", body: "We are investigating reports of delayed webhook deliveries affecting a subset of customers." },
    ],
  }
%>
<main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
  <header class="mb-8">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold text-slate-900">Example Status</h1>
      <p class="text-sm text-slate-500">Last updated <%= today.strftime("%B %-d, %Y") %> · 10:20 UTC</p>
    </div>

    <div class="mt-6 flex items-center gap-3 rounded-lg border <%= overall[:border] %> <%= overall[:bg] %> px-4 py-4">
      <span class="relative flex h-3 w-3 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full <%= overall[:dot] %> opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full <%= overall[:dot] %>"></span>
      </span>
      <p class="text-base font-medium <%= overall[:text] %>"><%= overall_headline %></p>
    </div>
  </header>

  <section aria-labelledby="services-heading" class="mb-10">
    <h2 id="services-heading" class="text-lg font-semibold text-slate-900">Current status by service</h2>

    <div class="mt-4 flex items-center gap-4 text-xs text-slate-500">
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Operational</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-400"></span> Degraded</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-red-500"></span> Outage</span>
    </div>

    <ul class="mt-3 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% services.each do |service| %>
        <% meta = status_meta.fetch(service[:status]) %>
        <li class="px-5 py-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-medium text-slate-900"><%= service[:name] %></p>
              <p class="text-sm text-slate-500"><%= service[:description] %></p>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full <%= meta[:bg] %> px-2.5 py-1 text-xs font-medium <%= meta[:text] %>">
              <span class="h-1.5 w-1.5 rounded-full <%= meta[:dot] %>"></span>
              <%= meta[:label] %>
            </span>
          </div>

          <div class="mt-3">
            <div class="flex h-8 items-stretch gap-px overflow-hidden rounded" aria-hidden="true">
              <% service[:history].each do |day_status| %>
                <span class="min-w-[2px] flex-1 rounded-[1px] <%= status_meta.fetch(day_status)[:bar] %>"></span>
              <% end %>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs text-slate-500">
              <span>90 days ago</span>
              <span class="font-medium text-slate-700"><%= service[:uptime] %>% uptime</span>
              <span>Today</span>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section aria-labelledby="incident-heading" class="mb-10">
    <h2 id="incident-heading" class="text-lg font-semibold text-slate-900">Active incident</h2>

    <div class="mt-4 rounded-lg border <%= status_meta.fetch(incident[:impact])[:border] %> bg-white">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b <%= status_meta.fetch(incident[:impact])[:border] %> <%= status_meta.fetch(incident[:impact])[:bg] %> px-5 py-3">
        <h3 class="font-medium text-slate-900"><%= incident[:title] %></h3>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-xs font-medium <%= status_meta.fetch(incident[:impact])[:text] %>">
          <span class="h-1.5 w-1.5 rounded-full <%= status_meta.fetch(incident[:impact])[:dot] %>"></span>
          <%= status_meta.fetch(incident[:impact])[:label] %>
        </span>
      </div>

      <ol class="space-y-6 px-5 py-5">
        <% incident[:updates].each_with_index do |update, idx| %>
          <li class="relative pl-6">
            <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full <%= idx.zero? ? "bg-indigo-600" : "bg-slate-300" %>"></span>
            <% unless idx == incident[:updates].length - 1 %>
              <span class="absolute left-[4px] top-4 h-full w-px bg-slate-200"></span>
            <% end %>
            <p class="text-sm font-semibold text-slate-900"><%= update[:state] %></p>
            <p class="text-xs text-slate-500"><%= update[:at] %></p>
            <p class="mt-1 text-sm text-slate-600"><%= update[:body] %></p>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <section aria-labelledby="subscribe-heading">
    <h2 id="subscribe-heading" class="text-lg font-semibold text-slate-900">Get notified of updates</h2>
    <p class="mt-1 text-sm text-slate-500">Receive an email whenever incidents are created, updated, or resolved.</p>

    <form class="mt-4 flex flex-wrap gap-2" method="post">
      <label for="subscriber_email" class="sr-only">Email address</label>
      <input
        type="email"
        name="subscriber[email]"
        id="subscriber_email"
        required
        placeholder="you@example.com"
        class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
      >
      <button
        type="submit"
        class="shrink-0 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
      >
        Subscribe
      </button>
    </form>

    <details class="mt-4 text-sm">
      <summary class="cursor-pointer font-medium text-slate-700">Other ways to subscribe</summary>
      <ul class="mt-2 space-y-1 pl-4 text-slate-600">
        <li><a href="/status/history.atom" class="text-indigo-600 hover:underline">Atom feed</a></li>
        <li><a href="/status/history.rss" class="text-indigo-600 hover:underline">RSS feed</a></li>
        <li><a href="/status/history" class="text-indigo-600 hover:underline">Full incident history</a></li>
      </ul>
    </details>
  </section>
</main>
