<section class="space-y-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Acme Inc", href: "/workspaces/acme") %>
      <% crumb.with_item("Audit log") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
        <p class="text-sm text-muted-foreground max-w-2xl">
          Security-relevant activity across this workspace &mdash; sign-ins, permission changes,
          and data access &mdash; with the actor, origin, and severity of every event.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= poetry_button(variant: :outline, tag: :a, href: "?format=csv") do |button| %>
          <% button.with_leading { poetry_icon(name: :download) } %>
          Export CSV
        <% end %>
      </div>
    </div>
    <%= poetry_separator %>
  </header>

  <form method="get" action="" class="flex flex-wrap items-end gap-3 rounded-lg border bg-muted/30 p-4">
    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-search", class: "sr-only") { "Search events" } %>
      <%= poetry_search_field(id: "audit-search", name: "q", label: "Search events",
                               placeholder: "Search by actor, action, or IP address&hellip;") %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-severity") { "Severity" } %>
      <%= poetry_native_select(name: "severity", id: "audit-severity", size: :sm,
                               options: [["All severities", "all"], ["Critical", "critical"],
                                         ["High", "high"], ["Medium", "medium"], ["Low", "low"]]) %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-event-type") { "Event type" } %>
      <%= poetry_native_select(name: "event_type", id: "audit-event-type", size: :sm,
                               options: [["All events", "all"], ["Authentication", "authentication"],
                                         ["Permissions & roles", "permissions"], ["Data access", "data_access"],
                                         ["Workspace settings", "workspace_settings"], ["Billing", "billing"]]) %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-actor") { "Actor" } %>
      <%= poetry_native_select(name: "actor", id: "audit-actor", size: :sm,
                               options: [["All members", "all"], ["Priya Shah", "priya-shah"],
                                         ["Marcus Webb", "marcus-webb"], ["Elena Ortiz", "elena-ortiz"],
                                         ["Sam Okafor", "sam-okafor"], ["System", "system"]]) %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-from", class: "sr-only") { "From date" } %>
      <%= poetry_input_group(class: "w-40") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :calendar) %>
        <% end %>
        <%= poetry_input_group_input(id: "audit-from", name: "from", type: "date") %>
      <% end %>
    </div>
    <div class="flex flex-col gap-1.5">
      <%= poetry_label(for_id: "audit-to", class: "sr-only") { "To date" } %>
      <%= poetry_input_group(class: "w-40") do %>
        <%= poetry_input_group_addon do %>
          <%= poetry_icon(name: :calendar) %>
        <% end %>
        <%= poetry_input_group_input(id: "audit-to", name: "to", type: "date") %>
      <% end %>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <%= poetry_button(variant: :ghost, tag: :a, href: "?") do |button| %>
        <% button.with_leading { poetry_icon(name: :x) } %>
        Clear
      <% end %>
      <%= poetry_button(type: :submit) do |button| %>
        <% button.with_leading { poetry_icon(name: :filter) } %>
        Apply filters
      <% end %>
    </div>
  </form>

  <div class="overflow-hidden rounded-lg border">
