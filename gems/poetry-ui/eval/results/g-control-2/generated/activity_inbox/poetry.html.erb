          <%= poetry_item(role: "listitem", variant: :default) do |item| %>
            <% item.with_media(variant: :icon) { poetry_icon(name: :"at-sign") } %>
            <% item.with_title do %>
              Priya Shah mentioned you in <%= poetry_link(href: "#") { "Q3 Roadmap Review" } %>
              <%= poetry_badge(variant: :info) { "Unread" } %>
            <% end %>
            <% item.with_description { "Mention · 25 minutes ago" } %>
            <% item.with_actions do %>
              <%= poetry_button(variant: :ghost, size: :sm) do |button| %>
                <% button.with_leading { poetry_icon(name: :check) } %>
                Mark as read
              <% end %>
              <%= poetry_button(variant: :outline, size: :sm, href: "#", tag: :a) do |button| %>
                Open
                <% button.with_trailing { poetry_icon(name: :"arrow-up-right") } %>
