<div class="mx-auto max-w-3xl space-y-6 p-6">
  <header class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Activity</h1>
        <p class="text-sm text-muted-foreground">Mentions, assignments, and status changes across your work.</p>
      </div>
      <%= poetry_button(variant: :outline) do |button| %>
        <% button.with_leading { poetry_icon(name: :"check-check") } %>
        Mark all as read
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

