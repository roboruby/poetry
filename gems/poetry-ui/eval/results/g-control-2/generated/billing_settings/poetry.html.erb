<div class="mx-auto max-w-5xl p-6 space-y-8">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Team settings", href: "/settings") %>
      <% crumb.with_item("Billing") %>
    <% end %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Billing</h1>
        <p class="text-sm text-muted-foreground">Manage the Acme Corp workspace plan, payment method, usage and invoices.</p>
      </div>
      <%= poetry_button(variant: :outline, tag: :a, href: "/settings/billing/portal") do |button| %>
        <% button.with_trailing { poetry_icon(name: :"arrow-right") } %>
        Manage in billing portal
      <% end %>
    </div>
    <%= poetry_separator %>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <%= poetry_card(title_tag: :h2) do |card| %>
      <% card.with_title { "Team plan" } %>
      <% card.with_description { "The plan this workspace is currently billed on." } %>
      <% card.with_action do %>
        <%= poetry_badge(variant: :success) { "Active" } %>
      <% end %>
      <% card.with_footer do %>
        <div class="flex w-full items-center justify-between gap-4">
          <%= poetry_link(href: "/settings/billing/plans", underline: :always) { "Compare plans" } %>
          <%= poetry_button(variant: :outline, size: :sm, tag: :a, href: "/settings/billing/plans/change") { "Change plan" } %>
        </div>
      <% end %>
      <%= poetry_metadata_list(columns: :two) do |list| %>
        <% list.with_item(label: "Price") { "$249.00 / month" } %>
        <% list.with_item(label: "Billing cycle") { "Monthly" } %>
        <% list.with_item(label: "Renews on") { "August 14, 2026" } %>
        <% list.with_item(label: "Plan started") { "January 14, 2026" } %>
      <% end %>
    <% end %>

    <%= poetry_card(title_tag: :h2) do |card| %>
      <% card.with_title { "Payment method" } %>
      <% card.with_description { "Charged automatically on the renewal date." } %>
      <% card.with_action do %>
        <%= poetry_badge(variant: :secondary) { "Default" } %>
      <% end %>
      <% card.with_footer do %>
        <%= poetry_button(variant: :outline, size: :sm, tag: :a, href: "/settings/billing/payment_method/edit") do |button| %>
          <% button.with_leading { poetry_icon(name: :"credit-card") } %>
          Update payment method
        <% end %>
      <% end %>
      <%= poetry_metadata_list(columns: :two) do |list| %>
        <% list.with_item(label: "Card") { "Visa ending in 4242" } %>
        <% list.with_item(label: "Expires") { "09/2027" } %>
        <% list.with_item(label: "Billing email") { "billing@acme-corp.com" } %>
        <% list.with_item(label: "Billing address") { "500 Market St, Suite 200, San Francisco, CA 94105" } %>
      <% end %>
    <% end %>
  </div>

  <%= poetry_card(title_tag: :h2) do |card| %>
    <% card.with_title { "Usage this period" } %>
    <% card.with_description { "Jul 15 – Aug 14, 2026 billing cycle" } %>
    <div class="space-y-6">
      <%= poetry_meter(label: "Team members", value: 12, max: 20, value_label: "12 of 20 seats") %>
      <%= poetry_meter(label: "API requests", value: 842_000, max: 1_000_000, value_label: "842K of 1M requests") %>
      <%= poetry_meter(label: "Storage", value: 68, max: 100, value_label: "68 GB of 100 GB") %>
    </div>
    <% card.with_footer do %>
      <p class="text-xs text-muted-foreground">Usage resets at the start of each billing cycle. Exceeding a limit does not interrupt service; overage is billed on the next invoice.</p>
    <% end %>
  <% end %>

  <%= poetry_card(title_tag: :h2) do |card| %>
    <% card.with_title { "Invoice history" } %>
    <% card.with_description { "Invoices billed to this workspace." } %>
    <% card.with_footer do %>
      <div class="flex w-full items-center justify-between gap-4">
        <span class="text-xs text-muted-foreground">Showing the last 6 invoices</span>
        <%= poetry_link(href: "/settings/billing/invoices", underline: :always, class: "inline-flex items-center gap-1") do %>
          View all invoices <%= poetry_icon(name: :"arrow-right", class: "size-3.5") %>
        <% end %>
      </div>
    <% end %>
    <%= poetry_table(caption: "Invoices for the last 6 billing cycles") do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Invoice" } %>
          <%= poetry_table_head { "Date" } %>
          <%= poetry_table_head { "Amount" } %>
          <%= poetry_table_head { "Status" } %>
          <%= poetry_table_head { "Receipt" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-006" } %>
          <%= poetry_table_cell { "Jun 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$249.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :info) { "Pending" } } %>
          <%= poetry_table_cell { content_tag(:span, "Awaiting payment", class: "text-sm text-muted-foreground") } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-005" } %>
          <%= poetry_table_cell { "May 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$249.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "/settings/billing/invoices/INV-2026-005/receipt.pdf") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Receipt
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-004" } %>
          <%= poetry_table_cell { "Apr 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$249.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "/settings/billing/invoices/INV-2026-004/receipt.pdf") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Receipt
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-003" } %>
          <%= poetry_table_cell { "Mar 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$199.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :outline) { "Refunded" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "/settings/billing/invoices/INV-2026-003/receipt.pdf") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Receipt
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-002" } %>
          <%= poetry_table_cell { "Feb 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$199.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "/settings/billing/invoices/INV-2026-002/receipt.pdf") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Receipt
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "INV-2026-001" } %>
          <%= poetry_table_cell { "Jan 14, 2026" } %>
          <%= poetry_table_cell(class: "tabular-nums") { "$199.00" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Paid" } } %>
          <%= poetry_table_cell do %>
            <%= poetry_button(variant: :ghost, size: :sm, tag: :a, href: "/settings/billing/invoices/INV-2026-001/receipt.pdf") do |button| %>
              <% button.with_leading { poetry_icon(name: :download) } %>
              Receipt
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
