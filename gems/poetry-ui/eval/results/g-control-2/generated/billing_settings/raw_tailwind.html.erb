<main class="mx-auto max-w-5xl px-6 py-10">
  <header class="mb-8">
    <p class="text-sm font-medium text-slate-500">Acme Robotics &middot; Team workspace</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Billing</h1>
    <p class="mt-2 text-sm text-slate-600">Manage your plan, payment method, usage, and invoices.</p>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <%# Current plan %>
    <section aria-labelledby="current-plan-heading" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 id="current-plan-heading" class="text-base font-semibold text-slate-900">Current plan</h2>
          <p class="mt-1 text-sm text-slate-500">Your workspace subscription</p>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
          Active
        </span>
      </div>

      <div class="mt-5 flex flex-wrap items-end justify-between gap-4 border-t border-slate-100 pt-5">
        <div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-semibold text-slate-900">Business</span>
            <span class="text-sm text-slate-500">plan</span>
          </div>
          <p class="mt-1 text-sm text-slate-600">
            <span class="font-medium text-slate-900">$49</span> / month &middot; billed monthly for up to 25 seats
          </p>
          <p class="mt-1 text-sm text-slate-600">Renews on <span class="font-medium text-slate-900">August 15, 2026</span></p>
        </div>
        <div class="flex gap-2">
          <a href="#" class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
            Change plan
          </a>
          <details class="relative">
            <summary class="inline-flex cursor-pointer list-none items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
              More
            </summary>
            <div class="absolute right-0 z-10 mt-2 w-48 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
              <a href="#" class="block px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">View plan comparison</a>
              <a href="#" class="block px-3 py-2 text-sm text-red-600 hover:bg-red-50">Cancel plan</a>
            </div>
          </details>
        </div>
      </div>
    </section>

    <%# Payment method %>
    <section aria-labelledby="payment-method-heading" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 id="payment-method-heading" class="text-base font-semibold text-slate-900">Payment method</h2>
      <p class="mt-1 text-sm text-slate-500">Used for your monthly invoice</p>

      <div class="mt-5 flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
        <svg viewBox="0 0 36 24" class="h-6 w-9 flex-none rounded" aria-hidden="true">
          <rect width="36" height="24" rx="4" fill="#1A1F71" />
          <text x="18" y="16" text-anchor="middle" font-size="9" font-weight="700" fill="#ffffff" font-family="Arial, sans-serif">VISA</text>
        </svg>
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-slate-900">Visa ending in 4242</p>
          <p class="text-sm text-slate-500">Expires 09/2027</p>
        </div>
      </div>

      <dl class="mt-4 space-y-1 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Billing name</dt>
          <dd class="text-slate-900">Matt Solt</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Billing email</dt>
          <dd class="text-slate-900">mattsolt@gmail.com</dd>
        </div>
      </dl>

      <a href="#" class="mt-5 inline-flex w-full items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
        Update payment method
      </a>
    </section>
  </div>

  <%# Usage this period %>
  <section aria-labelledby="usage-heading" class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-baseline justify-between">
      <h2 id="usage-heading" class="text-base font-semibold text-slate-900">Usage this period</h2>
      <p class="text-sm text-slate-500">July 15 &ndash; August 15, 2026</p>
    </div>

    <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-medium text-slate-700">Seats</span>
          <span class="text-slate-500">18 of 25 used</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100" aria-label="Seats used">
          <div class="h-full rounded-full bg-slate-900" style="width: 72%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-medium text-slate-700">Storage</span>
          <span class="text-slate-500">240 GB of 500 GB used</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="48" aria-valuemin="0" aria-valuemax="100" aria-label="Storage used">
          <div class="h-full rounded-full bg-slate-900" style="width: 48%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-medium text-slate-700">API requests</span>
          <span class="text-slate-500">82,400 of 100,000 used</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="82" aria-valuemin="0" aria-valuemax="100" aria-label="API requests used">
          <div class="h-full rounded-full bg-amber-500" style="width: 82%"></div>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-medium text-slate-700">Projects</span>
          <span class="text-slate-500">19 of 20 used</span>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100" aria-label="Projects used">
          <div class="h-full rounded-full bg-red-500" style="width: 95%"></div>
        </div>
        <p class="mt-1 text-xs text-red-600">Approaching plan limit &mdash; consider upgrading.</p>
      </div>
    </div>
  </section>

