<div class="mx-auto max-w-5xl space-y-8 p-6">
  <header class="flex flex-col gap-4">
    <%= poetry_breadcrumb do |crumb| %>
      <% crumb.with_item("Home", href: "/") %>
      <% crumb.with_item("Projects", href: "/projects") %>
      <% crumb.with_item("Atlas Platform Migration") %>
    <% end %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-semibold tracking-tight">Atlas Platform Migration</h1>
          <%= poetry_badge(variant: :warning) { "In progress" } %>
        </div>
        <p class="max-w-2xl text-sm text-muted-foreground">
          Migrate the core billing and reporting services off the legacy platform onto the new
          event-driven infrastructure, with zero downtime for existing customers.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <%= poetry_button(variant: :outline) do |button| %>
          <% button.with_leading { poetry_icon(name: :archive) } %>
          Archive
        <% end %>
        <%= poetry_button do |button| %>
          <% button.with_leading { poetry_icon(name: :pencil) } %>
          Edit project
        <% end %>
      </div>
    </div>

    <%= poetry_separator %>
  </header>

  <%= poetry_metadata_list(columns: :three) do |list| %>
    <% list.with_item(label: "Owner") do %>
      <div class="flex items-center gap-2">
        <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
        <span>Priya Shah</span>
      </div>
    <% end %>
    <% list.with_item(label: "Start date") { "Feb 3, 2026" } %>
    <% list.with_item(label: "Target completion") { "Sep 18, 2026" } %>
    <% list.with_item(label: "Created") { "Jan 22, 2026" } %>
    <% list.with_item(label: "Last updated") { "Jul 20, 2026" } %>
    <% list.with_item(label: "Status") do %>
      <%= poetry_badge(variant: :warning) { "In progress" } %>
    <% end %>
  <% end %>

  <%= poetry_card do |card| %>
    <% card.with_title(title_tag: :h2) { "Milestones" } %>
    <% card.with_description { "Key delivery checkpoints for this project." } %>

    <%= poetry_timeline do |timeline| %>
      <% timeline.with_item(title: "Kickoff & discovery", time: "Feb 3, 2026", completed: true) do %>
        Requirements gathered and stakeholder sign-off secured.
      <% end %>
      <% timeline.with_item(title: "Architecture review", time: "Mar 21, 2026", completed: true) do %>
        Target architecture approved by the platform review board.
      <% end %>
      <% timeline.with_item(title: "Beta rollout", time: "Jun 30, 2026", completed: true) do %>
        Migrated services enabled for the internal beta cohort.
      <% end %>
      <% timeline.with_item(title: "Data migration cutover", time: "Aug 15, 2026") do %>
        Production data cut over to the new event-driven pipeline.
      <% end %>
      <% timeline.with_item(title: "General availability", time: "Sep 18, 2026") do %>
        Legacy platform decommissioned; migration complete for all customers.
      <% end %>
    <% end %>
  <% end %>

  <%= poetry_card do |card| %>
    <% card.with_title(title_tag: :h2) { "Recent tasks" } %>
    <% card.with_description { "The five most recently updated tasks on this project." } %>

    <%= poetry_table do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Task" } %>
          <%= poetry_table_head { "Assignee" } %>
          <%= poetry_table_head { "Due date" } %>
          <%= poetry_table_head { "Status" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Cut over billing event consumers" } %>
          <%= poetry_table_cell do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
              <span>Priya Shah</span>
            </div>
          <% end %>
          <%= poetry_table_cell { "Aug 1, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :info) { "In progress" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Backfill reporting warehouse schema" } %>
          <%= poetry_table_cell do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Dan Okafor", size: :sm) { "DO" } %>
              <span>Dan Okafor</span>
            </div>
          <% end %>
          <%= poetry_table_cell { "Aug 5, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Not started" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Write cutover rollback runbook" } %>
          <%= poetry_table_cell do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Mei Lin", size: :sm) { "ML" } %>
              <span>Mei Lin</span>
            </div>
          <% end %>
          <%= poetry_table_cell { "Jul 28, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :success) { "Complete" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Load test the event-driven pipeline" } %>
          <%= poetry_table_cell do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Priya Shah", size: :sm) { "PS" } %>
              <span>Priya Shah</span>
            </div>
          <% end %>
          <%= poetry_table_cell { "Jul 30, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :info) { "In progress" } } %>
        <% end %>
        <%= poetry_table_row do %>
          <%= poetry_table_cell { "Notify customers of the migration window" } %>
          <%= poetry_table_cell do %>
            <div class="flex items-center gap-2">
              <%= poetry_avatar(label: "Dan Okafor", size: :sm) { "DO" } %>
              <span>Dan Okafor</span>
            </div>
          <% end %>
          <%= poetry_table_cell { "Aug 10, 2026" } %>
          <%= poetry_table_cell { poetry_badge(variant: :secondary) { "Not started" } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
