    ]
  },
  {
    "name": "Combobox: pick Japan then clear",
    "messages": [{ "role": "user", "type": "message", "content": "Select Japan as the country, then clear it" }],
    "expectedCall": [
      { "functionName": "poetry.country.set_value", "arguments": { "value": "jp" } },
      { "functionName": "poetry.country.clear", "arguments": {} }
    ]
  },
  {
    "name": "Declarative: search the docs for combobox",
    "messages": [{ "role": "user", "type": "message", "content": "Find the combobox docs" }],
