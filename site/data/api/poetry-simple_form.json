    {
      "path": "Poetry::SimpleForm",
      "type": "module",
      "superclass": null,
      "docstring": "The simple_form migration bridge: one initializer re-maps simple_form's\ninput types onto classes that render whole poetry Fields through\nPoetry::Ui::FormBuilder. Every f.input keeps working; every poetry form\ncontrol is reachable by name through as:.",
      "examples": [],
      "file": "lib/poetry/simple_form.rb",
      "methods": [
        {
          "name": "activate!",
          "scope": "class",
          "group": null,
          "signature": "activate!",
          "docstring": "Install the bridge: map every type in INPUTS and make the flat poetry\nwrapper the default (the Field owns its chrome, so the wrapper\ncontributes only display: contents).",
          "params": [],
          "return": {
            "types": [
              "void"
            ],
            "text": ""
          },
          "examples": [],
          "file": "lib/poetry/simple_form.rb",
          "line": 69
        }
      ],
      "constants": [
        {
          "name": "BRIDGE_EXEMPT",
          "value": "{}.freeze",
          "docstring": "Form-facing poetry components deliberately not reachable through a\nsimple_form type, with the reason (empty today; the gate reads it)."
        },
        {
          "name": "COVERAGE",
          "value": "{\n  string: \"input\", email: \"input\", url: \"input\", tel: \"input\", citext: \"input\", uuid: \"input\",\n  password: \"input\", search: \"search_field\", sensitive: \"sensitive_input\",\n  text: \"textarea\", hstore: ",
          "docstring": "simple_form input type => the poetry component it renders (a registry\nkey).\nThe parity gate (test/poetry/simple_form/coverage_test.rb) checks this\nagainst every form-facing component in the registry."
        },
        {
          "name": "INPUTS",
          "value": "{\n  string: Inputs::StringInput, email: Inputs::StringInput, url: Inputs::StringInput,\n  tel: Inputs::StringInput, search: Inputs::StringInput, citext: Inputs::StringInput,\n  uuid: Inputs::StringInput",
          "docstring": "simple_form input type => bridge input class. activate! installs\nexactly this table, so the coverage below cannot drift from it."
        },
        {
          "name": "STOCK",
          "value": "{\n  rich_text_area: \"poetry ships no rich-text editor\",\n  hidden: \"nothing to render\",\n  country: \"the country list comes from the country_select gem, which poetry does not depend on\"\n}.freeze",
          "docstring": "simple_form types left to simple_form entirely, with the reason."
        },
        {
          "name": "VERSION",
          "value": "\"0.0.3\"",
          "docstring": "The gem version."
        }
      ]
