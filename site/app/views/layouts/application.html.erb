<!DOCTYPE html>
<html class="style-default">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} — poetry" : "poetry" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# poetry_optimistic_form's prerequisite: failure
        reconciliation is a Turbo refresh that must MORPH to be seamless. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Advertise the page's markdown twin to crawlers (paired with the
        HTTP Link header the MarkdownMirror concern sets). %>
    <% if respond_to?(:markdown_alternate_path) && (md_path = markdown_alternate_path) %>
      <link rel="alternate" type="text/markdown" href="<%= md_path %>">
    <% end %>

    <%# Apply the stored dark mode AND component style BEFORE first paint.
        The style axis swaps the server-rendered style-default for
        the stored choice; style_controller.js switches it live. %>
    <script>
      try {
        const stored = localStorage.getItem("poetry-docs-theme")
        if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark")
        }
        const style = localStorage.getItem("poetry-docs-style")
        if (style && style !== "default" && /^[a-z]{4,7}$/.test(style)) {
          document.documentElement.classList.replace("style-default", "style-" + style)
        }
      } catch {}
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme" class="min-h-screen bg-background text-foreground antialiased">
    <%= poetry_sidebar(collapsible: :icon) do |shell| %>
      <% shell.with_nav do %>
        <%= poetry_sidebar_header do %>
          <%= link_to root_path, class: "flex items-center gap-2 px-2 py-1.5 text-sm font-semibold " \
                                        "group-data-[collapsible=icon]:size-8 " \
                                        "group-data-[collapsible=icon]:justify-center " \
                                        "group-data-[collapsible=icon]:p-2" do %>
            <%= poetry_icon(name: :feather, class: "size-4 shrink-0") %>
            <span class="group-data-[collapsible=icon]:hidden">poetry</span>
          <% end %>
        <% end %>
        <%= poetry_sidebar_content do %>
          <%= poetry_sidebar_group do %>
            <%= poetry_sidebar_menu do %>
              <%= poetry_sidebar_menu_item do %>
                <%= poetry_sidebar_menu_button(href: root_path, active: current_page?(root_path)) do %>
                  <%= poetry_icon(name: :house) %><span>Introduction</span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <%# The nav sections, one per group, in two mode-gated forms: the
              expanded sidebar gets a disclosure (closed by default, the
              current page's section open); the icon rail swaps it for a
              HoverCard - hovering the icon flies the section's links out
              beside the rail, clicking it expands the sidebar. Get Started
              matches by its entries' exact paths (top-level slugs); the
              galleries match by path prefix. %>
          <% [["Get Started", :rocket, nil, DocsCatalog.docs],
              ["Components", :component, "/components", DocsCatalog.components],
              ["Charts", :"chart-area", "/charts", DocsCatalog.charts],
              ["Blocks", :"layout-template", "/blocks", DocsCatalog.blocks],
              ["Demos", :"monitor-play", "/demos", DocsCatalog.demos],
              ["API", :braces, "/api/", DocsCatalog.apis]].each do |title, icon, prefix, entries| %>
            <%= poetry_sidebar_group(class: "py-1") do %>
              <% section_active = prefix ? request.path.start_with?(prefix) : entries.any? { |e| e.path == request.path } %>
              <div class="hidden group-data-[collapsible=icon]:block">
                <%= poetry_hover_card(side: :right, align: :start, side_offset: 8, open_delay: 150,
                                      content_class: "w-60 max-h-[70vh] overflow-y-auto p-2") do |card| %>
                  <% card.with_trigger(tag: :button, type: "button", "aria-label": title, title: title,
                                       class: "flex size-8 items-center justify-center rounded-md " \
                                              "text-sidebar-foreground/70 transition-colors " \
                                              "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
                                       data: { action: "click->poetry--core--sidebar#open" }) do %>
                    <%= poetry_icon(name: icon, class: "size-4") %>
                  <% end %>
                  <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground"><%= title %></div>
                  <nav class="flex flex-col gap-0.5" aria-label="<%= title %>">
                    <% entries.each do |entry| %>
                      <%= link_to entry.title, entry.path,
                                  class: "rounded-md px-2 py-1.5 text-sm transition-colors " \
                                         "hover:bg-accent hover:text-accent-foreground " \
                                         "#{"bg-accent text-accent-foreground" if current_page?(entry.path)}" %>
                    <% end %>
                  </nav>
                <% end %>
              </div>
              <%= poetry_collapsible(open: section_active,
                                     class: "group/collapsible group-data-[collapsible=icon]:hidden") do |section| %>
                <% section.with_trigger(class: "flex w-full items-center gap-2 rounded-md px-2 py-1.5 " \
                                               "text-xs font-medium text-sidebar-foreground/70 transition-colors " \
                                               "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground") do %>
                  <%= poetry_icon(name: icon, class: "size-4 shrink-0") %>
                  <span><%= title %></span>
                  <%= poetry_icon(name: :"chevron-right",
                                  class: "ml-auto size-3.5 shrink-0 transition-transform duration-200 " \
                                         "group-data-[open]/collapsible:rotate-90") %>
                <% end %>
                <%= poetry_sidebar_group_content(class: "pt-1") do %>
                  <%= poetry_sidebar_menu do %>
                    <% entries.each do |entry| %>
                      <%= poetry_sidebar_menu_item do %>
                        <%= poetry_sidebar_menu_button(href: entry.path, active: current_page?(entry.path)) do %>
                          <% if entry.icon %><%= poetry_icon(name: entry.icon) %><% end %>
                          <span><%= entry.title %></span>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= poetry_sidebar_footer do %>
          <%# One release version across every gem - poetry-ui speaks for
              the suite. The rail keeps just the number. %>
          <div class="px-2 py-1 text-xs text-muted-foreground group-data-[collapsible=icon]:px-0
                      group-data-[collapsible=icon]:text-center">
            <span class="group-data-[collapsible=icon]:hidden">poetry </span><%= Poetry::Ui::VERSION %>
          </div>
        <% end %>
      <% end %>
      <% shell.with_inset do %>
        <header class="sticky top-0 z-40 flex h-14 items-center gap-2 border-b bg-background/95 px-4 backdrop-blur">
          <%= poetry_sidebar_trigger %>
          <div class="hidden truncate lg:block"><%= yield :breadcrumb %></div>
          <div class="ml-auto flex items-center gap-2">
            <%= render "shared/site_nav" %>
            <%= render "shared/search" %>
            <%# The theme switcher is itself styled by the theme it switches, so
                its native-select width would otherwise track each theme's font/
                padding and jump on change. class: "w-full" overrides the
                component's w-fit wrapper so the select fills this fixed w-28 -
                a stable-width control, no horizontal jump between themes. %>
            <div data-controller="style" data-action="change->style#apply" class="w-28">
              <label for="style-switcher" class="sr-only">Component style</label>
              <%= poetry_native_select(name: "style", id: "style-switcher", class: "w-full",
                                       options: %w[default vega nova mira rhea maia luma lyra sera].map { |s| [s, s] },
                                       selected: "default") %>
            </div>
            <%= poetry_button(variant: :ghost, size: :"icon-sm", label: "Toggle theme",
                              data: { action: "click->theme#toggle" }) do %>
              <%= poetry_icon(name: :sun, class: "dark:hidden") %>
              <%= poetry_icon(name: :moon, class: "hidden dark:block") %>
            <% end %>
          </div>
        </header>
        <main class="mx-auto w-full max-w-4xl flex-1 p-6 lg:p-10">
          <%= yield %>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
