<%# A message's first appearance: the row inside its scroller item (the
    wrapper MessageScroller anchors and keys rows by), so a streamed
    message joins the list exactly like the server-rendered history. %>
<%= poetry_message_scroller_item(id: "item-#{message.id}", class: "px-4") do %>
  <%= render "agui_relay/row", message: message, version: version %>
<% end %>
