<%# The top nav: the NavigationMenu morphing viewport in production -
    switching between the two panels morphs the shared popup. %>
<div class="hidden lg:block">
  <%= poetry_navigation_menu(label: "Site", viewport: true) do |nav| %>
    <% nav.with_item("Get Started", value: "start") do %>
      <div class="grid w-64 gap-1">
        <%= poetry_navigation_menu_link(href: root_path) { "Introduction" } %>
        <%= poetry_navigation_menu_link(href: "/components/button") { "Components" } %>
        <%= poetry_navigation_menu_link(href: "/charts/area") { "Charts" } %>
      </div>
    <% end %>
    <% nav.with_item("Resources", value: "resources") do %>
      <div class="grid w-80 gap-1">
        <%= poetry_navigation_menu_link(href: "/installation.md") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">installation.md</div>
            <p class="text-xs text-muted-foreground">Copy-and-follow setup for a coding agent</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/poetry/llms.txt") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">llms.txt</div>
            <p class="text-xs text-muted-foreground">Structured docs index for LLMs</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/poetry/llms-full.txt") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">llms-full.txt</div>
            <p class="text-xs text-muted-foreground">Every doc inlined into one file for context</p>
          </div>
        <% end %>
        <%= poetry_navigation_menu_link(href: "/r/registry.json") do %>
          <div class="space-y-0.5">
            <div class="text-sm font-medium">registry.json</div>
            <p class="text-xs text-muted-foreground">Component registry for poetry:add and tools</p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
