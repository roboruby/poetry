<%# The Styles-API tables:
    the registry-published part contract - parts, state attributes, var
    seams - rendered straight from component_registry.yml. The gems'
    part-contract tier reconciles every row against rendered DOM in CI,
    so nothing on this page can drift from the real anatomy. %>
<% states = parts.flat_map { |part| (part["states"] || []).map { |state| [part["name"], state] } } %>
<% vars = parts.flat_map { |part| (part["vars"] || []).map { |var| [part["name"], var] } } %>
<section id="styling" class="flex flex-col gap-6">
  <header class="flex flex-col gap-2">
    <h2 class="text-2xl font-semibold tracking-tight">Styling</h2>
    <p class="max-w-2xl text-sm text-muted-foreground">
      Every part carries a stable <code class="font-mono">data-slot</code> attribute — target
      <code class="font-mono">[data-slot=…]</code> from your own CSS to restyle it. State rides
      data attributes on the parts below. This contract is verified against rendered DOM in CI.
    </p>
  </header>

  <div class="overflow-x-auto">
    <%= poetry_table do %>
      <%= poetry_table_header do %>
        <%= poetry_table_row do %>
          <%= poetry_table_head { "Part" } %>
          <%= poetry_table_head { "Description" } %>
        <% end %>
      <% end %>
      <%= poetry_table_body do %>
        <% parts.each do |part| %>
          <%= poetry_table_row do %>
            <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { "[data-slot=#{part["name"]}]" } %>
            <%= poetry_table_cell(class: "text-muted-foreground") { part["description"] } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if states.any? %>
    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-medium">State attributes</h3>
      <div class="overflow-x-auto">
        <%= poetry_table do %>
          <%= poetry_table_header do %>
            <%= poetry_table_row do %>
              <%= poetry_table_head { "Part" } %>
              <%= poetry_table_head { "Attribute" } %>
              <%= poetry_table_head { "Condition" } %>
              <%= poetry_table_head { "Values" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <% states.each do |part_name, state| %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { part_name } %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { state["attr"] } %>
                <%= poetry_table_cell(class: "text-muted-foreground") { state["condition"] } %>
                <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") do %>
                  <%= state["values"] ? state["values"].join(" · ") : "—" %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if vars.any? %>
    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-medium">CSS variables</h3>
      <div class="overflow-x-auto">
        <%= poetry_table do %>
          <%= poetry_table_header do %>
            <%= poetry_table_row do %>
              <%= poetry_table_head { "Part" } %>
              <%= poetry_table_head { "Variable" } %>
              <%= poetry_table_head { "Description" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <% vars.each do |part_name, var| %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { part_name } %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { var["name"] } %>
                <%= poetry_table_cell(class: "text-muted-foreground") { var["description"] } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if defined?(tools) && tools.present? %>
    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-medium" id="agent-tools">Agent tools</h3>
      <p class="max-w-2xl text-sm text-muted-foreground">
        What an agent may do to a rendered instance once the call opts in
        (<code class="font-mono">webmcp: "name"</code>) — declared beside the wiring, projected
        to the registry, registered with the browser's <code class="font-mono">document.modelContext</code>
        by <%= link_to "poetry-agent", webmcp_path, class: "underline underline-offset-4" %>.
      </p>
      <div class="overflow-x-auto">
        <%= poetry_table do %>
          <%= poetry_table_header do %>
            <%= poetry_table_row do %>
              <%= poetry_table_head { "Tool" } %>
              <%= poetry_table_head { "Parameters" } %>
              <%= poetry_table_head { "Does" } %>
              <%= poetry_table_head { "Dispatches" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <% tools.each do |tool| %>
              <%= poetry_table_row do %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") do %>
                  <%= tool["name"] %>
                  <span class="ml-1 font-sans text-muted-foreground"><%= tool.dig("annotations", "readOnlyHint") ? "read-only" : "mutating" %></span>
                <% end %>
                <%= poetry_table_cell(class: "font-mono text-xs text-muted-foreground") do %>
                  <% properties = tool.dig("inputSchema", "properties") || {} %>
                  <% required = tool.dig("inputSchema", "required") || [] %>
                  <%= properties.map { |name, spec| "#{name} (#{spec["type"]}#{required.include?(name) ? ", required" : ""})" }.join(", ").presence || "—" %>
                <% end %>
                <%= poetry_table_cell(class: "text-muted-foreground") { tool["description"] } %>
                <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") { tool["executes"] } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if defined?(wiring) && wiring.present? %>
    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-medium" id="wiring">Wiring</h3>
      <p class="max-w-2xl text-sm text-muted-foreground">
        The Stimulus surface each element carries — declared in the component,
        verified against rendered DOM in CI. Bare actions fire on the
        element's default event.
      </p>
      <div class="overflow-x-auto">
        <%= poetry_table do %>
          <%= poetry_table_header do %>
            <%= poetry_table_row do %>
              <%= poetry_table_head { "Element" } %>
              <%= poetry_table_head { "Controller" } %>
              <%= poetry_table_head { "Wiring" } %>
            <% end %>
          <% end %>
          <%= poetry_table_body do %>
            <% wiring.each do |element| %>
              <% element["controllers"].each do |controller| %>
                <%= poetry_table_row do %>
                  <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") do %>
                    <%= element["element"] %><%= " (#{element["conditional"]})" if element["conditional"] %>
                  <% end %>
                  <%= poetry_table_cell(class: "whitespace-nowrap font-mono text-xs") do %>
                    <%= controller["identifier"] %><%= " (#{controller["conditional"]})" if controller["conditional"] %>
                  <% end %>
                  <%= poetry_table_cell(class: "text-muted-foreground") do %>
                    <% facets = [] %>
                    <% facets << (controller["registers"] == true ? "registers" : "registers (#{controller["registers"]})") if controller["registers"] %>
                    <% (controller["values"] || []).each do |value| %>
                      <% facets << "value #{value["name"]}#{" (#{value["conditional"]})" if value["conditional"]}" %>
                    <% end %>
                    <% (controller["actions"] || []).each do |action| %>
                      <% events = Array(action["on"]).join("/") %>
                      <% events = "#{events}@#{action["at"]}" if action["at"] %>
                      <% facets << "#{action["method"]}#{" on #{events}" if events.present?}#{" (#{action["conditional"]})" if action["conditional"]}" %>
                    <% end %>
                    <% (controller["targets"] || []).each do |target| %>
                      <% facets << "target #{target["name"]}#{" (#{target["conditional"]})" if target["conditional"]}" %>
                    <% end %>
                    <%= facets.join(" · ") %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
