<% content_for :title, "Installation" %>
<% content_for :breadcrumb do %>
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Docs", href: introduction_path) %>
    <% crumb.with_item("Installation") %>
  <% end %>
<% end %>
<%
  # Heredocs live inside ONE scriptlet tag, never inside an output tag.
  gemfile_source = <<~CODE
    gem "poetry"            # poetry-core + poetry-ui + poetry-lucide at one version
    gem "poetry-agent"      # optional: MCP server exe, WebMCP, AG-UI and A2UI surfaces
    # gem "poetry-charts"   # optional: server-rendered SVG charts
  CODE
  install_source = <<~CODE
    bundle install
    bin/rails g poetry:install --theme default
  CODE
  legacy_css_source = <<~CODE
    /* app/assets/tailwind/application.css */
    @import "tailwindcss";
    @import "./legacy.css" layer(base);   /* your existing stylesheet, ABOVE the poetry lines */
    @import "./poetry/tokens.css" layer(theme);
    /* ...the poetry lines the installer wrote... */
  CODE
  no_preflight_source = <<~CODE
    $ bin/rails g poetry:install --no-preflight
    # app/assets/tailwind/poetry/reset.css        <- preflight at zero specificity
    # @import "./poetry/reset.css" layer(base);   <- ahead of the theme in your entry
  CODE
  upgrade_source = <<~CODE
    bundle update poetry poetry-agent poetry-charts
    bin/rails g poetry:install     # your theme choice sticks; --theme switches
    bin/rails tailwindcss:build    # or your CSS build
    bin/rails test                 # confirm the app still renders
  CODE
  diff_source = <<~CODE
    bin/rails g poetry:diff        # read-only: copied at / gem ships / file-by-file drift
    bin/rails g poetry:add button  # adds newly-shipped files; never overwrites yours
  CODE
  scaffold_source = <<~CODE
    bin/rails g poetry:scaffold_templates
    bin/rails g scaffold Post title:string body:text published:boolean
  CODE
%>

<div class="flex flex-col gap-8">
  <header class="flex flex-col gap-3">
    <h1 class="text-4xl font-semibold tracking-tight">Installation</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      One generator wires everything, and the same generator is the upgrade
      path: every step is idempotent, so re-running it on a years-old app
      is always safe.
    </p>
  </header>

  <%# The docs prose rides poetry/typeset: bare elements, rhythm
      from the preset; Poetry components sit between prose runs as chrome. %>
  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="install">Install</h2>
    <% end %>
    <%= poetry_code_block(code: gemfile_source, language: "ruby", label: "Gemfile") %>
    <%= poetry_code_block(code: install_source, language: "shell", label: "Install") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        The installer copies the vendored CSS set under
        <code>app/assets/tailwind/poetry/</code> (tokens, the Tailwind theme
        mapping, the animation layer, your chosen
        <%= link_to "visual theme", theming_path %>, the class safelist, the
        app-owned <code>typeset.css</code>), injects the Tailwind entry
        imports line by line, registers the Stimulus controllers, mounts the
        engine (llms.txt), adds the <code>herb</code> gem to your development
        group (the parser behind <code>poetry:check</code>) and bundles it, and
        writes the <code>AGENTS.md</code> section and the Claude Code skills.
        Add <code>--charts</code> to wire
        poetry-charts. File creations skip what exists; injections append
        only missing lines. Before writing anything it lists every Poetry
        token name your stylesheets already declare; those keep their values
        (the Theming guide, "Your tokens win").
      </p>
    <% end %>
  </section>


  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
      <h2 id="existing-css">Installing into an app that already has CSS</h2>
      <p>
        A fresh app takes the install as written. An app with years of its
        own stylesheets meets three consequences of how Poetry sits in the
        cascade. None of them is a bug, and each has a one-line answer.
      </p>
      <h3 id="unlayered-css">Your unlayered CSS beats the theme</h3>
      <p>
        Poetry's theme imports into <code>layer(base)</code> so that utility
        classes in your templates always win over it. The other side of
        that contract: <em>any</em> unlayered rule beats <em>any</em>
        layered one, whatever its specificity. A legacy
        <code>a { color: … }</code> wins over every Poetry link surface
        (link Buttons, Breadcrumb, Pagination, NavigationMenu), a legacy
        <code>input { … }</code> over every field, down to the text color
        on a primary button rendered as a link. If you want Poetry's rules
        to win, give your stylesheet a layer, and mind where: a layer
        declared after Tailwind's import ranks <em>above</em> utilities and
        makes things worse. Import it into <code>layer(base)</code> above
        the Poetry lines instead: same layer, so specificity decides, and
        Poetry's class selectors beat element selectors.
      </p>
    <% end %>
    <%= poetry_code_block(code: legacy_css_source, language: "css", label: "Legacy stylesheet in the base layer") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
      <h3 id="existing-tokens">Tokens you already own keep winning</h3>
      <p>
        Poetry's tokens are defaults. A <code>--primary</code> or
        <code>--radius</code> your app already declares wins, and reaches
        Poetry's components; the install lists every such name. The
        <a href="<%= theming_path %>#your-tokens-win">Theming guide</a>
        has the rule and the escape hatches.
      </p>
      <h3 id="preflight">Preflight, and the app that has its own reset</h3>
      <p>
        <code>@import "tailwindcss"</code> brings Tailwind's preflight, and
        the installer writes that import when your app has no Tailwind entry
        yet. Poetry's components lean on a handful of preflight's
        normalizations: the universal <code>border: 0 solid</code> and zero
        padding, transparent form controls, headings at inherited size,
        collapsed tables, hidden <code>[hidden]</code>. Measured against the
        golden screenshot corpus, removing preflight changes two thirds of
        it even behind a modern reset: triggers grow native button chrome,
        dialogs keep their browser border and padding, titles jump in size.
        So an app that imports Tailwind without preflight installs the reset
        floor instead:
      </p>
    <% end %>
    <%= poetry_code_block(code: no_preflight_source, language: "shell", label: "Without preflight") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
      <p>
        The floor is preflight itself, generated from the pinned Tailwind
        and gated against it, with every selector wrapped in
        <code>:where()</code>. It has zero specificity, so your own reset
        wins wherever it speaks and the floor fills only what nothing else
        declared. On a fresh entry the flag also writes the split
        no-preflight import; on an existing entry it never touches your
        import lines. A plain re-run keeps the floor once installed. If an
        entry imports neither preflight nor the floor, the installer and
        <code>poetry:check</code> say so in one line.
      </p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="upgrade">Upgrade an existing app</h2>
      <p>
        <strong>The install generator is the upgrade path, not a one-shot.</strong>
        Gem-owned code (components, templates, controllers, the registry and
        MCP surface) upgrades with <code>bundle update</code> alone. The
        vendored CSS files and the safelist upgrade only when the generator
        re-runs: new components ship their theme rules and classes there, so
        skipping the re-run leaves them unstyled.
      </p>
    <% end %>
    <%= poetry_code_block(code: upgrade_source, language: "shell", label: "Upgrade") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        A plain re-run keeps the theme already installed (it reads the
        fragment header back); passing <code>--theme</code> is how you
        switch. Files you own (<code>base.css</code>,
        <code>typeset.css</code>, the initializer, the component manifest,
        and everything copied in) are never rewritten.
      </p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
      <h2 id="ownership">The three ownership tiers</h2>
      <table>
        <thead>
          <tr><th>Tier</th><th>Examples</th><th>Upgrades via</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Gem-owned</td>
            <td>components, controllers, registry, MCP, llms.txt</td>
            <td><code>bundle update</code></td>
          </tr>
          <tr>
            <td>Vendored into the app</td>
            <td><code>app/assets/tailwind/poetry/*</code>, <code>safelist.txt</code></td>
            <td><code>bin/rails g poetry:install</code></td>
          </tr>
          <tr>
            <td>App-owned copy-ins</td>
            <td><code>poetry:add</code> components, blocks, <code>base.css</code>, <code>typeset.css</code>, initializer</td>
            <td>you; <code>poetry:diff</code> reports</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="copy-ins">Copy-ins: <code>poetry:diff</code></h2>
      <p>
        Components copied in with <code>poetry:add</code> and blocks copied
        with <code>poetry:block</code> are yours: nothing ever rewrites
        them. Every <code>poetry:add</code> records the gem version it
        copied from in <code>config/poetry_components.yml</code>, and the
        read-only drift report shows where your copies stand after an
        upgrade:
      </p>
    <% end %>
    <%= poetry_code_block(code: diff_source, language: "shell", label: "Copy-in report") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        Blocks are starting points meant to be edited, so the report treats
        a differing block as normal, not drift; it simply points at the
        gem's current template for reference.
      </p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="scaffold-templates">Scaffold templates</h2>
      <p>
        Rails lets an app override its generator templates from
        <code>lib/templates/</code>; Poetry ships a set that renders with
        the library. After installing them, the standard scaffold generator
        produces a DataTable index with sanitized URL state (sortable
        columns, filter, pagination and a matching controller),
        Field-composed forms mapped from attribute types, and a MetadataList
        show page:
      </p>
    <% end %>
    <%= poetry_code_block(code: scaffold_source, language: "shell", label: "Scaffold templates") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        The copies under <code>lib/templates/</code> are app-owned: edit
        them freely, and re-runs never overwrite. The templates are
        lint-gated in the gem's own suite, so generated views pass
        <code>poetry:check</code> by construction.
      </p>
    <% end %>
  </section>
</div>
