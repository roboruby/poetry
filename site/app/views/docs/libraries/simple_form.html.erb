<% content_for :title, "Simple Form" %>
<% content_for :breadcrumb do %>
  <%= poetry_breadcrumb do |crumb| %>
    <% crumb.with_item("Docs", href: introduction_path) %>
    <% crumb.with_item("Simple Form") %>
  <% end %>
<% end %>
<%
  # Heredocs live inside ONE scriptlet tag. A literal ERB closer would end
  # this scriptlet early, so the samples interpolate it as #{e}; a literal opener would nest an ERB tag under Herb, so they interpolate it as #{o}.
  e = "%" + ">"
  o = "<" + "%"
  gemfile_source = <<~CODE
    gem "poetry-simple_form"
  CODE
  generate_source = <<~CODE
    bin/rails g poetry:simple_form:install
  CODE
  initializer_source = <<~CODE
    # config/initializers/poetry_simple_form.rb
    Poetry::SimpleForm.activate!
  CODE
  bridge_source = <<~CODE
    #{o}= simple_form_for @user do |f| #{e}
      #{o}= f.input :email #{e}
      #{o}= f.input :bio #{e}
      #{o}= f.input :admin, as: :switch #{e}
      #{o}= f.input :role, collection: %w[admin member] #{e}
      #{o}= f.association :company #{e}
    #{o} end #{e}
  CODE
poetry_only_source = <<~CODE
  #{o}= f.input :code, as: :otp, poetry: { length: 4 } #{e}
  #{o}= f.input :api_key, as: :sensitive #{e}
  #{o}= f.input :volume, as: :slider, poetry: { min: 0, max: 11 } #{e}
  #{o}= f.input :starts_on, as: :date_picker #{e}
  #{o}= f.input :tags, as: :tag_group #{e}
  #{o}= f.input :city, as: :autocomplete, collection: cities #{e}
  #{o}= f.input :plan, as: :combobox, collection: plans, label_method: :title #{e}
CODE
native_source = <<~CODE
    #{o}= form_with(model: @user, builder: Poetry::Ui::FormBuilder) do |f| #{e}
      #{o}= f.input :email #{e}
      #{o}= f.submit #{e}
    #{o} end #{e}
  CODE
%>

<div class="flex flex-col gap-8">
  <header class="flex flex-col gap-3">
    <h1 class="text-4xl font-semibold tracking-tight">Simple Form</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      poetry-simple_form is the migration bridge for existing Simple Form
      apps: one initializer re-maps the input types onto Poetry fields, and
      every <code>f.input</code> call in your views keeps working.
    </p>
  </header>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
      <h2 id="how-it-works">How it works</h2>
      <p>
        The bridge re-maps Simple Form's input types onto classes that render
        whole Poetry fields through <code>Poetry::Ui::FormBuilder</code>,
        bound to the same object and template. Label, hint, error, and aria
        wiring derive from your model on the same code path the
        <%= link_to "native builder", forms_path %> uses, so a bridged form
        and a rewritten one render identical fields. Simple Form contributes
        only type resolution; its wrapper tree is bypassed by design, because
        a flat wrapper stack cannot express the field's label, hint, error,
        and aria as one unit.
      </p>
      <p>
        Your existing <code>simple_form.*</code> i18n keys (labels, hints,
        placeholders) keep working: Poetry's builder reads them as a
        fallback chain.
      </p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="install">Install</h2>
      <p>
        Add the gem and run the install generator. It writes one initializer,
        and that initializer is the whole integration.
      </p>
    <% end %>
    <%= poetry_code_block(code: gemfile_source, language: "ruby", label: "Gemfile") %>
    <%= poetry_code_block(code: generate_source, language: "shell", label: "Generate") %>
    <%= poetry_code_block(code: initializer_source, language: "ruby", label: "The initializer") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        Delete the file and stock Simple Form rendering is back instantly.
      </p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="what-restyles">What restyles</h2>
      <p>
        Existing views need no edits. Each resolved input type renders the
        matching Poetry control, wrapped in a field with
        <code>aria-required</code> (never the native attribute), maxlength,
        min, max, and step derived from your validations, and errors wired
        via <code>aria-describedby</code>.
      </p>
    <% end %>
  <%= poetry_code_block(code: bridge_source, language: "erb", label: "Unchanged views") %>
  <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
    <table>
      <thead>
        <tr><th>Simple Form type</th><th>Renders as</th></tr>
      </thead>
      <tbody>
        <tr><td><code>string</code> / <code>email</code> / <code>url</code> / <code>tel</code> / <code>citext</code> / <code>uuid</code></td><td>the <%= link_to "input", component_path("input") %> field, native type preserved</td></tr>
        <tr><td><code>search</code></td><td>the <%= link_to "search field", component_path("search-field") %></td></tr>
        <tr><td><code>password</code></td><td>a password input; the value never round-trips into the markup</td></tr>
        <tr><td><code>sensitive</code></td><td>the <%= link_to "sensitive input", component_path("sensitive-input") %>, masked with a reveal toggle</td></tr>
        <tr><td><code>text</code> / <code>hstore</code> / <code>json</code> / <code>jsonb</code></td><td>the <%= link_to "textarea", component_path("textarea") %> field</td></tr>
        <tr><td><code>boolean</code></td><td>the horizontal <%= link_to "checkbox", component_path("checkbox") %> field</td></tr>
        <tr><td><code>switch</code></td><td>the <%= link_to "switch", component_path("switch") %> setting row</td></tr>
        <tr><td><code>integer</code> / <code>decimal</code> / <code>float</code></td><td>the <%= link_to "number field", component_path("number-field") %>, min/max/step re-derived from numericality validations</td></tr>
        <tr><td><code>range</code> / <code>slider</code></td><td>the <%= link_to "slider", component_path("slider") %></td></tr>
        <tr><td><code>date</code> / <code>time</code> / <code>datetime</code></td><td>the <%= link_to "date", component_path("date-field") %>, <%= link_to "time", component_path("time-field") %>, and <%= link_to "date-time", component_path("date-time-field") %> fields; the composite is one <code>datetime-local</code> control</td></tr>
        <tr><td><code>date_picker</code> / <code>calendar</code></td><td>the <%= link_to "date picker", component_path("date-picker") %> popover and the inline <%= link_to "calendar", component_path("calendar") %></td></tr>
        <tr><td><code>file</code></td><td>the <%= link_to "file input", component_path("file-input") %>; <code>input_html: { variant: :dropzone }</code> for the drop zone</td></tr>
        <tr><td><code>otp</code></td><td>the <%= link_to "one-time-code input", component_path("input-otp") %></td></tr>
        <tr><td><code>tag_group</code></td><td>the <%= link_to "tag group", component_path("tag-group") %></td></tr>
        <tr><td><code>select</code> / <code>grouped_select</code> / <code>time_zone</code></td><td>the <%= link_to "select", component_path("select") %></td></tr>
        <tr><td><code>native_select</code></td><td>the styled <%= link_to "native select", component_path("native-select") %>, zero JavaScript</td></tr>
        <tr><td><code>combobox</code> / <code>autocomplete</code></td><td>the <%= link_to "combobox", component_path("combobox") %> and the <%= link_to "autocomplete", component_path("autocomplete") %></td></tr>
        <tr><td><code>radio_buttons</code> / <code>check_boxes</code></td><td>the <%= link_to "radio group", component_path("radio-group") %> and the checkbox group with its select-all</td></tr>
        <tr><td><code>rich_text_area</code> / <code>hidden</code> / <code>country</code></td><td>left to Simple Form on purpose: Poetry ships no rich-text editor, a hidden field has nothing to render, and the country list belongs to the country_select gem</td></tr>
      </tbody>
    </table>
    <p>
      The table is <code>Poetry::SimpleForm::COVERAGE</code>, and a parity
      test in the gem fails when a new Poetry form control has no Simple
      Form route. The types Simple Form never had are reached by name
      through <code>as:</code>.
    </p>
  <% end %>
  <%= poetry_code_block(code: poetry_only_source, language: "erb", label: "Poetry-only types") %>
  <%= poetry_typeset(preset: "docs", class: "max-w-3xl") do %>
    <p>
      <code>f.association</code> works unchanged: Simple Form fetches the
      records, the bridge renders them as Poetry pickers, and
      <code>label_method:</code> / <code>value_method:</code> (symbols or
      callables) are honored before Simple Form's detection chain.
      <code>required: true</code> or <code>false</code> overrides the
      presence inference, on <code>aria-required</code> only. Poetry-only
      options ride a <code>poetry:</code> hash, merged last so it wins over
      anything Simple Form derived. String <code>label:</code>,
      <code>hint:</code>, and <code>placeholder:</code> options pass
      through; the rest of <code>input_html:</code> lands on the control
      minus its class and id, since Poetry components own their classes.
    </p>
  <% end %>
</section>

  <section class="flex flex-col gap-4">
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <h2 id="end-state">The end state</h2>
      <p>
        The bridge exists so views can migrate at their own pace. New forms,
        and old ones as you touch them, move to Poetry's own builder, where
        <code>f.input</code> works the same and the rest of the
        <%= link_to "form builder guide", forms_path %> applies.
      </p>
    <% end %>
    <%= poetry_code_block(code: native_source, language: "erb", label: "Native builder") %>
    <%= poetry_typeset(preset: "docs", class: "max-w-2xl") do %>
      <p>
        Both paths derive the same
        <%= link_to "field", component_path("field") %> from the same model,
        so a half-migrated app has one look throughout and the bridge can be
        removed the day the last <code>simple_form_for</code> goes.
      </p>
    <% end %>
  </section>
</div>
