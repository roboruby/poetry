<%# Upstream kbd-group: key chords inline in prose - the muted sentence
    carries the two Kbds. %>
<p class="text-sm text-muted-foreground">
  Use
  <span class="inline-flex items-center gap-1">
    <%= poetry_kbd { "Ctrl + B" } %>
    <%= poetry_kbd { "Ctrl + K" } %>
  </span>
  to open the command palette
</p>
