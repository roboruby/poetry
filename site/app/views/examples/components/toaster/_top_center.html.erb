<div class="h-40 w-full overflow-hidden rounded-lg border contain-content">
  <%= poetry_toaster(position: :"top-center", id: "toaster-top-center", hotkey: "F9") do %>
    <%= poetry_toast(variant: :info, duration: 0) do |toast| %>
      <% toast.with_title { "A new version is available" } %>
    <% end %>
  <% end %>
</div>
