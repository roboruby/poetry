<%# side: :top floats the panel above the trigger - reach for it when the link
    sits low in a scroll region and a bottom card would clip off-screen. %>
<%= poetry_hover_card(side: :top, align: :center, content_class: "w-72") do |card| %>
  <% card.with_trigger(href: "https://github.com/hotwired/stimulus", class: "text-sm font-medium underline-offset-4 hover:underline") { "@hotwired/stimulus" } %>
  <div class="flex flex-col gap-2 text-sm">
    <h4 class="font-semibold">Stimulus</h4>
    <p class="text-muted-foreground">A lightweight controller layer for the HTML you already ship.</p>
    <div class="text-xs text-muted-foreground">MIT licensed - 3.2k stars</div>
  </div>
<% end %>
