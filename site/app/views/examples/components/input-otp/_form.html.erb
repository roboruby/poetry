<%# Upstream input-otp-form: the verify-login card - one OTP field, a
    resend / lost-access row, and a full-width submit. The row under the
    code is interactive (a resend action and a recovery link), so it is
    a plain muted row rather than the field hint - hint text lands in
    aria-describedby, and buttons don't belong in a description. %>
<%= poetry_card(class: "w-full max-w-md") do |card| %>
  <% card.with_title { "Verify your login" } %>
  <% card.with_description { "Enter the verification code we sent to your email address: m@example.com." } %>

  <form class="grid gap-6">
    <div class="grid gap-3">
      <%= poetry_field(id: "otp-form-code", label_text: "Verification code") do |field| %>
        <%= poetry_input_otp(name: "code", length: 6, groups: [3, 3],
                             **field.control_attributes.transform_keys(&:to_sym)) %>
      <% end %>
      <div class="flex items-center justify-between gap-2 text-sm text-muted-foreground">
        <%= poetry_button(variant: :link, size: :sm, type: :button, class: "h-auto p-0") do %>
          <%= poetry_icon(name: :"refresh-cw") %> Resend Code
        <% end %>
        <%= poetry_link(href: "#") { "I no longer have access to this email address." } %>
      </div>
    </div>
    <%= poetry_button(type: :submit, class: "w-full") { "Verify" } %>
    <p class="text-center text-sm text-muted-foreground">
      Having trouble signing in? <%= poetry_link(href: "#") { "Contact support" } %>
    </p>
  </form>
<% end %>
