<%# A pending state: poetry_spinner rides the leading addon while a muted
    status caption sits at the trailing edge. The control stays borderless and
    the group keeps its single focus ring through the wait. %>
<div class="w-80">
  <%= poetry_label(for_id: "input-group-handle", class: "sr-only") { "Username" } %>
  <%= poetry_input_group do %>
    <%= poetry_input_group_addon do %>
      <%= poetry_spinner(label: "Checking availability") %>
    <% end %>
    <%= poetry_input_group_input(id: "input-group-handle", name: "handle", value: "ada.lovelace") %>
    <%= poetry_input_group_addon(align: :"inline-end") do %>
      <%= poetry_input_group_text { "Checking…" } %>
    <% end %>
  <% end %>
</div>
