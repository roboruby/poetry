<%# Text addons frame the control on both edges: a currency symbol at the
    leading edge and a fixed unit at the trailing edge. poetry_input_group_text
    gives each the muted, non-interactive caption treatment. %>
<div class="w-80">
  <%= poetry_label(for_id: "input-group-price", class: "sr-only") { "Price" } %>
  <%= poetry_input_group do %>
    <%= poetry_input_group_addon do %>
      <%= poetry_input_group_text { "$" } %>
    <% end %>
    <%= poetry_input_group_input(id: "input-group-price", name: "price", placeholder: "0.00") %>
    <%= poetry_input_group_addon(align: :"inline-end") do %>
      <%= poetry_input_group_text { "USD" } %>
    <% end %>
  <% end %>
</div>
